---
// BORRADOR para EGO (2026-10-21): sección "tu nicho ya está en digital".
// Al bajar, la pantalla se vuelve roja, el texto negro y un contador sube con el scroll.
// Las cifras son de EJEMPLO y están marcadas como tal: antes de ir a la home hay que
// reemplazarlas por datos con fuente (INEC, CECE, Meta, Google). Oculta: noindex, sin enlaces.
import '../../styles/site.css';
const NICHOS = [
  { id: 'restaurantes', nombre: 'restaurantes y cafeterías', verbo: 'piden comida por WhatsApp o apps', n: 1200000 },
  { id: 'moda', nombre: 'tiendas de ropa', verbo: 'compran ropa viendo un video', n: 950000 },
  { id: 'salud', nombre: 'consultorios y clínicas', verbo: 'agendan su cita desde el celular', n: 700000 },
  { id: 'servicios', nombre: 'servicios profesionales', verbo: 'buscan en Google antes de llamar', n: 1800000 },
];
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Borrador · Tu nicho ya está en digital</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
  <main id="nicho-lab">
    <section class="intro">
      <div class="inner">
        <p class="lbl">Borrador · sección «tu nicho»</p>
        <h1>Baja despacio.<br><span class="serif">Esto iría después de «Así de simple».</span></h1>
        <p class="sub">Las cifras de esta página son de ejemplo y están marcadas así. Elige un nicho para ver cómo cambia la frase.</p>
        <div class="picks" id="picks">
          {NICHOS.map((n, i) => <button type="button" class={'pick' + (i === 0 ? ' on' : '')} data-i={i}>{n.nombre}</button>)}
        </div>
      </div>
    </section>

    <section class="rojo" id="rojo" aria-label="Tu nicho ya está en digital">
      <div class="sticky">
        <div class="inner">
          <p class="k">Mientras lo piensas</p>
          <p class="num"><span id="num">0</span></p>
          <p class="line">personas en Ecuador ya <span id="verbo">{NICHOS[0].verbo}</span>.</p>
          <p class="line2">Están en tu nicho. Buscan, comparan y pagan desde el celular. <b>Y todavía no te encuentran.</b></p>
          <p class="src">Cifra de ejemplo para este borrador. En la versión final: fuente y año visibles.</p>
        </div>
      </div>
    </section>

    <section class="after">
      <div class="inner">
        <p class="lbl">Y justo después</p>
        <h2>Nosotros te ponemos ahí. <span class="serif">Hoy.</span></h2>
        <p class="sub">Aquí seguirían «Elige lo que necesitas», comentarios y contacto. Este bloque solo muestra el ritmo: necesidad → cifra → solución.</p>
        <a class="btn" href="/">Volver a la home</a>
      </div>
    </section>
  </main>
</body>
</html>

<style is:global>
#nicho-lab{background:var(--black);color:var(--text)}
#nicho-lab .inner{max-width:1100px;margin:0 auto;padding:0 44px}
#nicho-lab .lbl{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);margin:0 0 18px}
#nicho-lab h1,#nicho-lab h2{font-family:var(--font);font-weight:400;letter-spacing:-.03em;line-height:1.02;font-size:clamp(34px,5.2vw,72px);margin:0}
#nicho-lab .serif{font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-size:1.06em}
#nicho-lab .sub{font-size:17px;color:var(--text2);max-width:52ch;margin:22px 0 0;line-height:1.6}
.intro,.after{padding:160px 0 140px}
.picks{display:flex;flex-wrap:wrap;gap:10px;margin-top:34px}
.pick{font:inherit;font-size:14px;color:var(--text2);background:transparent;border:1px solid var(--border);padding:12px 18px;cursor:pointer;transition:border-color .3s,color .3s}
.pick.on,.pick:hover{border-color:var(--bone);color:var(--text)}
/* la pantalla se tiñe de rojo con el scroll; el texto pasa a negro */
.rojo{height:320vh;position:relative;background:var(--black)}
.rojo .sticky{position:sticky;top:0;height:100vh;height:100dvh;display:flex;align-items:center;overflow:hidden;background:rgb(var(--r,11),var(--g,11),var(--b,13));color:var(--txt,#f3f1ea);transition:none}
.rojo .k{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;opacity:.75;margin:0 0 18px}
.rojo .num{font-family:var(--font);font-weight:400;font-size:clamp(72px,15vw,220px);line-height:.9;letter-spacing:-.05em;margin:0;font-variant-numeric:tabular-nums}
.rojo .line{font-family:var(--font);font-size:clamp(22px,3.2vw,44px);letter-spacing:-.02em;line-height:1.15;margin:22px 0 0;max-width:22ch}
.rojo .line2{font-size:clamp(16px,1.6vw,20px);line-height:1.5;max-width:50ch;margin:26px 0 0;opacity:0;transform:translateY(12px);transition:opacity .6s,transform .7s var(--ease)}
.rojo .line2.on{opacity:.92;transform:none}
.rojo .src{font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;opacity:.6;margin:40px 0 0}
.btn{display:inline-block;margin-top:34px;border:1px solid var(--bone);color:var(--bone);font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;padding:16px 28px}
@media (max-width:640px){#nicho-lab .inner{padding:0 22px}.intro,.after{padding:110px 0 90px}.rojo{height:260vh}}
</style>

<script>
  const NICHOS = [
    { verbo: 'piden comida por WhatsApp o apps', n: 1200000 },
    { verbo: 'compran ropa viendo un video', n: 950000 },
    { verbo: 'agendan su cita desde el celular', n: 700000 },
    { verbo: 'buscan en Google antes de llamar', n: 1800000 },
  ];
  let cur = 0;
  const sec = document.getElementById('rojo') as HTMLElement, st = sec.querySelector('.sticky') as HTMLElement;
  const numEl = document.getElementById('num') as HTMLElement, verboEl = document.getElementById('verbo') as HTMLElement, line2 = sec.querySelector('.line2') as HTMLElement;
  const picks = Array.from(document.querySelectorAll('.pick')) as HTMLElement[];
  picks.forEach((b) => b.addEventListener('click', () => { cur = Number(b.dataset.i); picks.forEach((x) => x.classList.toggle('on', x === b)); verboEl.textContent = NICHOS[cur].verbo; paint(); }));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t, clamp = (v: number) => Math.min(1, Math.max(0, v)), smooth = (u: number) => u * u * (3 - 2 * u);
  const fmt = (n: number) => Math.round(n).toLocaleString('es-EC');
  let prog = 0, target = 0;
  function read() { const r = sec.getBoundingClientRect(); const span = sec.offsetHeight - innerHeight; target = clamp(-r.top / span); }
  function paint() {
    const p = prog;
    // 0–0.25: de negro a rojo · 0.2–0.85: el contador sube · 0.7+: remate
    const red = smooth(clamp(p / 0.25));
    st.style.setProperty('--r', String(Math.round(lerp(11, 229, red))));
    st.style.setProperty('--g', String(Math.round(lerp(11, 57, red))));
    st.style.setProperty('--b', String(Math.round(lerp(13, 53, red))));
    const tx = Math.round(lerp(243, 12, red)); st.style.setProperty('--txt', `rgb(${tx},${tx},${tx})`);
    const c = smooth(clamp((p - 0.2) / 0.65));
    numEl.textContent = (c >= 0.999 ? '+' : '') + fmt(NICHOS[cur].n * c);
    line2.classList.toggle('on', p > 0.72);
  }
  function frame() { requestAnimationFrame(frame); prog += (target - prog) * 0.16; if (Math.abs(target - prog) > 0.0005) paint(); }
  addEventListener('scroll', read, { passive: true }); read(); paint(); requestAnimationFrame(frame);
</script>
