---
// BIE — Laboratorio: el capítulo 1 de la home 10.0, aislado para pruebas (noindex, sin enlaces).
// Usa el mismo componente que la home; aquí se ve solo, sin el resto de la página.
import '../../styles/site.css';
import CuboHero from '../../components/interactive/CuboHero.astro';
const wa = 'https://wa.me/593988253030?text=' + encodeURIComponent('Hola, quiero cotizar un producto de BIE. ¿Qué me recomiendan para mi negocio?\n\n— Origen: web/lab/cubo/es');
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Lab · Capítulo 1 · El cubo se arma</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<style is:global>
html,body{background:#0f0f11;color:var(--text)}
body{overflow-x:hidden}
#after{min-height:60vh;display:grid;place-items:center;padding:40px 24px;text-align:center;color:var(--text3);font-family:var(--mono);font-size:12px;line-height:1.8}
#after a{color:var(--text2);border-bottom:1px solid var(--border)}
</style>
</head>
<body>
<CuboHero waHref={wa} />
<div id="after">Fin del prototipo del capítulo 1.<br>Sube y baja para armar y desarmar el cubo. En celular, con el dedo.<br><a href="/">Ver la home</a></div>
