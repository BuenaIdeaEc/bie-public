---
// Catálogo que se recorre con scroll (2026-11-19, segunda ronda de EGO): un escenario fijo donde cada producto
// se abre desde un cuadro negro —como el logo— hasta llenar la pantalla con una foto real, y su escena avanza
// con el dedo. Sin botones de anterior/siguiente. Regla de 47 cuadros: el actual en rojo, los vistos en negro.
// Sin JavaScript o con «reducir movimiento», los productos quedan uno debajo del otro, completos.
import fs from 'node:fs';
import '../styles/site.css';
import '../styles/catalogo-escenas.css';
import { PHASES } from '../data/catalogo';
import { escena } from '../data/catalogo-escenas';
import { GALERIA } from '../data/catalogo-galeria';
import { FOCO } from '../data/catalogo-fotos';

const SITE = 'https://businessintelligence.solutions';
const url = `${SITE}/catalogo/`;
const WA = '593988253030';
const wa = (m: string) => `https://wa.me/${WA}?text=${encodeURIComponent(m)}`;

type Bi = { es: string; en: string };
const TOTAL = PHASES.reduce((a, f) => a + f.products.length, 0);
const slugify = (str: string) => str.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const seoTitle = { es: `Catálogo de BIE — ${TOTAL} productos para tu negocio, uno por uno`, en: `BIE catalog — ${TOTAL} products for your business, one by one` };
const seoDesc = {
  es: `Mira los ${TOTAL} productos de BIE funcionando: análisis, marca, página web, WhatsApp con IA, publicidad, contabilidad y capacitación para negocios en Ecuador. Puedes pedir uno solo.`,
  en: `See BIE's ${TOTAL} products in action: analysis, brand, website, AI on WhatsApp, advertising, accounting and training for businesses in Ecuador. You can order just one.`,
};

const T: Record<string, Bi> = {
  nav_home: { es: 'Inicio', en: 'Home' },
  nav_cta: { es: 'Cotizar', en: 'Get a quote' },
  hero_1: { es: `${TOTAL} productos.`, en: `${TOTAL} products.` },
  hero_2: { es: 'Pide uno solo.', en: 'Order just one.' },
  hero_sub: { es: 'Baja y míralos funcionar, uno por uno.', en: 'Scroll and watch them work, one by one.' },
  phase_w: { es: 'Fase', en: 'Phase' },
  prods_w: { es: 'productos', en: 'products' },
  b_quote: { es: 'Cotizar solo este', en: 'Quote just this one' },
  b_page: { es: 'Ver el producto', en: 'See the product' },
  note: { es: 'Las escenas son ejemplos con «Tu negocio». Las fotos son reales, de bancos con licencia; las capturas son trabajo de BIE.', en: 'Scenes are examples using "Your business". Photos are real, from licensed banks; screenshots are BIE work.' },
  band_t: { es: '¿No sabes por dónde empezar?', en: 'Not sure where to start?' },
  band_btn: { es: 'Diagnóstico gratuito por WhatsApp', en: 'Free diagnosis on WhatsApp' },
};
PHASES.forEach((f, i) => {
  T[`f${i}_t`] = f.title; T[`f${i}_g`] = f.tag;
  f.products.forEach((pr, j) => {
    const g = GALERIA[pr.slug!];
    T[`f${i}p${j}_n`] = pr.n; T[`f${i}p${j}_d`] = pr.d;
    T[`f${i}p${j}_c`] = g ? g.c : pr.n; T[`f${i}p${j}_a`] = g ? g.ay : pr.d;
  });
});
const es = (k: string) => T[k].es;

// Capas del escenario: una portada por fase y un producto por paso
type Capa = { tipo: 'fase'; f: number } | { tipo: 'prod'; f: number; j: number; n: number; slug: string; k: string };
const CAPAS: Capa[] = [];
let n = 0;
PHASES.forEach((f, i) => {
  CAPAS.push({ tipo: 'fase', f: i });
  f.products.forEach((pr, j) => { n++; CAPAS.push({ tipo: 'prod', f: i, j, n, slug: pr.slug!, k: `f${i}p${j}` }); });
});
const PRODS = CAPAS.filter((c) => c.tipo === 'prod') as Extract<Capa, { tipo: 'prod' }>[];

// Fotos reales procesadas en public/images/catalogo/<slug>-<ancho>.webp
const ANCHOS = [800, 1200, 1600];
const foto = (slug: string) => fs.existsSync(`public/images/catalogo/${slug}-1200.webp`)
  ? { src: `/images/catalogo/${slug}-1200.webp`, srcset: ANCHOS.map((w) => `/images/catalogo/${slug}-${w}.webp ${w}w`).join(', '), pos: FOCO[slug] || '50% 40%' }
  : null;
const quoteHref = (nm: string) => wa(`Hola, quiero cotizar «${nm}» para mi empresa. ¿Cómo trabajan este producto?\n\n— Origen: web/catalogo/${slugify(nm)}/es`);

const ld = [
  { '@context': 'https://schema.org', '@type': 'ItemList', name: seoTitle.es, description: seoDesc.es, url, numberOfItems: TOTAL,
    itemListElement: PHASES.flatMap((f) => f.products).map((pr, i) => ({ '@type': 'ListItem', position: i + 1, name: pr.n.es, ...(pr.slug ? { url: `${SITE}/productos/${pr.slug}/` } : {}) })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'Catálogo', item: url } ] },
];
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{seoTitle.es}</title>
<meta name="description" content={seoDesc.es}>
<link rel="canonical" href={url}>
<meta name="robots" content="index, follow">
<meta property="og:type" content="website">
<meta property="og:title" content={seoTitle.es}>
<meta property="og:description" content={seoDesc.es}>
<meta property="og:url" content={url}>
<meta property="og:image" content={`${SITE}/images/og/og-default.jpg`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={`${SITE}/images/og/og-default.jpg`}>
<meta property="og:locale" content="es_EC">
<meta name="theme-color" content="#ffffff">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="preload" href="/fonts/figtree-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<script is:inline>document.documentElement.classList.add('js');if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('apila');</script>
<script type="application/ld+json" is:inline set:html={JSON.stringify(ld)}></script>
<style is:global>
@font-face{font-family:'Figtree';src:url('/fonts/figtree-latin-wght-normal.woff2') format('woff2');font-weight:300 900;font-style:normal;font-display:swap}
:root{
  --bg:#fff;--surface:#f4f4f2;--text:#080808;--text2:#4a4a48;--text3:#6b6b68;--line:rgba(8,8,8,.1);
  --accent:#E53935;--btn:#D92D2A;
  --font:'Figtree','Helvetica Neue',Arial,system-ui,sans-serif;
  --e:cubic-bezier(.2,.7,.2,1);
}
html{background:#fff;color:var(--text);font-family:var(--font)}
body{background:#fff;color:var(--text);font-family:var(--font);overflow-x:clip}
.in{width:min(100%,1440px);margin-inline:auto;padding-inline:clamp(16px,5vw,72px)}
.btn{display:inline-flex;align-items:center;justify-content:center;background:var(--btn);color:#fff;font-size:16px;font-weight:500;padding:0 22px;height:50px;white-space:nowrap}
.btn:hover{background:#c22622}
.btn-g{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--text);color:var(--text);font-size:16px;font-weight:500;padding:0 20px;height:50px;white-space:nowrap}
.btn-g:hover{background:var(--text);color:#fff}
a:focus-visible,button:focus-visible{outline:2px solid var(--text);outline-offset:3px}

/* barra superior */
.gn{position:sticky;top:0;z-index:5000;height:64px;background:rgba(255,255,255,.94);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.gn .in{display:flex;align-items:center;gap:clamp(12px,2.4vw,28px);height:100%}
.gn-logo img{display:block;width:36px;height:36px}
.gn-l{margin-left:auto;font-size:15px;color:var(--text2)}
.gn-l:hover{color:var(--text)}
#lang-toggle{background:none;border:1px solid var(--line);color:var(--text);font-size:13.5px;padding:7px 12px}
.gn-cta{background:var(--btn);color:#fff;font-size:15px;font-weight:500;padding:10px 18px}
.gn-cta:hover{background:#c22622}

/* portada */
.gh{padding:clamp(56px,10vh,130px) 0 clamp(48px,8vh,96px)}
.gh h1{font-size:clamp(40px,6.4vw,104px);font-weight:500;line-height:1;margin:0}
.gh h1 span{display:block;white-space:nowrap}
.gh h1 span+span{color:var(--accent)}
.gh .sub{font-size:clamp(17px,1.5vw,21px);color:var(--text2);margin:22px 0 0}
.mos{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:clamp(28px,4vw,48px)}
.mos div{display:flex;gap:4px}
.mos a{display:block;width:14px;height:14px;background:var(--text);transition:background .2s}
.mos a:hover,.mos a:focus-visible{background:var(--accent)}
.mos-n{margin:12px 0 0;min-height:1.4em;font-size:15px;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* catálogo: sin JS o sin movimiento, cada capa va una debajo de otra */
.catalogo{position:relative}
.escenario{position:relative}
.capa{position:relative;height:100vh;height:100svh;min-height:640px;overflow:hidden;background:#fff;border-top:1px solid var(--line)}
.capa.fase{height:auto;min-height:0;padding:clamp(64px,12vh,140px) 0}
.ventana{position:absolute;left:0;top:0;bottom:0;width:58.333%;overflow:hidden;background:#080808}
.ventana::after{content:'';position:absolute;right:14px;top:14px;width:8px;height:8px;background:var(--accent);opacity:var(--pix,0)}
.foto{position:absolute;inset:0}
.foto img{width:100%;height:100%;object-fit:cover;display:block}
.tarjeta{position:absolute;width:clamp(340px,30vw,480px);left:calc(58.333% - 40px - clamp(340px,30vw,480px));bottom:40px;background:#fff}
.tarjeta .st{border:1px solid rgba(8,8,8,.12);background:var(--surface)}
.fase .mask>span{white-space:normal}
.panel{position:absolute;left:58.333%;right:0;top:0;bottom:0;padding:56px clamp(28px,4vw,64px) 96px;display:flex;flex-direction:column;justify-content:center;gap:16px;min-width:0}
.cnt{margin:0;font-size:15px;color:var(--text3);font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cnt b{color:var(--accent);font-weight:500}
.panel h2{margin:0;font-size:clamp(28px,2.6vw,46px);font-weight:500;line-height:1.08;letter-spacing:normal}
.panel h2.mask>span{white-space:normal;text-wrap:balance}
.panel .ay{margin:0;font-size:clamp(17px,1.4vw,21px);color:var(--text2)}
.mask{display:block;overflow:hidden;padding-bottom:.06em}
.mask>span{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.btns{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}
.fase .in>small{display:block;font-size:15px;color:var(--accent);font-weight:500}
.fase h2{margin:10px 0 0;font-size:clamp(40px,5.6vw,92px);font-weight:500;line-height:1}
.fase .tag{margin:16px 0 0;font-size:clamp(17px,1.5vw,22px);color:var(--text2)}
.fase .lst{margin:22px 0 0;font-size:15px;color:var(--text3);max-width:70ch;line-height:1.6}
.regla{display:none}
.g-note{margin:clamp(40px,5vw,64px) 0 0;font-size:14px;color:var(--text3)}
.gb{margin:clamp(40px,6vw,90px) 0 0;padding:clamp(44px,6vw,80px) 0;background:var(--surface)}
.gb .in{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.gb p{margin:0;font-size:clamp(24px,2.6vw,38px);font-weight:500}
.gfoot{padding:28px 0 40px;font-size:13.5px;color:var(--text3)}
.gfoot .in{display:flex;gap:18px;flex-wrap:wrap}
.gfoot a:hover{color:var(--text)}

/* ═══ escenario apilado: el scroll mueve las capas ═══ */
.apila .escenario{position:sticky;top:0;height:100vh;height:100lvh;overflow:clip;background:#fff}
.apila .capa{position:absolute;inset:0;height:auto;min-height:0;padding:0;border:0;background:transparent;opacity:0;pointer-events:none}
.apila .capa.act{opacity:1;pointer-events:auto}
.apila .capa.prod .ventana,.apila .capa.prod .panel{top:64px}
.apila .ventana{transform:scale(var(--sx,1),var(--sy,1));will-change:transform}
.apila .foto{transform:scale(var(--isx,1),var(--isy,1)) translateY(var(--py,0%)) scale(var(--z,1));will-change:transform}
.apila .foto img{opacity:var(--luz,1)}
.apila .tarjeta{opacity:calc(var(--cin,1) * (1 - var(--cout,0)));transform:translateY(calc((1 - var(--cin,1)) * 28px + var(--par,0px)))}
.apila .mask>span{transform:translateY(calc((1 - var(--tin,1)) * 110% - var(--tout,0) * 110%))}
.apila .cnt,.apila .btns,.apila .fase .tag,.apila .fase .lst,.apila .fase small{opacity:calc(var(--tin,1) * (1 - var(--tout,0)))}
.apila .capa.fase{display:flex;align-items:center}
.apila .capa.fase::before{content:'';position:absolute;inset:0;background:#fff;transform:scale(var(--sx,1),var(--sy,1));border:1px solid var(--line)}
.apila .capa.fase .in{position:relative;width:100%}
.apila .regla{position:absolute;z-index:500;left:calc(58.333% + clamp(28px,4vw,64px));right:clamp(28px,4vw,64px);bottom:40px;display:flex;flex-wrap:wrap;gap:6px 10px}
.regla div{display:flex;gap:3px}
.regla a{display:block;width:9px;height:9px;border:1px solid #c9c9c6;background:#fff}
.regla a.vis{background:var(--text);border-color:var(--text)}
.regla a.cur{background:var(--accent);border-color:var(--accent)}

/* teléfono */
@media (max-width:760px){
  .gn{position:relative}
  .gn-l{display:none}
  .gn-cta{margin-left:auto}
  .capa.prod{--vh:max(200px,calc(100svh - 380px));--cw:min(358px,calc(100vw - 32px));height:auto;min-height:0;padding-top:calc(var(--vh) - 130px + var(--cw) * .75 + 14px);padding-bottom:28px}
  .ventana{right:0;width:auto;height:var(--vh);bottom:auto}
  .tarjeta{left:0;right:0;margin-inline:auto;width:var(--cw);top:calc(var(--vh) - 130px);bottom:auto}
  .panel{position:relative;left:auto;right:auto;top:auto;bottom:auto;padding:0 16px;gap:10px;justify-content:flex-start}
  .cnt{font-size:13px}
  .panel h2{font-size:clamp(22px,6.6vw,28px)}
  .panel .ay{font-size:15px}
  .btns{flex-wrap:nowrap;margin-top:6px}
  .btns a{flex:1;height:48px;padding:0 10px;font-size:15px}
  .apila .capa.prod{padding:0}
  .apila .capa.prod .ventana{top:0}
  .apila .capa.prod .panel{position:absolute;left:0;right:0;top:calc(var(--vh) - 130px + var(--cw) * .75 + 14px);bottom:0;padding:0 16px calc(100lvh - 100svh + 40px)}
  .apila .regla{left:16px;right:16px;bottom:calc(100lvh - 100svh + 14px);gap:4px 6px}
  .regla div{gap:2px}
  .regla a{width:5px;height:5px}
  .mos{gap:5px 10px}.mos a{width:11px;height:11px}.mos div{gap:3px}
}
@media (prefers-reduced-motion:reduce){.mos a{transition:none}}
</style>
</head>
<body>
<header class="gn"><div class="in">
  <a class="gn-logo" href="/" aria-label="BIE, inicio"><img src="/images/marca/bie-cuadro-96.webp" width="36" height="36" alt="BIE"></a>
  <a class="gn-l" href="/" data-i18n="nav_home">{es('nav_home')}</a>
  <button id="lang-toggle" aria-label="Cambiar idioma / Switch language">EN</button>
  <a class="gn-cta wa-diag" href={wa('Hola, quiero cotizar para mi empresa.\n\n— Origen: web/catalogo/nav/es')} target="_blank" rel="noopener" data-i18n="nav_cta">{es('nav_cta')}</a>
</div></header>

<main>
<section class="gh"><div class="in">
  <h1><span data-i18n="hero_1">{es('hero_1')}</span><span data-i18n="hero_2">{es('hero_2')}</span></h1>
  <p class="sub" data-i18n="hero_sub">{es('hero_sub')}</p>
  <nav class="mos" aria-label={`${TOTAL} productos`}>
    {PHASES.map((f, i) => <div>{PRODS.filter((p) => p.f === i).map((p) => <a href={`#p-${p.slug}`} data-n={p.n - 1} data-k={p.k} aria-label={`${p.n} de ${TOTAL}: ${T[p.k + '_c'].es}`}></a>)}</div>)}
  </nav>
  <p class="mos-n" id="mos-n" aria-hidden="true"></p>
</div></section>

<div class="catalogo" id="cat">
  <div class="escenario" id="esc">
    {CAPAS.map((c, i) => c.tipo === 'fase' ? (
      <article class="capa fase" id={`fase-${PHASES[c.f].num}`} data-i={i} style={`z-index:${i + 1}`}>
        <div class="in">
          <small><span data-i18n="phase_w">{es('phase_w')}</span> {PHASES[c.f].num}</small>
          <h2 class="mask"><span data-i18n={`f${c.f}_t`}>{PHASES[c.f].title.es}</span></h2>
          <p class="tag" data-i18n={`f${c.f}_g`}>{PHASES[c.f].tag.es}</p>
          <p class="lst">{PHASES[c.f].products.length} <span data-i18n="prods_w">{es('prods_w')}</span> · {PRODS.filter((p) => p.f === c.f).map((p, j, a) => <><span data-i18n={p.k + '_c'}>{T[p.k + '_c'].es}</span>{j < a.length - 1 ? ', ' : ''}</>)}</p>
        </div>
      </article>
    ) : (() => { const ft = foto(c.slug); return (
      <article class="capa prod" id={`p-${c.slug}`} data-i={i} data-n={c.n - 1} data-slug={c.slug} data-k={c.k} style={`z-index:${i + 1}`}>
        <div class="ventana"><div class="foto">{ft && <><img data-src={ft.src} data-srcset={ft.srcset} sizes="(max-width:760px) 100vw, 60vw" alt="" decoding="async" style={`object-position:${ft.pos}`} /><noscript><img src={ft.src} srcset={ft.srcset} sizes="(max-width:760px) 100vw, 60vw" alt="" loading="lazy" style={`object-position:${ft.pos}`} /></noscript></>}</div></div>
        <div class="tarjeta" aria-hidden="true"><div class="st"><div class="scn" set:html={escena(c.slug)}></div></div></div>
        <div class="panel">
          <p class="cnt"><b>{c.n} / {TOTAL}</b> · <span data-i18n={`f${c.f}_t`}>{PHASES[c.f].title.es}</span></p>
          <h2 class="mask"><span data-i18n={c.k + '_c'}>{T[c.k + '_c'].es}</span></h2>
          <p class="ay mask"><span data-i18n={c.k + '_a'}>{T[c.k + '_a'].es}</span></p>
          <div class="btns">
            <a class="btn wa-q" href={quoteHref(T[c.k + '_n'].es)} target="_blank" rel="noopener" data-k={c.k} data-i18n="b_quote">{es('b_quote')}</a>
            <a class="btn-g" href={`/productos/${c.slug}/?src=catalogo`} data-i18n="b_page">{es('b_page')}</a>
          </div>
        </div>
      </article>
    ); })())}
    <nav class="regla" id="regla" aria-label={`${TOTAL} productos`}>
      {PHASES.map((f, i) => <div>{PRODS.filter((p) => p.f === i).map((p) => <a href={`#p-${p.slug}`} data-n={p.n - 1} aria-label={`${p.n} de ${TOTAL}: ${T[p.k + '_c'].es}`}></a>)}</div>)}
    </nav>
  </div>
</div>

<div class="in"><p class="g-note" data-i18n="note">{es('note')}</p></div>

<section class="gb"><div class="in">
  <p data-i18n="band_t">{es('band_t')}</p>
  <a class="btn wa-diag" href={wa('Hola, quiero mi diagnóstico gratuito para mi empresa.\n\n— Origen: web/catalogo/diagnostico/es')} target="_blank" rel="noopener" data-i18n="band_btn">{es('band_btn')}</a>
</div></section>
</main>

<footer class="gfoot"><div class="in">
  <span>© 2026 BIE · Ecuador</span>
  <a href="/privacidad/">Privacidad</a><a href="/terminos/">Términos</a>
</div></footer>

<script is:inline define:vars={{ T, WA, TOTAL }}>
let lang = 'es';
const wa = (m) => `https://wa.me/${WA}?text=${encodeURIComponent(m)}`;
const SRC = (() => { const m = new URLSearchParams(location.search).get('src'); return m && /^[a-z0-9-]{1,40}$/.test(m) ? m : null; })();
const slugify = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const origin = (w) => `\n\n— Origen: web/catalogo/${w}/${lang}` + (SRC ? ` · vía ${SRC}` : '');
const apila = document.documentElement.classList.contains('apila');

const cat = document.getElementById('cat');
const capas = Array.from(document.querySelectorAll('.capa'));
const prods = capas.filter((c) => c.classList.contains('prod'));
const regla = Array.from(document.querySelectorAll('#regla a'));
let pinta = () => {};

// ── idioma ──
function applyLang(){
  document.documentElement.lang = lang;
  document.querySelectorAll('[data-i18n]').forEach((el) => { const v = T[el.dataset.i18n]; if (v) el.innerHTML = v[lang]; });
  document.querySelectorAll('[data-en]').forEach((el) => { if (el.dataset.es == null) el.dataset.es = el.innerHTML; el.innerHTML = lang === 'en' ? el.dataset.en : el.dataset.es; });
  document.getElementById('lang-toggle').textContent = lang === 'es' ? 'EN' : 'ES';
  const diag = (lang === 'es' ? 'Hola, quiero mi diagnóstico gratuito para mi empresa.' : 'Hi, I want my free diagnosis for my company.') + origin('diagnostico');
  document.querySelectorAll('.wa-diag').forEach((a) => { a.href = wa(diag); });
  document.querySelectorAll('.wa-q').forEach((a) => {
    const nm = T[a.dataset.k + '_n'][lang];
    a.href = wa((lang === 'es' ? `Hola, quiero cotizar «${nm}» para mi empresa. ¿Cómo trabajan este producto?` : `Hi, I want a quote for "${nm}" for my company. How do you work this product?`) + origin(slugify(T[a.dataset.k + '_n'].es)));
  });
}
document.getElementById('lang-toggle').addEventListener('click', () => { lang = lang === 'es' ? 'en' : 'es'; applyLang(); pinta(true); });

// ── fotos: solo cerca de la vista ──
function carga(c){
  const im = c && c.querySelector('.foto img[data-src]');
  if (!im) return;
  im.srcset = im.dataset.srcset; im.src = im.dataset.src; im.removeAttribute('data-src');
}

// mosaico de la portada: el nombre aparece al pasar
const mosN = document.getElementById('mos-n');
document.querySelectorAll('.mos a').forEach((a) => {
  const show = () => { mosN.textContent = (+a.dataset.n + 1) + ' / ' + TOTAL + ' · ' + T[a.dataset.k + '_c'][lang]; };
  a.addEventListener('mouseenter', show); a.addEventListener('focus', show);
});

if (!apila) {
  // sin movimiento: todo en su lugar, fotos con carga perezosa y escenas en su estado final
  document.querySelectorAll('.foto img[data-src]').forEach((im) => { im.loading = 'lazy'; carga(im.closest('.capa')); });
  document.querySelectorAll('.st').forEach((s) => s.classList.add('on'));
} else {
  // ── medidas: alto estable (lvh), nunca innerHeight ──
  const probe = document.createElement('div');
  probe.style.cssText = 'position:fixed;top:0;height:100lvh;width:0;visibility:hidden;pointer-events:none';
  document.body.appendChild(probe);
  let LVH = 0, L = [], O = [], SUM = 0, movil = false;
  function mide(){
    LVH = probe.offsetHeight || 800;
    movil = matchMedia('(max-width:760px)').matches;
    let acc = 0;
    L = capas.map((c) => (c.classList.contains('fase') ? (movil ? .6 : .7) : (movil ? 1.05 : 1.2)) * LVH);
    O = L.map((l) => { const o = acc; acc += l; return o; });
    SUM = acc;
    cat.style.height = (SUM + LVH) + 'px';
    capas.forEach((c) => { const v = c.classList.contains('fase') ? c : c.querySelector('.ventana'); c._w = v.offsetWidth || 1; c._h = v.offsetHeight || 1; });
    pinta(true);
  }

  const ease = (t) => 1 - Math.pow(1 - t, 3);
  const r = (t, a, b) => Math.min(1, Math.max(0, (t - a) / (b - a)));
  const set = (el, k, v) => el.style.setProperty(k, v);

  // las escenas existentes se controlan con el scroll: se pausan y se fija su tiempo
  function prepara(c){
    if (c._prep) return;
    const st = c.querySelector('.st');
    if (!st) return;
    st.classList.add('on');
    c._fin = []; c._loop = [];
    for (const a of st.getAnimations({ subtree: true })) {
      const ti = a.effect.getComputedTiming();
      a.pause();
      (ti.iterations === Infinity ? c._loop : c._fin).push(a);
    }
    c._T = Math.max(1, ...c._fin.map((a) => a.effect.getComputedTiming().endTime));
    c._prep = true;
  }
  function abre(c, E){
    // el cuadro negro crece desde 64 px hasta llenar su zona: la foto queda quieta adentro (escala inversa)
    const S = Math.min(1, 64 / c._w), Sy = Math.min(1, 64 / c._h);
    const sx = S + (1 - S) * E, sy = Sy + (1 - Sy) * E;
    set(c, '--sx', sx.toFixed(4)); set(c, '--sy', sy.toFixed(4));
    set(c, '--isx', (1 / sx).toFixed(4)); set(c, '--isy', (1 / sy).toFixed(4));
  }
  function escena(c, p){
    prepara(c);
    if (c._fin) for (const a of c._fin) a.currentTime = p * c._T;
  }
  let actual = -1, loopsDe = null;
  const vistos = new Set(), medidos = new Set();
  pinta = function(forzar){
    const y = Math.min(SUM - 1, Math.max(0, -cat.getBoundingClientRect().top));
    let i = 0; while (i < capas.length - 1 && O[i + 1] <= y) i++;
    const t = (y - O[i]) / L[i];
    const c = capas[i], prev = capas[i - 1], esFase = c.classList.contains('fase');
    // capas visibles: la actual, y la anterior mientras la nueva se abre
    const entra = i === 0 ? 1 : ease(r(t, 0, esFase ? .3 : .4));
    capas.forEach((k, j) => k.classList.toggle('act', j === i || (j === i - 1 && entra < 1)));
    abre(c, entra);
    set(c, '--tin', (i === 0 ? 1 : ease(r(t, esFase ? .3 : .2, esFase ? .55 : .4))).toFixed(3));
    set(c, '--tout', 0);
    if (!esFase) {
      set(c, '--luz', (i === 0 ? 1 : r(t, .05, .25)).toFixed(3));
      set(c, '--cin', ease(r(t, .2, .4)).toFixed(3)); set(c, '--cout', 0);
      set(c, '--z', (1.12 - .06 * t).toFixed(4)); set(c, '--py', ((movil ? 1.5 : 3) - (movil ? 3 : 6) * t).toFixed(2) + '%');
      set(c, '--par', ((.5 - t) * 24).toFixed(1) + 'px');
      set(c, '--pix', r(t, .3, .45).toFixed(2));
      escena(c, ease(r(t, .3, .8)));
      carga(c); carga(capas[i + 1]); carga(capas[i + 2]); carga(prev);
      const n = +c.dataset.n;
      if (t >= .5 && !medidos.has(n)) { medidos.add(n); if (window.bieTrack) window.bieTrack('product_view', { product_slug: c.dataset.slug, meta: { via: 'catalogo-scroll' } }); }
      if (t >= .3) vistos.add(n);
    } else { carga(capas[i + 1]); carga(capas[i + 2]); }
    // anterior: sale por máscara, su foto queda debajo
    if (prev) {
      abre(prev, 1);
      set(prev, '--tout', ease(r(t, 0, .2)).toFixed(3)); set(prev, '--cout', ease(r(t, 0, .2)).toFixed(3));
      if (!prev.classList.contains('fase')) escena(prev, 1);
    }
    // bucles (música, barras, CRM) corren solo en el producto activo
    if (loopsDe !== c) {
      if (loopsDe && loopsDe._loop) loopsDe._loop.forEach((a) => a.pause());
      if (!esFase) { prepara(c); (c._loop || []).forEach((a) => a.play()); }
      loopsDe = c;
    }
    // regla de 47
    const cur = esFase ? -1 : +c.dataset.n;
    if (forzar || cur !== actual) {
      regla.forEach((a, j) => { a.classList.toggle('cur', j === cur); a.classList.toggle('vis', j !== cur && vistos.has(j)); a.removeAttribute('aria-current'); });
      if (cur >= 0) regla[cur].setAttribute('aria-current', 'step');
      actual = cur;
    }
  };
  let pend = false;
  addEventListener('scroll', () => { if (pend) return; pend = true; requestAnimationFrame(() => { pend = false; pinta(false); }); }, { passive: true });
  addEventListener('resize', () => { requestAnimationFrame(mide); }, { passive: true });

  // saltar a un producto: cerca, con suavidad; lejos, de inmediato
  function salta(n, suave){
    const i = capas.indexOf(prods[n]);
    if (i < 0) return;
    const yAct = Math.max(0, -cat.getBoundingClientRect().top);
    const lejos = Math.abs((O[i] - yAct) / LVH) > 4;
    scrollTo({ top: cat.offsetTop + O[i] + L[i] * .85, behavior: suave && !lejos ? 'smooth' : 'auto' });
  }
  document.querySelectorAll('.mos a, #regla a').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); salta(+a.dataset.n, true); try { history.replaceState(null, '', a.getAttribute('href')); } catch (er) {} }));
  // con el teclado: al enfocar un botón de otro producto, el escenario va a ese producto
  cat.addEventListener('focusin', (e) => { const c = e.target.closest('.capa.prod'); if (c && !c.classList.contains('act')) salta(+c.dataset.n, false); });

  mide();
  const h = location.hash.match(/^#(?:p|ver)-([a-z0-9-]+)$/);
  if (h) { const k = prods.findIndex((c) => c.dataset.slug === h[1]); if (k >= 0) requestAnimationFrame(() => salta(k, false)); }
}
applyLang();
</script>
<script src="/track.js" defer></script>
</body>
</html>
