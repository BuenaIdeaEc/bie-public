*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  /* Sale del logo: un cuadro negro en un estudio blanco. Blanco, negro y un solo rojo, en poca cantidad */
  --bg:#fff;--surface:#fff;--band:#f4f4f2;
  --text:#080808;--text2:#4d4d4b;--text3:#6f6f6c;
  --border:rgba(8,8,8,.14);--bone:#080808;--ink:#fff;--prism-cyan:#2a7fff;--prism-lime:#2aff2a;
  --accent:#E53935;--accent-dark:#c62828;--accent-pale:#f4f4f2;--accent-glow:rgba(8,8,8,.08);
  --black:#fff;
  --glass-blur:blur(18px) saturate(1.4);--glass-line:rgba(8,8,8,.1);
  --font:'Figtree','Helvetica Neue',Arial,system-ui,sans-serif;
  --mono:'Figtree',system-ui,sans-serif;
  --r-lg:0px;--r-md:0px;--r-sm:0px;
  --sh-sm:none;
  --sh-md:none;
  --sh-lg:none;
  --ease:cubic-bezier(.52,.01,0,1);
}
html{font-family:var(--font);background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
body{overflow-x:hidden}
.serif{font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-weight:400;letter-spacing:0;font-size:1.06em;line-height:1}
a{text-decoration:none;color:inherit}
button,input,select,textarea{font-family:var(--font)}
button{cursor:pointer}
::selection{background:var(--accent);color:#fff}

.reveal{opacity:0;transform:translateY(38px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
.reveal.in{opacity:1;transform:none}
.d1{transition-delay:.07s}.d2{transition-delay:.14s}.d3{transition-delay:.21s}.d4{transition-delay:.28s}
@media(prefers-reduced-motion:reduce){
  .reveal{opacity:1;transform:none;transition:none}
  canvas{display:none}
  .tilt{transform:none!important}
}

/* ═══ Nav ═══ */
#nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;
  padding:0 44px;height:66px;transition:all .35s;border-bottom:1px solid transparent}
#nav.scrolled{background:rgba(8,8,8,.72);backdrop-filter:blur(22px) saturate(1.8);border-color:rgba(8,8,8,.1)}
#nav.dark-zone{background:rgba(11,11,13,.85);border-color:rgba(255,255,255,.08)}
#nav.dark-zone .nav-logo,#nav.dark-zone .nav-link,#nav.dark-zone #lang-toggle{color:#fff;border-color:rgba(255,255,255,.3)}
.nav-logo{font-weight:700;font-size:19px;letter-spacing:-.03em;display:flex;align-items:center;gap:10px;transition:color .3s}
.nav-logo-px{width:9px;height:9px;background:var(--accent);display:inline-block;animation:px-blink 2.2s steps(2) infinite}
@keyframes px-blink{0%,60%{opacity:1}80%,100%{opacity:.25}}
.nav-links{display:flex;align-items:center;gap:26px}
.nav-link{font-size:13px;font-weight:500;color:var(--text2);transition:color .2s;position:relative}
.nav-link::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:2px;background:var(--accent);transition:width .25s}
.nav-link:hover::after,.nav-link.active::after{width:100%}
.nav-link.active{color:var(--accent)}
#lang-toggle{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.1em;border:1px solid var(--border);
  background:none;color:var(--text2);padding:7px 12px;transition:all .2s;min-height:32px}
#lang-toggle:hover{border-color:var(--accent);color:var(--accent)}
.nav-cta{padding:9px 18px;background:transparent;color:var(--bone);font-size:12.5px;font-weight:400;letter-spacing:.06em;text-transform:uppercase;position:relative;overflow:hidden;border:1px solid var(--bone);border-radius:0}
.nav-cta::before{content:'';position:absolute;inset:0;background:var(--accent);transform:translateX(-101%);transition:transform .3s cubic-bezier(.16,1,.3,1)}
.nav-cta:hover::before{transform:none}
.nav-cta span{position:relative;z-index:1}
#progress{position:fixed;top:0;left:0;height:3px;background:var(--accent);z-index:200;width:0}

/* Hamburger + mobile menu */
#burger{display:none;background:none;border:none;width:44px;height:44px;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:0}
#burger span{display:block;width:22px;height:2px;background:var(--bone);transition:transform .3s,opacity .3s}
#nav.dark-zone #burger span{background:#fff}
#burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
#burger.open span:nth-child(2){opacity:0}
#burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
#mobile-menu{position:fixed;inset:0;background:rgba(13,13,15,.97);backdrop-filter:blur(20px);z-index:99;
  display:flex;flex-direction:column;justify-content:center;padding:44px;gap:8px;
  opacity:0;pointer-events:none;transition:opacity .3s}
#mobile-menu.open{opacity:1;pointer-events:auto}
.mm-link{font-size:30px;font-weight:700;letter-spacing:-.03em;padding:14px 0;border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  opacity:0;transform:translateX(-22px);transition:opacity .4s,transform .4s}
#mobile-menu.open .mm-link{opacity:1;transform:none}
#mobile-menu.open .mm-link:nth-child(2){transition-delay:.06s}
#mobile-menu.open .mm-link:nth-child(3){transition-delay:.12s}
#mobile-menu.open .mm-link:nth-child(4){transition-delay:.18s}
.mm-link .mm-arrow{color:var(--accent);font-size:22px}
.mm-cta{margin-top:26px;padding:17px;background:transparent;border:1px solid var(--bone);color:var(--bone);font-size:14px;font-weight:400;letter-spacing:.06em;text-transform:uppercase;text-align:center;border-radius:0;
  opacity:0;transform:translateY(14px);transition:opacity .4s .24s,transform .4s .24s}
#mobile-menu.open .mm-cta{opacity:1;transform:none}

/* WhatsApp FAB + widget */
#wa-fab{position:fixed;bottom:26px;right:26px;z-index:150;width:72px;height:78px;
  background:transparent;border:none;display:flex;align-items:center;justify-content:center;color:#fff;
  perspective:480px;transition:transform .25s cubic-bezier(.16,1,.3,1)}
#wa-fab:hover{transform:scale(1.1)}
@keyframes fab-pulse{0%{transform:scale(1);opacity:.7}70%,100%{transform:scale(1.65);opacity:0}}
.wa-float{display:block;position:relative;animation:wa-float 3.4s ease-in-out infinite}
@keyframes wa-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
.wa-float::after{content:'';position:absolute;left:50%;bottom:-16px;width:34px;height:7px;transform:translateX(-50%);
  background:rgba(7,7,9,.25);filter:blur(4px);border-radius:50%;animation:wa-shadow 3.4s ease-in-out infinite}
@keyframes wa-shadow{0%,100%{transform:translateX(-50%) scaleX(1);opacity:.55}50%{transform:translateX(-50%) scaleX(.7);opacity:.3}}
.wa-cube{display:block;width:50px;height:50px;position:relative;transform-style:preserve-3d;
  animation:wa-spin 9s linear infinite}
@keyframes wa-spin{from{transform:rotateX(-18deg) rotateY(0deg)}to{transform:rotateX(-18deg) rotateY(360deg)}}
.wa-face{position:absolute;inset:0;background:linear-gradient(150deg,#1b1b20 0%,#09090b 55%,#040405 100%);border:1px solid rgba(8,8,8,.42);
  box-shadow:inset 0 0 0 1px rgba(0,0,0,.7);display:flex;align-items:center;justify-content:center;backface-visibility:hidden}
.wa-edge{width:8px;height:8px;background:var(--accent);position:absolute;top:7px;left:7px;box-shadow:0 0 10px rgba(229,57,53,.75)}
#wa-fab{filter:drop-shadow(0 10px 18px rgba(0,0,0,.6))}
#wa-bubble{position:fixed;bottom:48px;right:104px;z-index:151;background:var(--bone);color:var(--ink);border:1px solid rgba(8,8,8,.1);
  padding:12px 16px;font-size:13px;font-weight:700;letter-spacing:-.01em;max-width:230px;
  opacity:0;transform:translateX(14px) scale(.96);transform-origin:right center;pointer-events:none;
  transition:opacity .35s var(--ease),transform .35s var(--ease)}
#wa-bubble.on{opacity:1;transform:none;pointer-events:auto;cursor:pointer}
#wa-bubble::after{content:'';position:absolute;right:-6px;top:50%;width:10px;height:10px;background:var(--bone);border-right:1px solid rgba(8,8,8,.1);border-top:1px solid rgba(8,8,8,.1);transform:translateY(-50%) rotate(45deg)}
#wa-bubble .wb-px{display:inline-block;width:7px;height:7px;background:var(--accent);margin-right:9px;vertical-align:middle}
.wa-face.f{transform:translateZ(25px)}
.wa-face.b{transform:rotateY(180deg) translateZ(25px)}
.wa-face.r{transform:rotateY(90deg) translateZ(25px)}
.wa-face.l{transform:rotateY(-90deg) translateZ(25px)}
.wa-face.t{transform:rotateX(90deg) translateZ(25px);background:#16161a}
.wa-face.d{transform:rotateX(-90deg) translateZ(25px);background:#050507}
#fab-px{position:fixed;bottom:0;right:0;width:190px;height:190px;z-index:149;pointer-events:none}
#wa-fab,#fab-px,#wa-bubble{opacity:0;pointer-events:none;transition:opacity .5s var(--ease),transform .5s var(--ease)}
#wa-fab{transform:translateY(24px)}
body.past-hero #wa-fab{opacity:1;pointer-events:auto;transform:none}
body.past-hero #fab-px{opacity:1}
body.past-hero #wa-bubble.on{opacity:1;pointer-events:auto}
#wa-fab .fab-x{display:none;font-size:28px;line-height:1;color:var(--text);background:var(--bg);border:1px solid var(--border);
  width:46px;height:46px;align-items:center;justify-content:center}
#wa-fab.open .fab-x{display:flex}
#wa-fab.open .wa-float{display:none}
#wa-widget{position:fixed;bottom:98px;right:24px;z-index:150;width:312px;max-width:calc(100vw - 40px);border-radius:var(--r-lg);overflow:hidden;
  background:var(--bg);border:1px solid rgba(8,8,8,.1);
  opacity:0;transform:translateY(18px) scale(.96);transform-origin:bottom right;pointer-events:none;
  transition:opacity .3s cubic-bezier(.16,1,.3,1),transform .3s cubic-bezier(.16,1,.3,1)}
#wa-widget.open{opacity:1;transform:none;pointer-events:auto}
.waw-head{background:var(--black);padding:16px 18px;display:flex;align-items:center;gap:12px}
.waw-avatar{width:38px;height:38px;background:var(--accent);display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:14px;color:#fff;flex-shrink:0}
.waw-head-info{flex:1}
.waw-name{color:#fff;font-size:14px;font-weight:700}
.waw-status{display:flex;align-items:center;gap:6px;margin-top:2px}
.waw-status-dot{width:7px;height:7px;border-radius:50%;background:#25D366}
.waw-status span{font-size:10.5px;color:rgba(255,255,255,.55);font-family:var(--mono)}
.waw-body{padding:18px}
.waw-bubble{background:var(--surface);padding:12px 15px;font-size:13px;line-height:1.55;color:var(--text2);margin-bottom:14px}
.waw-bubble b{color:var(--text)}
.waw-opts{display:flex;flex-direction:column;gap:8px}
.waw-opt{display:flex;align-items:center;gap:11px;padding:13px 16px;border:1px solid rgba(8,8,8,.1);border-radius:var(--r-sm);
  font-size:13px;font-weight:700;letter-spacing:-.01em;color:var(--text);text-align:left;background:var(--bg);
  transition:border-color .2s,background .2s,transform .25s var(--ease);min-height:46px}
.waw-opt:hover{border-color:#25D366;background:#f0faf4;transform:translateX(3px)}
.waw-opt-px{width:8px;height:8px;background:#25D366;flex-shrink:0}
.waw-foot{font-family:var(--mono);font-size:9px;letter-spacing:.08em;color:var(--text3);text-align:center;padding:0 18px 14px}

/* ═══ Custom cursor ═══ */
@media(pointer:fine){
  body{cursor:none}
  a,button,select,input,textarea,.ba-stage{cursor:none}
  #cursor{position:fixed;top:0;left:0;z-index:600;pointer-events:none;will-change:transform}
  #cursor-dot{width:8px;height:8px;background:var(--accent);position:absolute;top:-4px;left:-4px}
  #cursor-ring{position:absolute;top:-21px;left:-21px;width:42px;height:42px;border:1px solid rgba(8,8,8,.5);
    display:flex;align-items:center;justify-content:center;transition:transform .28s var(--ease),background .28s,border-color .28s;
    font-family:var(--mono);font-size:0;color:#fff;letter-spacing:.1em;font-weight:500}
  #cursor.hov #cursor-ring{transform:scale(1.6);border-color:var(--accent)}
  #cursor.label #cursor-ring{transform:scale(2.2);background:var(--accent);border-color:var(--accent);font-size:8px}
  #cursor.dark #cursor-ring{border-color:rgba(255,255,255,.5)}
}
@media(pointer:coarse){#cursor{display:none}}

/* ═══ Horizontal drag gallery ═══ */
.hscroll-wrap{margin-top:64px;position:relative}
.hscroll{display:flex;gap:22px;overflow-x:auto;scroll-snap-type:x proximity;padding:6px 6px 26px;
  scrollbar-width:none;-ms-overflow-style:none;cursor:none;touch-action:pan-x pan-y}
.hscroll::-webkit-scrollbar{display:none}
.h-card{flex:0 0 auto;width:min(580px,82vw);scroll-snap-align:start;overflow:hidden;
  background:var(--bg);border:1px solid rgba(8,8,8,.1);user-select:none}
.h-card .gallery{height:330px;border-radius:0}
.hscroll-foot{display:flex;justify-content:space-between;align-items:center;margin-top:10px;gap:24px}
.hscroll-bar{flex:1;height:2px;background:var(--border);border-radius:2px;overflow:hidden}
.hscroll-bar-fill{height:100%;width:0;background:var(--accent);transition:width .2s ease-out}
.hscroll-count{font-family:var(--mono);font-size:12px;letter-spacing:.1em;color:var(--text3);font-variant-numeric:tabular-nums}
.ba-solo{margin-top:26px}

/* Banda de conversión (reemplaza al antes/después) */
.cta-band{grid-column:1 / -1;background:var(--black);color:#fff;padding:52px 56px;display:flex;align-items:center;gap:36px;
  position:relative;overflow:hidden;transition:background .3s}
.cta-band:hover{background:#101014}
.band-px{width:14px;height:14px;background:var(--accent);flex-shrink:0;animation:px-blink 2.2s steps(2) infinite}
.band-text{flex:1;font-size:clamp(22px,3vw,40px);font-weight:400;letter-spacing:-.02em;line-height:1.15}
.band-text .serif{color:var(--accent)}
.band-btn{flex-shrink:0;padding:15px 26px;background:transparent;border:1px solid var(--bone);color:var(--bone);font-size:12.5px;font-weight:400;letter-spacing:.06em;text-transform:uppercase;
  transition:background .25s,color .25s,transform .3s var(--ease)}
.cta-band:hover .band-btn{background:var(--accent);border-color:var(--accent);color:#fff}

/* ═══ Reel overlay (showreel) ═══ */
#reel{position:fixed;inset:0;background:#070709;z-index:400;display:none;overflow:hidden}
#reel.open{display:block}
.reel-progress{position:absolute;top:18px;left:22px;right:70px;display:flex;gap:6px;z-index:5}
.reel-seg{flex:1;height:2px;background:rgba(255,255,255,.18);border-radius:2px;overflow:hidden}
.reel-seg-fill{height:100%;width:0;background:var(--accent)}
.reel-seg.done .reel-seg-fill{width:100%}
#reel-close{position:absolute;top:10px;right:16px;z-index:6;background:none;border:none;color:rgba(255,255,255,.7);font-size:30px;line-height:1;padding:8px;transition:color .2s,transform .25s}
#reel-close:hover{color:#fff;transform:rotate(90deg)}
.reel-slide{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:34px;padding:60px 24px;
  opacity:0;transform:scale(1.04);transition:opacity .5s var(--ease),transform .5s var(--ease);pointer-events:none}
.reel-slide.on{opacity:1;transform:none;pointer-events:auto}
.reel-visual{transform:scale(1.35);filter:drop-shadow(0 40px 80px rgba(0,0,0,.6))}
.reel-name{font-size:clamp(46px,9vw,120px);font-weight:400;letter-spacing:-.02em;color:#fff;line-height:1;text-align:center}
.reel-name .serif{color:var(--accent)}
.reel-kind{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.45)}
.reel-hint{position:absolute;bottom:22px;left:0;right:0;text-align:center;font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:rgba(255,255,255,.3)}

/* ═══ Hero ═══ */
#hero{min-height:100vh;position:relative;display:flex;flex-direction:column;justify-content:center;padding:130px 44px 90px;overflow:hidden;perspective:1200px;background:var(--black);color:#fff}
#hero-flash{position:absolute;inset:0;background:var(--bone);opacity:0;pointer-events:none;z-index:4}
#hero-flash.on{animation:hero-flash .55s ease-out}
@keyframes hero-flash{0%{opacity:0}16%{opacity:.9}100%{opacity:0}}
#hero::after{content:'';position:absolute;left:50%;top:50%;width:120vw;height:120vh;transform:translate(-50%,-50%);pointer-events:none;z-index:1;background:radial-gradient(36% 42% at 66% 48%,rgba(229,57,53,.09) 0%,transparent 62%)}
#hero-canvas{position:absolute;inset:0;z-index:0}
.hero-inner{position:relative;z-index:2;max-width:1150px;margin:0 auto;width:100%;transform-style:preserve-3d;transition:transform .25s ease-out;will-change:transform,opacity;display:grid;grid-template-columns:1.15fr .85fr;align-items:center;column-gap:40px}
.hero-text{min-width:0}
.hero-cube-wrap{perspective:1400px;display:flex;justify-content:center;align-items:center;min-height:380px;will-change:transform}
.hero-cube{--cs:250px;--half:125px;--ex:0px;width:var(--cs);height:var(--cs);position:relative;transform-style:preserve-3d;will-change:transform}
.hc{position:absolute;inset:0;border:1px solid rgba(8,8,8,.6);background:rgba(0,0,0,.72);transition:background .6s var(--ease),border-color .6s var(--ease)}
.hero-cube.done .hc{background:var(--bone)!important;border-color:var(--bone)!important}
.hero-cube.done .hc.f{background:var(--bone)!important;border-color:var(--bone)!important}
.hero-cube.done .hc-px{background:var(--accent)}
.hc.f{transform:translateZ(calc(var(--half) + var(--ex)));background:rgba(229,57,53,.82);border-color:rgba(255,255,255,.7)}
.hc.b{transform:rotateY(180deg) translateZ(calc(var(--half) + var(--ex)))}
.hc.r{transform:rotateY(90deg) translateZ(calc(var(--half) + var(--ex)))}
.hc.l{transform:rotateY(-90deg) translateZ(calc(var(--half) + var(--ex)))}
.hc.t{transform:rotateX(90deg) translateZ(calc(var(--half) + var(--ex)))}
.hc.d{transform:rotateX(-90deg) translateZ(calc(var(--half) + var(--ex)))}
.hc-px{position:absolute;width:8px;height:8px;background:#fff;top:-4px;left:-4px}
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);
  display:flex;align-items:center;gap:12px;margin-bottom:30px}
.eyebrow::before{content:'';width:12px;height:12px;background:var(--accent)}
.h1-line{overflow:hidden;display:block}
.h1-line>span{display:block;transform:translateY(112%);transition:transform .95s cubic-bezier(.16,1,.3,1)}
#hero.loaded .h1-line>span{transform:none}
.h1-line:nth-child(2)>span{transition-delay:.12s}
.hero-dead{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--text3);opacity:0;transition:opacity .9s ease .05s}
#hero.loaded .hero-dead{opacity:1}
#hero h1{font-size:clamp(36px,5.4vw,80px);font-weight:400;line-height:1.05;letter-spacing:-.02em;max-width:900px;margin-top:20px;opacity:0;transform:translateY(24px);transition:opacity .95s var(--ease) .12s,transform .95s var(--ease) .12s}
#hero.loaded h1{opacity:1;transform:none}
#hero h1 .accent{color:var(--accent)}
.hero-thesis{font-size:clamp(17px,1.8vw,22px);font-weight:400;letter-spacing:-.01em;line-height:1.6;max-width:560px;margin-top:30px;color:rgba(255,255,255,.62);
  opacity:0;transform:translateY(20px);transition:opacity .9s .5s cubic-bezier(.16,1,.3,1),transform .9s .5s cubic-bezier(.16,1,.3,1)}
#hero.loaded .hero-thesis{opacity:1;transform:none}
.hero-thesis .accent{color:#fff;font-weight:700}
.hero-sub{font-size:16px;color:rgba(255,255,255,.48);max-width:520px;line-height:1.72;margin-top:18px;
  opacity:0;transform:translateY(20px);transition:opacity .9s .62s cubic-bezier(.16,1,.3,1),transform .9s .62s cubic-bezier(.16,1,.3,1)}
#hero.loaded .hero-sub{opacity:1;transform:none}
.hero-btns{display:flex;gap:14px;margin-top:40px;flex-wrap:wrap;opacity:0;transition:opacity .9s .75s}
#hero.loaded .hero-btns{opacity:1}
.btn-primary{padding:16px 34px;background:transparent;color:var(--bone);font-size:13.5px;font-weight:400;letter-spacing:.06em;text-transform:uppercase;display:inline-block;position:relative;overflow:hidden;border:1px solid var(--bone);cursor:pointer;
  border-radius:0;transition:transform .35s var(--ease),box-shadow .35s var(--ease)}
.btn-primary:hover{border-color:var(--accent)}
.btn-primary::before{content:'';position:absolute;inset:0;background:var(--accent);transform:translateY(101%);transition:transform .35s var(--ease)}
.btn-primary:hover::before{transform:none}
.btn-primary span{position:relative;z-index:1}
.btn-ghost{padding:16px 24px;border:none;color:var(--bone);font-size:13.5px;font-weight:400;letter-spacing:.06em;text-transform:uppercase;display:inline-block;cursor:pointer;background:transparent;
  border-radius:0;transition:transform .35s var(--ease),border-color .25s,background .25s,box-shadow .35s var(--ease)}
.btn-ghost:hover{color:var(--text3)}
.hero-stats{display:flex;margin-top:72px;opacity:0;transition:opacity 1s .9s}
#hero.loaded .hero-stats{opacity:1}
.stat{padding-right:56px;margin-right:56px;border-right:1px solid rgba(255,255,255,.14)}
#hero .stat-l{color:rgba(255,255,255,.4)}
.stat:last-child{border:none}
.stat-n{font-size:36px;font-weight:700;letter-spacing:-.04em;line-height:1;font-variant-numeric:tabular-nums}
.stat-l{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);margin-top:7px}

/* ═══ Marquee editorial ═══ */
#marquee{display:none}
.marquee-track{display:flex;gap:64px;width:max-content;animation:marquee 60s linear infinite}
@keyframes marquee{to{transform:translateX(-50%)}}
.mq-item{font-size:52px;font-weight:700;letter-spacing:-.03em;color:transparent;-webkit-text-stroke:1px rgba(8,8,8,.32);
  white-space:nowrap;display:flex;align-items:center;gap:64px;transition:color .3s}
.mq-item:hover{color:var(--text);-webkit-text-stroke:1px transparent}
.mq-sep{width:10px;height:10px;background:var(--accent);flex-shrink:0}

/* ═══ Sections — cabecera editorial asimétrica ═══ */
.section-inner{max-width:1150px;margin:0 auto;padding:0 44px;position:relative;z-index:2}
.section-inner>.reveal:first-child{display:grid;grid-template-columns:1fr minmax(240px,330px);grid-template-areas:'a a' 'b c' 'd d';
  column-gap:56px;row-gap:6px;align-items:end;text-align:left;border-top:1px solid var(--border);padding-top:26px}
.section-label{grid-area:a;font-family:var(--mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);
  display:flex;align-items:center;gap:10px;margin-bottom:22px}
.section-label::before{content:'';width:9px;height:9px;background:var(--accent)}
.section-h2{grid-area:b;font-size:clamp(34px,5.4vw,76px);font-weight:400;letter-spacing:-.02em;line-height:1.03;text-wrap:balance;margin:0}
.section-sub{grid-area:c;color:var(--text2);font-size:14.5px;line-height:1.75;margin:0 0 8px;text-wrap:pretty}
.bb-term{grid-area:d;justify-self:start}
#blackbox .section-inner>.reveal:first-child{border-top-color:rgba(255,255,255,.14)}

/* ═══ Video ═══ */
#video{padding:120px 0 110px;background:var(--bg)}
.video-wrap{margin-top:56px;position:relative;aspect-ratio:16/9;max-height:560px;width:100%;
  background:radial-gradient(120% 140% at 50% 0%,#1b1b1f 0%,#070709 55%);display:flex;align-items:center;justify-content:center;
  overflow:hidden;cursor:pointer;border-radius:var(--r-lg)}
.video-grid-bg{position:absolute;inset:0;opacity:.12;
  background-image:linear-gradient(rgba(255,255,255,.5) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.5) 1px,transparent 1px);
  background-size:44px 44px}
.video-play{width:88px;height:88px;background:var(--accent);display:flex;align-items:center;justify-content:center;
  position:relative;z-index:2;transition:transform .3s cubic-bezier(.16,1,.3,1)}
.video-wrap:hover .video-play{transform:scale(1.12) rotate(45deg)}
.video-wrap:hover .video-play svg{transform:rotate(-45deg)}
.video-play svg{transition:transform .3s cubic-bezier(.16,1,.3,1)}
.video-play::before{content:'';position:absolute;inset:0;border:2px solid var(--accent);animation:fab-pulse 2.6s cubic-bezier(.16,1,.3,1) infinite}
.video-caption{position:absolute;bottom:22px;left:24px;right:24px;display:flex;justify-content:space-between;align-items:center;z-index:2;gap:12px;flex-wrap:wrap}
.video-tag{font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#fff;background:rgba(229,57,53,.9);padding:6px 12px}
.video-dur{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:rgba(255,255,255,.55)}

/* ═══ Work ═══ */
#work{padding:120px 0 80px;position:relative;background:var(--surface);overflow:hidden}
/* dos hileras de láminas que corren solas en bucle (sentidos opuestos); al pasar el cursor se frenan */
.reels{display:flex;flex-direction:column;gap:14px;margin-top:48px}
.reel-row{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
.reel-track{display:flex;gap:14px;width:max-content;will-change:transform}
.wt{position:relative;flex:0 0 auto;height:clamp(240px,36vh,400px);aspect-ratio:1;overflow:hidden;background:var(--bg);border:1px solid rgba(8,8,8,.06);display:flex;align-items:center;justify-content:center;color:inherit}
.wt .g-slide{position:static;opacity:1;transform:none;width:100%;height:100%;display:flex;align-items:center;justify-content:center}
.wt .g-slide>*{animation:none;max-width:88%}
.wt .g-slide.real>*{max-width:none}
.wt .g-photo{width:100%;height:100%;object-fit:cover}
.wt-name{position:absolute;left:0;right:0;bottom:0;padding:14px 16px;font-size:13px;letter-spacing:-.01em;color:#fff;background:linear-gradient(180deg,rgba(11,11,13,0),rgba(11,11,13,.85));opacity:0;transform:translateY(6px);transition:opacity .3s,transform .4s var(--ease)}
.wt-name b{font-weight:500}
.wt-name span{opacity:.7;margin-left:8px}
.wt:hover .wt-name{opacity:1;transform:none}
.wt .g-illus{top:10px;right:10px}
#work .trust-strip{margin-top:40px}
@media (max-width:640px){#work{padding:90px 0 60px}.reels{gap:10px;margin-top:30px}.reel-track{gap:10px}.wt{height:clamp(240px,34vh,300px)}}
.work-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:20px;margin-top:64px}
.work-card{border:1px solid rgba(8,8,8,.1);background:var(--bg);overflow:hidden;position:relative;border-radius:var(--r-lg);
  transition:box-shadow .45s var(--ease),transform .3s var(--ease);transform-style:preserve-3d;will-change:transform}
.work-card:hover{}
.wc-big{grid-column:span 3}
.wc-small{grid-column:span 2}
.gallery{height:270px;position:relative;overflow:hidden;border-radius:var(--r-lg) var(--r-lg) 0 0}
.wc-small .gallery{height:212px}
.g-slide{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transform:translateX(46px) scale(.98);
  transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1);pointer-events:none}
.g-slide.on{opacity:1;transform:none;pointer-events:auto}
.g-slide.off{transform:translateX(-46px) scale(.98)}
.g-slide.on>*{animation:float 6s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
.g-dots{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);display:flex;gap:6px;z-index:5}
.g-dot{width:7px;height:7px;background:rgba(8,8,8,.25);transition:background .25s,transform .25s;cursor:pointer;border:none;padding:0}
.g-dot.on{background:var(--accent);transform:scale(1.25)}
.g-tag{position:absolute;top:14px;left:14px;z-index:5;font-family:var(--mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;
  background:rgba(7,7,9,.72);backdrop-filter:blur(8px);color:#fff;padding:6px 12px;border-radius:0}
.g-illus{position:absolute;top:14px;right:14px;z-index:5;font-family:var(--mono);font-size:8px;letter-spacing:.1em;text-transform:uppercase;
  background:rgba(7,7,9,.72);backdrop-filter:blur(8px);color:rgba(255,255,255,.7);padding:6px 10px;border-radius:0}
.wc-info{padding:22px 24px;border-top:1px solid var(--border)}
.wc-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.wc-kind{font-family:var(--mono);font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:var(--accent-dark);margin-bottom:8px}
.wc-name{font-size:22px;font-weight:400;letter-spacing:-.015em;margin-bottom:6px}
/* Cadena "Empresas": las tarjetas avanzan solas en bucle; el scroll las empuja; al tocar o pasar el cursor se frenan */
#work.rail{padding:0;background:var(--black);overflow:visible;position:relative;z-index:1}
/* llega desde el fondo mientras el cubo se abre (--fin lo escribe el cubo: 0 cerrado → 1 abierto) */
#work.rail .work-sticky{position:sticky;top:0;height:100vh;height:100dvh;display:flex;flex-direction:column;justify-content:safe center;overflow:hidden;padding-top:64px}
#work.rail .section-h2{font-size:clamp(26px,3.4vw,46px);max-width:22ch}
#work.rail .section-label{margin-bottom:10px}
@media (max-height:800px){ #work.rail .section-sub,#work.rail .trust-strip{display:none} #work.rail .work-grid{margin-top:22px} }
#work.rail .section-inner{width:100%}
#work.rail .trust-strip{margin-top:22px;padding:12px 0}
#work.rail .work-grid{display:flex!important;gap:22px;margin-top:36px;width:max-content;padding:0 44px;will-change:transform;overflow:visible;scroll-snap-type:none}
/* tarjetas = imagen; el texto solo al detener (cursor) o tocar */
#work.rail .work-card{flex:0 0 min(820px,72vw,calc(52vh * 1.415));grid-column:auto;position:relative;cursor:grab}
#work.rail .work-card:active{cursor:grabbing}
#work.rail .gallery{height:auto;aspect-ratio:1;border-radius:var(--r-lg)}
#work.rail .g-slide .g-photo{object-fit:cover}
#work.rail .wc-info{position:absolute;left:0;right:0;bottom:0;padding:22px 24px 20px;background:linear-gradient(180deg,rgba(11,11,13,0) 0%,rgba(11,11,13,.86) 45%,rgba(11,11,13,.96) 100%);opacity:0;transform:translateY(12px);transition:opacity .35s ease,transform .45s cubic-bezier(.16,1,.3,1);pointer-events:none}
#work.rail .work-card:hover .wc-info,#work.rail .work-card.open .wc-info{opacity:1;transform:none;pointer-events:auto}
#work.rail .wc-desc{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
#work.rail .g-dots{bottom:14px}
#work.rail .work-grid{align-items:flex-start}
#work.rail .cta-band{flex:0 0 min(520px,46vw,calc(52vh * 0.9));display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:18px;margin:0;padding:32px}
#work.rail .cta-band{height:calc(52vh * 1.415 * 0.707);overflow:hidden}
#work.rail .cta-band .band-text{font-size:clamp(20px,2.3vw,30px)}
#work.rail .rail-hint{display:none}
@media (max-width:640px){
  #work.rail .work-sticky{padding-top:40px}
  #work.rail .section-sub,#work.rail .trust-strip{display:none}
  #work.rail .section-h2{font-size:clamp(30px,8.6vw,40px)}
  #work.rail .work-grid{gap:14px;padding:0 22px;margin-top:22px}
  #work.rail .work-card{flex:0 0 min(86vw,calc(52vh * 1.415))}
  #work.rail .cta-band{flex:0 0 78vw}
}
@media (prefers-reduced-motion: reduce){ #work.rail{height:auto!important;padding:90px 0} #work.rail .work-sticky{position:static;height:auto} #work.rail .work-grid{transform:none!important;width:auto;overflow-x:auto;padding-bottom:12px} }
.trust-strip{display:flex;flex-wrap:wrap;align-items:baseline;gap:14px;margin-top:32px;padding:18px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.trust-label{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);flex-shrink:0}
.trust-names{font-size:15px;letter-spacing:-.01em;color:var(--text2)}
.wc-desc{font-size:13px;color:var(--text2);line-height:1.6}
.wc-case{display:inline-block;margin-top:12px;font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent-dark);border-bottom:1px solid var(--accent-dark)}
.wc-case:hover{color:var(--accent);border-color:var(--accent)}
.wc-socials{display:flex;gap:8px;flex-shrink:0}
.wc-soc{width:30px;height:30px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;transition:border-color .2s,background .2s,color .2s;color:var(--text2)}
.wc-soc:hover{border-color:var(--accent);background:var(--accent);color:#fff}

/* mockups */
.browser{width:86%;background:#fff;border:1px solid rgba(8,8,8,.1);overflow:hidden}
.browser-bar{display:flex;align-items:center;gap:6px;padding:8px 12px;border-bottom:1px solid #eee;background:#fafafa}
.b-dot{width:7px;height:7px;border-radius:50%;background:#ddd}
.b-url{flex:1;margin-left:8px;background:#f0f0f0;font-family:var(--mono);font-size:8.5px;color:#999;padding:3px 10px}
.phone{width:112px;background:#050505;border-radius:18px;padding:7px}
.phone-screen{background:#fff;border-radius:12px;overflow:hidden;height:186px}
.ig-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px;padding:2px}
.ig-cell{aspect-ratio:1;background:linear-gradient(135deg,#f3e2d8,#e8c8b8)}
.ig-cell:nth-child(2){background:linear-gradient(135deg,#dce8dc,#b8d0b8)}
.ig-cell:nth-child(3){background:linear-gradient(135deg,#e8dce0,#d0b8c4)}
.ig-cell:nth-child(4){background:linear-gradient(135deg,#eee8e0,#d6cabb)}
.ig-cell:nth-child(5){background:linear-gradient(135deg,#f0e8d8,#dcc8a8)}
.ig-cell:nth-child(6){background:linear-gradient(135deg,#e4dcd4,#c8b8a8)}
.dash{padding:10px;display:flex;flex-direction:column;gap:6px}
.dash-row{display:flex;gap:6px}
.dash-kpi{flex:1;background:#f4f4f4;padding:8px;display:flex;flex-direction:column;gap:4px}
.dash-kpi-n{font-size:12px;font-weight:700;font-variant-numeric:tabular-nums}
.dash-kpi-l{font-size:6.5px;color:#999;font-family:var(--mono);text-transform:uppercase;letter-spacing:.08em}
.dash-bars{display:flex;align-items:flex-end;gap:4px;height:44px;background:#fafafa;padding:6px}
.dash-bar{flex:1;background:var(--accent);opacity:.85;animation:bar-grow 2.6s ease-in-out infinite alternate}
@keyframes bar-grow{from{transform:scaleY(.7)}to{transform:scaleY(1)}}
.linkhub{padding:14px 16px;display:flex;flex-direction:column;gap:7px;align-items:center;width:100%}
.lh-avatar{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,#e8a0b8,#c86888)}
.lh-name{font-size:9px;font-weight:700}
.lh-btn{width:100%;padding:7px;border:1px solid #e0e0e0;font-size:7.5px;text-align:center;color:#555;background:#fafafa}
.live-ui{background:linear-gradient(160deg,#1e1114,#33121a);height:100%;display:flex;flex-direction:column;justify-content:flex-end;padding:10px;gap:5px}
.live-badge{position:absolute;top:8px;left:8px;background:var(--accent);color:#fff;font-size:7px;font-weight:700;padding:3px 7px}
.live-msg{background:rgba(255,255,255,.14);color:#fff;font-size:6.5px;padding:4px 8px;border-radius:8px;width:max-content;max-width:90%}
.brand-board{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:12px;width:78%}
.bb-logo{grid-column:span 2;background:#050505;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;padding:15px}
.bb-swatch{height:26px}
.bb-type{grid-column:span 2;padding:8px 10px;background:#f6f6f6;font-size:8px;color:#666;line-height:1.5}
.content-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;width:70%}
.cg-cell{aspect-ratio:1;background:linear-gradient(135deg,#e8e2d8,#d4c8b4)}
.cg-cell:nth-child(2){background:linear-gradient(135deg,#2d4a3e,#1e3229)}
.cg-cell:nth-child(4){background:linear-gradient(135deg,#c9a86a,#b08d4a)}
.svc{display:flex;flex-direction:column}
.svc-hero{background:#1d1d22;color:#fff;padding:14px 12px 12px;font-size:9px;font-weight:700}
.svc-hero small{display:block;font-weight:400;font-size:6.5px;opacity:.7;margin-top:3px}
.svc-cards{display:flex;gap:5px;padding:8px}
.svc-card{flex:1;border:1px solid #e8e8e8;padding:7px 6px;font-size:6.5px;color:#555}
.svc-card b{display:block;font-size:7px;color:#111;margin-bottom:3px}
.conf{padding:10px;display:flex;flex-direction:column;gap:5px}
.conf-head{font-size:8px;font-weight:700}
.conf-slide{background:linear-gradient(135deg,#191a1e,#26262c);height:52px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:7px;font-weight:700}
.conf-row{display:flex;gap:4px}
.conf-chip{flex:1;background:#f2f2f2;font-size:6px;padding:4px;text-align:center;color:#666}

/* Before/After */
.ba-block{grid-column:1 / -1;border:1px solid rgba(8,8,8,.1);background:var(--bg);padding:40px 42px;border-radius:var(--r-lg)}
.ba-head{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:10px;margin-bottom:26px}
.ba-title{font-size:22px;font-weight:700;letter-spacing:-.02em}
.ba-note{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--text3)}
.ba-stage{position:relative;height:270px;overflow:hidden;user-select:none;cursor:ew-resize;touch-action:none;border-radius:var(--r-md)}
.ba-side{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px}
.ba-before{background:repeating-linear-gradient(45deg,#ececec,#ececec 12px,#e2e2e2 12px,#e2e2e2 24px)}
.ba-before .ba-word{color:#9a9a9a}
.ba-before .ba-sub-w{color:#b0b0b0}
.ba-after{background:linear-gradient(150deg,#0a0a0a,#231012);clip-path:inset(0 0 0 50%)}
.ba-after .ba-word{color:#fff}
.ba-after .ba-sub-w{color:rgba(255,255,255,.5)}
.ba-word{font-size:clamp(26px,3.6vw,44px);font-weight:700;letter-spacing:-.03em}
.ba-sub-w{font-size:12px;font-family:var(--mono);letter-spacing:.14em;text-transform:uppercase}
.ba-after .ba-accent{color:var(--accent)}
.ba-divider{position:absolute;top:0;bottom:0;width:3px;background:var(--accent);left:50%;transform:translateX(-50%);z-index:5;pointer-events:none}
.ba-handle{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:40px;height:40px;background:var(--accent);z-index:6;
  display:flex;align-items:center;justify-content:center;pointer-events:none;box-shadow:0 8px 24px -6px rgba(229,57,53,.5)}
.ba-labels{position:absolute;top:14px;left:14px;right:14px;display:flex;justify-content:space-between;z-index:4;pointer-events:none}
.ba-label{font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;padding:5px 10px;background:rgba(11,11,13,.85);color:#fff}

/* ═══ Los más pedidos ═══ */
#top{padding:140px 0 40px;background:var(--bg);position:relative;overflow:hidden}
#top-canvas{position:absolute;inset:0;z-index:0;opacity:.5;pointer-events:none;-webkit-mask-image:linear-gradient(180deg,transparent 0%,#000 18%,#000 82%,transparent 100%);mask-image:linear-gradient(180deg,transparent 0%,#000 18%,#000 82%,transparent 100%)}
#top .section-inner{position:relative;z-index:2}
.top-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:60px}
.top-tile{position:relative;aspect-ratio:1;background:var(--surface);padding:26px;display:flex;flex-direction:column;justify-content:space-between;
  overflow:hidden;transition:background .3s,transform .35s var(--ease),box-shadow .45s var(--ease);cursor:pointer;text-align:left;border:none;font-family:var(--font);color:var(--text)}
top-mark{}.top-tile:hover{background:var(--bone);color:var(--ink);transform:translateY(-6px)}
.top-tile .tt-num{font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:var(--text3)}
.top-tile .tt-badge{position:absolute;top:18px;right:18px;font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;background:var(--accent);color:#fff;padding:5px 9px}
.top-tile .tt-name{font-size:clamp(22px,2.2vw,30px);font-weight:400;letter-spacing:-.03em;line-height:1.1;margin-top:auto;transition:color .5s var(--ease)}
.top-tile.lit .tt-name{color:var(--accent)}
.top-tile .tt-hook{font-size:13px;color:var(--text2);line-height:1.55;margin-top:10px;transition:color .3s}
.top-tile:hover .tt-hook{color:rgba(8,8,8,.65)}
.top-tile .tt-arrow{position:absolute;bottom:22px;right:22px;width:34px;height:34px;border:1px solid rgba(0,0,0,.15);display:flex;align-items:center;justify-content:center;font-size:16px;transition:all .3s var(--ease)}
.top-tile:hover .tt-arrow{background:var(--accent);border-color:var(--accent);color:#fff;transform:translate(3px,-3px)}
.top-tile .tt-px{position:absolute;width:10px;height:10px;background:var(--accent);top:26px;left:26px;opacity:0;transition:opacity .3s}
.top-tile:hover .tt-px{opacity:1}
.top-tile:hover .tt-num{color:rgba(8,8,8,.5);padding-left:18px}
.top-tile .tt-num{transition:padding .3s var(--ease),color .3s}

/* ═══ Catalog ═══ */
#catalog{padding:140px 0 110px;background:var(--black);position:relative;overflow:hidden;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
#catalog::before{content:'';position:absolute;top:-12%;left:50%;transform:translateX(-50%);width:1100px;height:720px;
  background:radial-gradient(50% 50% at 50% 50%,rgba(229,57,53,.14) 0%,transparent 70%);pointer-events:none;z-index:1}
#catalog-canvas{position:absolute;inset:0;z-index:0;opacity:.65;pointer-events:none;-webkit-mask-image:linear-gradient(180deg,transparent 0%,#000 16%,#000 84%,transparent 100%);mask-image:linear-gradient(180deg,transparent 0%,#000 16%,#000 84%,transparent 100%)}
#catalog .section-inner{position:relative;z-index:2}
/* cinta de la cadena */
.cat-bridge{margin-top:50px;position:relative;z-index:2;display:flex;gap:14px;flex-wrap:wrap;align-items:center}
.cat-btn-main{display:inline-block;border:1px solid var(--bone);color:var(--bone);font-family:var(--mono);font-size:13px;letter-spacing:.16em;text-transform:uppercase;padding:22px 38px;transition:background .4s var(--ease),border-color .4s,color .4s}
.cat-btn-main:hover{background:var(--accent);border-color:var(--accent);color:#fff}
.cat-btn-ghost{display:inline-block;border:1px solid rgba(8,8,8,.28);color:var(--text2);font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;padding:22px 26px;transition:border-color .4s,color .4s}
.cat-btn-ghost:hover{border-color:var(--bone);color:var(--bone)}
#simple.kin{height:230vh;position:relative;border-top:1px solid var(--border);padding:0;background:var(--bg)}
.kin-sticky{position:sticky;top:0;height:100vh;height:100dvh;display:flex;align-items:center;overflow:hidden}
.kin-label{font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-size:clamp(18px,2.2vw,24px);color:var(--accent);margin:0 0 14px}
.kin-h2{font-size:clamp(34px,6.4vw,84px);font-weight:400;letter-spacing:-.025em;line-height:1.02;margin:0;max-width:14ch;text-wrap:balance}
.kin-h2 .kin-w{display:inline-block;opacity:.28;transform:translateY(.35em) rotate(1.5deg);transition:opacity .35s ease,transform .5s cubic-bezier(.16,1,.3,1),color .35s}
.kin-h2 .kin-w.on{opacity:1;transform:none}
.kin-steps{list-style:none;margin:40px 0 0;padding:0;display:grid;gap:10px;max-width:760px}
.kin-step{display:grid;grid-template-columns:52px minmax(0,1fr);column-gap:14px;align-items:baseline;opacity:.35;transform:translateX(-10px);transition:opacity .4s ease,transform .5s cubic-bezier(.16,1,.3,1)}
.kin-step.seen{opacity:.45;transform:none}
.kin-step.on{opacity:1;transform:none}
.kin-n{font-family:var(--mono);font-size:12px;color:var(--accent);letter-spacing:.16em;padding-top:4px}
.kin-step h3{grid-column:2;font-size:clamp(22px,3.2vw,40px);font-weight:400;letter-spacing:-.02em;line-height:1.1;margin:0;transition:font-size .4s}
.kin-step p{grid-column:2;font-size:clamp(14px,1.4vw,17px);line-height:1.55;color:var(--text2);margin:6px 0 0;max-height:0;overflow:hidden;opacity:0;transition:max-height .5s cubic-bezier(.16,1,.3,1),opacity .4s}
.kin-step.on p{max-height:6em;opacity:1}
.kin-cta{margin-top:30px;opacity:0;transform:translateY(10px);transition:opacity .4s,transform .5s cubic-bezier(.16,1,.3,1);pointer-events:none}
.kin-cta.on{opacity:1;transform:none;pointer-events:auto}
.kin .sim-example{margin-top:18px;max-width:52ch}
@media (max-width:640px){
  #simple.kin{height:210vh}
  .kin-steps{margin-top:26px;gap:8px}
  .kin-step{grid-template-columns:40px minmax(0,1fr);column-gap:10px}
  .kin-cta .sim-cta{display:block;text-align:center}
}
@media (prefers-reduced-motion: reduce){
  #simple.kin{height:auto;padding:100px 0}
  .kin-sticky{position:static;height:auto}
  .kin-h2 .kin-w{opacity:1;transform:none}
  .kin-step,.kin-step.seen{opacity:1;transform:none}
  .kin-step p{max-height:none;opacity:1}
  .kin-cta{opacity:1;transform:none;pointer-events:auto}
}
.sim-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:60px}
.sim-step{border:1px solid var(--border);padding:34px 28px 38px;transition:border-color .4s var(--ease),background .4s var(--ease)}
.sim-step:hover{border-color:var(--accent);background:var(--accent-pale)}
.sim-n{font-family:var(--mono);font-size:11px;color:var(--accent);letter-spacing:.16em;display:inline-flex;align-items:center;gap:8px}
.sim-n::before{content:'';width:8px;height:8px;background:var(--accent)}
.sim-step h3{font-size:clamp(20px,2vw,26px);font-weight:400;margin-top:18px;letter-spacing:-.015em;line-height:1.2}
.sim-step p{font-size:14.5px;line-height:1.65;color:var(--text2);margin-top:12px}
.sim-cta{grid-column:1 / -1;justify-self:start;border:1px solid var(--bone);color:var(--bone);font-family:var(--mono);font-size:12px;letter-spacing:.16em;text-transform:uppercase;padding:18px 30px;margin-top:10px;transition:background .4s var(--ease),border-color .4s,color .4s}
.sim-example{font-size:14.5px;color:var(--text3);margin-top:30px;max-width:620px;line-height:1.65}
.sim-cta:hover{background:var(--accent);border-color:var(--accent);color:#fff}
.quiz{margin-top:50px;position:relative;z-index:2}
.qz-opts{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.qz-opt{text-align:left;background:transparent;border:1px solid rgba(8,8,8,.28);color:var(--bone);font-size:15.5px;font-weight:400;padding:20px 22px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:12px;transition:border-color .35s var(--ease),background .35s var(--ease)}
.qz-opt:hover{border-color:var(--accent);background:rgba(229,57,53,.1)}
.qz-opt.on{border-color:var(--accent);background:rgba(229,57,53,.16)}
.qz-opt .qa{color:var(--accent);flex-shrink:0}
.qz-answer{display:none;margin-top:14px;border:1px solid var(--accent);background:rgba(229,57,53,.08);padding:28px 26px}
.qz-answer.on{display:block;animation:qz-in .5s var(--ease)}
@keyframes qz-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.qz-rec{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
.qz-name{font-size:clamp(22px,2.6vw,32px);color:var(--bone);margin-top:10px;font-weight:400;letter-spacing:-.015em}
.qz-why{font-size:15px;color:var(--text2);margin-top:10px;line-height:1.65;max-width:560px}
.qz-ctas{display:flex;gap:10px;margin-top:22px;flex-wrap:wrap}
.qz-see{border:1px solid var(--bone);color:var(--bone);font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:14px 22px;transition:background .35s var(--ease),border-color .35s,color .35s}
.qz-see:hover{background:var(--accent);border-color:var(--accent);color:#fff}
.qz-wa{border:1px solid rgba(8,8,8,.3);color:var(--text2);font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:14px 22px;transition:border-color .35s,color .35s}
.qz-wa:hover{border-color:var(--bone);color:var(--bone)}
.belt-cta{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-top:36px;position:relative;z-index:2;border-top:1px solid rgba(8,8,8,.14);padding-top:28px}
.belt-cta-txt{font-size:15px;color:var(--text2);margin:0;max-width:520px}
.belt-cta-btn{display:inline-block;border:1px solid var(--bone);color:var(--bone);font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;padding:15px 28px;transition:background .4s var(--ease),border-color .4s,color .4s}
.belt-cta-btn:hover{background:var(--accent);border-color:var(--accent);color:#fff}
/* Mosaico de productos con personas: la foto detrás, el texto encima */
.top-tile.has-img{overflow:hidden;isolation:isolate;color:#fff}
.top-tile.has-img .tt-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transition:transform .9s var(--ease),filter .6s;filter:saturate(.85) brightness(.9)}
.top-tile.has-img::before{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(11,11,13,.08) 0%,rgba(11,11,13,.2) 40%,rgba(11,11,13,.88) 100%)}
.top-tile.has-img:hover{background:transparent;color:#fff;transform:translateY(-6px)}
.top-tile.has-img:hover .tt-img{transform:scale(1.05);filter:saturate(1) brightness(1)}
.top-tile.has-img .tt-num{color:rgba(8,8,8,.6)}
.top-tile.has-img .tt-hook{color:rgba(8,8,8,.78)}
.top-tile.has-img .tt-gen{position:absolute;top:14px;right:14px;font-family:var(--mono);font-size:9px;letter-spacing:.08em;color:rgba(8,8,8,.5);background:rgba(11,11,13,.55);padding:4px 7px}
.top-tile.has-img.lit{background:transparent}
.top-tile.has-img.lit .tt-img{filter:saturate(1) brightness(1)}
.top-tile.has-img:hover .tt-num{color:rgba(8,8,8,.6)}
@media (max-width:640px){ .top-tile.has-img{aspect-ratio:4/3;min-height:0} }
/* Comentarios de clientes y redes */
#voces{padding:120px 0 90px;background:var(--bg);border-top:1px solid var(--border)}
.voces-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:48px}
.voz{position:relative;border:1px solid var(--border);padding:28px 26px 24px;display:flex;flex-direction:column;gap:22px;min-height:190px;background:var(--surface);transition:border-color .4s,transform .4s var(--ease)}
.voz:hover{border-color:rgba(8,8,8,.3);transform:translateY(-4px)}
.voz::before{content:'';position:absolute;left:0;top:0;width:3px;height:36px;background:var(--accent)}
.voz-n{font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:var(--text3)}
.voz-stars{color:var(--accent);font-size:13px;letter-spacing:.2em;margin-top:-10px}
.voz-q{font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-size:22px;line-height:1.3;color:var(--text);margin:0}
.voz-q::before{content:'“';color:var(--accent);margin-right:2px}
.voz-q::after{content:'”';color:var(--accent);margin-left:2px}
.voz-who{margin-top:auto;display:flex;flex-direction:column;gap:5px}
.voz-name{font-family:var(--font);font-weight:400;font-size:26px;line-height:1.1;letter-spacing:-.025em;color:var(--text)}
.voz-biz{font-size:13px;color:var(--text3);letter-spacing:.01em}
.voz-biz a{color:var(--text2);border-bottom:1px solid var(--accent)}
#redes{padding:90px 0 120px;background:var(--bg)}
.redes-list{margin-top:64px;border-top:1px solid var(--border)}
.rl{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 48px;grid-template-areas:"k k" "h go" "d go";align-items:center;row-gap:14px;column-gap:24px;padding:40px 0 38px;border-bottom:1px solid var(--border);color:var(--text)}
.rl-k{grid-area:k}.rl-h{grid-area:h}.rl-d{grid-area:d}.rl-go{grid-area:go;align-self:center}
.rl::after{content:'';position:absolute;left:0;bottom:-1px;height:1px;width:0;background:var(--accent);transition:width .8s var(--ease)}
.rl:hover::after{width:100%}
.rl-k{font-family:var(--mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--text3)}
.rl-h{font-family:var(--font);font-size:clamp(30px,4.6vw,64px);line-height:1;letter-spacing:-.04em;color:var(--text);white-space:nowrap;transition:transform .7s var(--ease)}
.rl:hover .rl-h{transform:translateX(14px)}
.rl-d{font-size:14px;line-height:1.5;color:var(--text3);max-width:52ch}
.rl-go{justify-self:end;font-size:28px;line-height:1;color:var(--text3);transition:color .4s,transform .6s var(--ease)}
.rl:hover .rl-go{color:var(--accent);transform:translate(5px,-5px)}
@media (max-width:860px){.redes-list{margin-top:44px}.rl{grid-template-columns:1fr;grid-template-areas:"k" "h" "d";row-gap:8px;padding:28px 0}.rl-h{font-size:clamp(22px,6.6vw,40px)}.rl:hover .rl-h{transform:none}.rl-go{display:none}}
/* Durante la intro del cubo no hay menú ni barra de progreso */
#nav,#progress{transition:opacity .5s ease,transform .5s ease}
body.cubo-intro #nav{opacity:0;transform:translateY(-10px);pointer-events:none}
body.cubo-intro #progress{opacity:0}
@media (prefers-reduced-motion: reduce){body.cubo-intro #nav{opacity:1;transform:none;pointer-events:auto}}
.g-slide.real>*{animation:none}
.g-slide .g-photo{width:100%;height:100%;max-width:100%;object-fit:cover}
.wc-big .gallery{height:auto;aspect-ratio:1}
@media(max-width:640px){.phase-rail{display:flex;flex-direction:column;margin-top:64px;border-top:1px solid var(--border)}}
.reveal .phase-btn{opacity:0;transform:translateY(20px)}
.reveal.in .phase-btn{opacity:1;transform:none}
.phase-rail .phase-btn:nth-child(1){transition-delay:.02s}
.phase-rail .phase-btn:nth-child(2){transition-delay:.07s}
.phase-rail .phase-btn:nth-child(3){transition-delay:.12s}
.phase-rail .phase-btn:nth-child(4){transition-delay:.17s}
.phase-rail .phase-btn:nth-child(5){transition-delay:.22s}
.phase-rail .phase-btn:nth-child(6){transition-delay:.27s}
.phase-rail .phase-btn:nth-child(7){transition-delay:.32s}
.phase-rail .phase-btn:nth-child(8){transition-delay:.37s}
.phase-btn{color:var(--text);background:transparent;border:none;border-bottom:1px solid var(--border);padding:26px 10px;
  display:grid;grid-template-columns:120px 1fr auto;align-items:center;column-gap:28px;
  position:relative;text-align:left;cursor:pointer;
  transition:opacity .6s var(--ease),transform .6s var(--ease),background .3s,padding .3s var(--ease)}
.phase-btn:hover{background:var(--surface);padding-left:22px}
.phase-btn.active{background:var(--surface)}
.phase-num{font-size:44px;font-weight:700;letter-spacing:-.04em;line-height:1;color:transparent;
  -webkit-text-stroke:1px rgba(8,8,8,.35);transition:color .3s,-webkit-text-stroke .3s;font-variant-numeric:tabular-nums}
.phase-btn:hover .phase-num,.phase-btn.active .phase-num{color:var(--accent);-webkit-text-stroke:1.2px transparent}
.phase-info{display:flex;flex-direction:column;gap:4px}
.phase-title{font-size:clamp(20px,2vw,26px);font-weight:400;letter-spacing:-.015em;line-height:1.15;color:var(--bone);transition:color .4s var(--ease)}
.phase-btn:hover .phase-title,.phase-btn.active .phase-title{color:var(--accent)}
.phase-tag{font-size:13px;color:var(--text3);line-height:1.5}
.phase-meta{display:flex;align-items:center;gap:18px}
.phase-count{font-family:var(--mono);font-size:11px;letter-spacing:.08em;color:var(--text3)}
.phase-arrow{font-size:20px;color:var(--text3);transition:transform .3s var(--ease),color .3s}
.phase-btn:hover .phase-arrow{transform:translateX(5px);color:var(--accent)}
.phase-btn.active .phase-arrow{transform:rotate(90deg);color:var(--accent)}
#phase-panel{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s cubic-bezier(.16,1,.3,1);margin-top:8px}
#phase-panel.open{grid-template-rows:1fr}
#phase-panel-inner{overflow:hidden}
.panel-content{background:var(--bg);border:1px solid rgba(8,8,8,.1);border-top:3px solid var(--accent);padding:44px;border-radius:var(--r-lg)}
.panel-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:24px;gap:24px}
.panel-title{font-size:24px;font-weight:700;letter-spacing:-.025em}
.panel-problem{color:var(--text2);font-size:14px;font-style:italic;margin-top:8px}
.panel-close{background:none;border:none;font-size:26px;color:var(--text3);line-height:1;padding:4px 8px;transition:color .15s,transform .25s}
.panel-close:hover{color:var(--text);transform:rotate(90deg)}
.chips-grid{display:flex;flex-wrap:wrap;gap:10px}
.chip{border:1px solid rgba(8,8,8,.1);padding:14px 22px;display:inline-flex;align-items:center;gap:11px;background:var(--bg);border-radius:0;
  font-size:14px;font-weight:700;letter-spacing:-.01em;transition:border-color .25s,background .25s,transform .3s var(--ease),box-shadow .35s var(--ease);cursor:pointer}
.chip:hover{border-color:var(--accent);background:var(--accent-pale);transform:translateY(-3px)}
.chip-px{width:8px;height:8px;background:var(--accent);flex-shrink:0}
.chip-plus{font-family:var(--mono);font-size:13px;color:var(--text3);margin-left:2px;transition:color .2s}
.chip:hover .chip-plus{color:var(--accent)}
.panel-next{margin-top:30px;padding:24px 28px;background:var(--accent-pale);border-left:3px solid var(--accent);border-radius:var(--r-sm);display:flex;align-items:center;justify-content:space-between;gap:20px;cursor:pointer;transition:background .2s}
.panel-next:hover{background:#fbe0de}
.panel-next-label{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-dark);margin-bottom:8px}
.panel-next-text{font-size:14px;color:#8e1f1c;line-height:1.6}
.panel-next-arrow{font-size:24px;color:var(--accent);flex-shrink:0;animation:nudge 1.8s ease-in-out infinite}
@keyframes nudge{0%,100%{transform:translateX(0)}50%{transform:translateX(7px)}}
.panel-hint{margin-top:24px;font-size:13px;color:var(--text3);text-align:center}

/* Product modal */
#modal-overlay{position:fixed;inset:0;background:rgba(5,5,5,.55);backdrop-filter:blur(6px);z-index:300;
  display:flex;align-items:center;justify-content:center;padding:24px;opacity:0;pointer-events:none;transition:opacity .3s}
#modal-overlay.open{opacity:1;pointer-events:auto}
#modal{background:var(--bg);border-top:4px solid var(--accent);max-width:640px;width:100%;max-height:86vh;overflow-y:auto;border-radius:var(--r-lg);
  padding:44px 46px 38px;position:relative;transform:translateY(28px) scale(.97);transition:transform .35s cubic-bezier(.16,1,.3,1)}
#modal-overlay.open #modal{transform:none}
#modal-close{position:absolute;top:16px;right:18px;background:none;border:none;font-size:28px;color:var(--text3);line-height:1;transition:color .15s,transform .25s}
#modal-close:hover{color:var(--text);transform:rotate(90deg)}
.m-phase{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:10px}
.m-name{font-size:27px;font-weight:700;letter-spacing:-.028em;line-height:1.15;margin-bottom:18px}
.m-what{font-size:15px;color:var(--text2);line-height:1.75;margin-bottom:28px}
.m-sec{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--text3);margin-bottom:14px}
.m-steps{display:flex;flex-direction:column;margin-bottom:28px}
.m-step{display:flex;gap:18px;padding:13px 0;border-top:1px solid var(--border)}
.m-step:last-child{border-bottom:1px solid var(--border)}
.m-step-n{font-family:var(--mono);font-size:11px;color:var(--accent);font-weight:500;min-width:22px;padding-top:2px}
.m-step-t{font-size:13.5px;color:var(--text2);line-height:1.6}
.m-result{background:var(--accent-pale);border-left:3px solid var(--accent);padding:18px 22px;margin-bottom:30px}
.m-result-l{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-dark);margin-bottom:7px}
.m-result-t{font-size:14px;color:#8e1f1c;line-height:1.6;font-weight:500}
.m-actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.m-cta{padding:14px 26px;background:transparent;color:var(--bone);font-size:12.5px;font-weight:400;letter-spacing:.05em;text-transform:uppercase;border:1px solid var(--bone);position:relative;overflow:hidden;border-radius:0}
.m-cta::before{content:'';position:absolute;inset:0;background:#25D366;transform:translateY(101%);transition:transform .3s cubic-bezier(.16,1,.3,1)}
.m-cta:hover::before{transform:none}
.m-cta span{position:relative;z-index:1}
.m-soon{font-family:var(--mono);font-size:10px;color:var(--text3);letter-spacing:.06em;margin-top:14px}
.m-cta-ghost{border-color:rgba(8,8,8,.35)}
.m-cta-ghost::before{background:var(--accent)}
.m-cta-ghost:hover{color:#fff}

/* ═══ Black box ═══ */
#blackbox{background:var(--black);color:#fff;padding:150px 0;position:relative;overflow:hidden}
#blackbox::before{content:'';position:absolute;top:-20%;left:50%;transform:translateX(-50%);width:900px;height:600px;
  background:radial-gradient(50% 50% at 50% 50%,rgba(229,57,53,.14) 0%,transparent 70%);pointer-events:none;z-index:1}
#bb-canvas{position:absolute;inset:0;z-index:0;opacity:.5;-webkit-mask-image:linear-gradient(180deg,transparent 0%,#000 16%,#000 84%,transparent 100%);mask-image:linear-gradient(180deg,transparent 0%,#000 16%,#000 84%,transparent 100%)}
#blackbox .section-inner{z-index:2}
#blackbox h2{font-size:clamp(34px,5.8vw,84px);font-weight:400;letter-spacing:-.02em;line-height:1.02;margin-top:16px}
#blackbox h2 .accent{color:var(--accent)}
#blackbox .bb-sub{color:rgba(255,255,255,.55);font-size:16px;line-height:1.75;margin-top:22px;max-width:540px}
.bb-term{font-family:var(--mono);font-size:13px;margin-top:36px;padding:16px 22px;border:1px solid rgba(255,255,255,.1);border-radius:0;
  background:rgba(255,255,255,.04);display:inline-flex;align-items:center;gap:2px;max-width:100%;overflow:hidden;white-space:nowrap}
.bb-term-prompt{color:var(--accent);margin-right:8px}
#bb-type{color:rgba(255,255,255,.75)}
.bb-caret{display:inline-block;width:8px;height:15px;background:var(--accent);margin-left:3px;animation:px-blink 1s steps(2) infinite}
.bb-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:56px}
.bb-item{border:1px solid rgba(255,255,255,.08);padding:32px 30px;background:rgba(255,255,255,.03);border-radius:var(--r-md);
  transition:border-color .3s,background .3s,transform .35s var(--ease)}
.bb-item:hover{transform:translateY(-4px)}
.bb-item:hover{border-color:var(--accent);background:rgba(229,57,53,.05)}
.bb-px{width:10px;height:10px;background:var(--accent);margin-bottom:18px;animation:px-blink 2.2s steps(2) infinite}
.bb-item h3{font-size:17px;font-weight:700;margin-bottom:12px}
.bb-item p{font-size:13.5px;color:rgba(255,255,255,.5);line-height:1.7}

/* ═══ Community ═══ */
#community{padding:140px 0;background:var(--bg)}
.comm-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:56px}
.comm-card{border:1px solid rgba(8,8,8,.1);padding:32px 28px;display:flex;flex-direction:column;gap:14px;border-radius:var(--r-md);
  transition:border-color .25s,transform .35s var(--ease),box-shadow .45s var(--ease);position:relative;overflow:hidden}
.comm-card::after{content:'';position:absolute;bottom:0;left:0;width:100%;height:3px;background:var(--accent);transform:scaleX(0);transform-origin:left;transition:transform .3s cubic-bezier(.16,1,.3,1)}
.comm-card:hover{transform:translateY(-6px)}
.comm-card:hover::after{transform:none}
.comm-icon{width:44px;height:44px;background:var(--accent-pale);display:flex;align-items:center;justify-content:center;color:var(--accent)}
.comm-name{font-size:16px;font-weight:700}
.comm-handle{font-family:var(--mono);font-size:11px;color:var(--text3)}
.comm-card.soon{cursor:default}
.comm-card.soon:hover{transform:none}
.comm-cta.soon{color:var(--text3);font-weight:400}
.comm-desc{font-size:12.5px;color:var(--text2);line-height:1.6;flex:1}
.comm-cta{font-size:12px;font-weight:700;color:var(--accent);display:flex;align-items:center;gap:6px}

/* ═══ Feed de redes ═══ */
#feed{padding:140px 0 120px;background:var(--bg)}
.feed-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-top:56px}
.feed-tile{aspect-ratio:1;position:relative;overflow:hidden;background:var(--surface);display:flex;align-items:flex-end;padding:14px;
  transition:transform .35s var(--ease),box-shadow .4s var(--ease)}
.feed-tile:hover{transform:translateY(-5px)}
.feed-tile::before{content:'';position:absolute;inset:0;background:var(--ft-bg)}
.feed-tile::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(7,7,9,.72));opacity:.9}
.feed-tile.big{grid-column:span 2;grid-row:span 2}
.feed-net{position:absolute;top:12px;left:12px;z-index:2;font-family:var(--mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:#fff;background:rgba(7,7,9,.72);padding:5px 9px}
.feed-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:2;width:40px;height:40px;background:rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center;transition:transform .3s var(--ease),background .3s}
.feed-tile:hover .feed-play{transform:translate(-50%,-50%) scale(1.12);background:var(--accent)}
.feed-tile:hover .feed-play svg path{fill:#fff}
.feed-cap{position:relative;z-index:2;color:#fff;font-size:12px;font-weight:700;letter-spacing:-.01em;line-height:1.35}
.feed-foot{display:flex;gap:10px;margin-top:28px;flex-wrap:wrap}
.feed-btn{padding:13px 22px;border:1px solid rgba(8,8,8,.16);font-size:13px;font-weight:700;display:inline-flex;align-items:center;gap:9px;transition:border-color .2s,background .2s,color .2s}
.feed-btn.soon{cursor:default;opacity:.55}
.feed-btn:hover{border-color:var(--accent);background:var(--accent);color:#fff}

/* ═══ Iconos animados ═══ */
.comm-icon{transition:transform .35s var(--ease),background .3s,color .3s}
.comm-card:hover .comm-icon{background:var(--accent);color:#fff;transform:translateY(-4px)}
.comm-card:hover .comm-icon svg{animation:icon-wiggle .55s var(--ease)}
@keyframes icon-wiggle{0%{transform:rotate(0)}35%{transform:rotate(10deg) scale(1.12)}70%{transform:rotate(-7deg)}100%{transform:rotate(0)}}
.wc-soc svg{transition:transform .3s var(--ease)}
.wc-soc:hover svg{transform:scale(1.18) rotate(-8deg)}
.feed-btn svg{transition:transform .3s var(--ease)}
.feed-btn:hover svg{transform:scale(1.22) rotate(8deg)}
.waw-opt:hover .waw-opt-px{animation:px-blink .7s steps(2) infinite}

/* ═══ Contact ═══ */
/* Mientras lo piensas: rojo pleno, texto negro, contador y frases por producto */
#nicho{position:relative;height:340vh;background:var(--black)}
.nicho-sticky{position:sticky;top:0;height:100vh;height:100dvh;overflow:hidden;display:flex;align-items:center;padding-top:66px;box-sizing:border-box;background:rgba(229,57,53,var(--na,0));color:var(--text)}
.nicho-inner{width:100%}
.nicho-head{display:flex;justify-content:space-between;align-items:baseline;gap:20px;font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;opacity:.8}
.nicho-head .nicho-src{position:static;font-size:9.5px;opacity:.7;margin-left:auto}
.nicho-idx b{font-weight:500}
.nicho-num{font-family:var(--font);font-weight:400;font-size:clamp(76px,15.5vw,236px);line-height:.92;letter-spacing:-.055em;margin:26px 0 0;font-variant-numeric:tabular-nums}
.nicho-line{font-family:var(--font);font-size:clamp(22px,3.1vw,42px);letter-spacing:-.025em;line-height:1.15;margin:22px 0 0;max-width:26ch;min-height:2.3em;opacity:1;transform:none;transition:opacity .35s ease,transform .45s var(--ease)}
.nicho-line.swap{opacity:0;transform:translateY(10px)}
.nicho-link{display:inline-flex;align-items:center;gap:12px;margin-top:26px;border:1.5px solid currentColor;padding:13px 20px;font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:inherit;transition:background .3s,color .3s,opacity .35s}
.nicho-link:hover{background:#080808;color:#fff;border-color:#080808}
.nicho-link.swap{opacity:0}
.nicho-arrow{transition:transform .4s var(--ease)}
.nicho-link:hover .nicho-arrow{transform:translateX(6px)}
.nicho-fuente{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;opacity:.6;margin:16px 0 0;min-height:1.4em}
.nicho-end{font-family:var(--font);font-size:clamp(17px,1.7vw,22px);line-height:1.45;max-width:46ch;margin:28px 0 0;min-height:2.9em;opacity:0;transform:translateY(10px);transition:opacity .6s,transform .7s var(--ease)}
.nicho-end.on{opacity:.95;transform:none}
.nicho-cta{display:inline-block;margin-top:18px;background:#080808;color:#fff;font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:15px 24px;opacity:0;transform:translateY(8px);transition:opacity .5s,transform .6s var(--ease),background .3s}
.nicho-cta.on{opacity:1;transform:none}
.nicho-cta:hover{background:#fff;color:#080808}
.nicho-end b{font-weight:700}
.nicho-bar{position:absolute;left:0;right:0;bottom:0;height:3px;background:rgba(0,0,0,.12)}
.nicho-bar i{display:block;height:100%;width:0;background:#080808;transition:width .15s linear}
.nicho-src{font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;opacity:.55;margin:0}
@media (max-height:760px){.nicho-num{font-size:clamp(64px,12.5vw,170px);margin-top:16px}.nicho-line{margin-top:14px;font-size:clamp(20px,2.6vw,34px)}.nicho-link{margin-top:18px;padding:11px 16px}.nicho-end{margin-top:18px;font-size:16px}}
@media (max-width:640px){.nicho-sticky{padding-top:58px}.nicho-head{flex-wrap:wrap}.nicho-num{font-size:clamp(58px,19vw,96px);margin-top:20px}.nicho-line{font-size:clamp(20px,6vw,26px);max-width:none}.nicho-head .nicho-src{display:none}}
@media (prefers-reduced-motion: reduce){#nicho{height:auto}.nicho-sticky{position:static;height:auto;padding:90px 0;background:var(--accent);color:#080808}.nicho-end{opacity:1;transform:none}}
/* Resultados por cliente bajo las hileras */
.results{list-style:none;margin:44px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--border)}
.results li{padding:22px 24px 22px 0;display:flex;flex-direction:column;gap:6px;border-right:1px solid var(--border);margin-right:24px}
.results li:last-child{border-right:0;margin-right:0}
.results b{font-weight:500;font-size:15px;color:var(--text)}
.results span{font-size:15px;line-height:1.45;color:var(--text2)}
.results .res-link{font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:var(--text3);margin-top:4px;border-bottom:1px solid var(--border);align-self:flex-start}
.results .res-link:hover{color:var(--accent);border-color:var(--accent)}
/* Salida fácil + tres rutas */
.top-start{display:inline-flex;align-items:center;gap:14px;margin-top:34px;padding:18px 24px;border:1px solid var(--bone);color:var(--bone);font-size:16px;letter-spacing:-.01em;transition:background .3s,color .3s}
.top-start:hover{background:var(--accent);border-color:var(--accent);color:#fff}
.ts-px{width:8px;height:8px;background:var(--accent);flex-shrink:0}
.top-start:hover .ts-px{background:#fff}
.ts-arrow{transition:transform .4s var(--ease)}
.top-start:hover .ts-arrow{transform:translateX(6px)}
.packs{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:40px}
.pack{display:flex;flex-direction:column;gap:14px;padding:0 28px 26px;border:1px solid var(--border);background:var(--surface);color:var(--text);position:relative;overflow:hidden;transition:border-color .4s,transform .5s var(--ease)}
.pack-media{display:block;margin:0 -28px 12px;aspect-ratio:16/9;overflow:hidden;position:relative;background:var(--bg)}
.pack-media video,.pack-media img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.9) brightness(.92);transition:transform .9s var(--ease)}
.pack:hover .pack-media video,.pack:hover .pack-media img{transform:scale(1.04)}
.pack-media::after{content:'';position:absolute;inset:auto 0 0 0;height:50%;background:linear-gradient(180deg,rgba(17,17,20,0),var(--surface))}
.pack-tag{position:absolute;top:14px;left:14px;z-index:2;background:var(--accent);color:#fff;font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;padding:6px 10px}
.pack-hot{border-color:rgba(229,57,53,.5)}
