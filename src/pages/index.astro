<body>
<div id="progress"></div>
<div id="cursor"><div id="cursor-ring"><span id="cursor-text"></span></div><div id="cursor-dot"></div></div>

<div id="reel">
  <div class="reel-progress" id="reel-progress"></div>
  <button id="reel-close" aria-label="Cerrar">×</button>
  <div id="reel-slides"></div>
  <div class="reel-hint" id="reel-hint"></div>
</div>

<nav id="nav">
  <span class="nav-logo">BIE</span>
  <div class="nav-links">
    <a href="#work" class="nav-link" data-sec="work" data-i18n="nav_work" set:html={es('nav_work')}></a>
    <a href="/catalogo/" class="nav-link" data-sec="catalog" data-i18n="nav_catalog" set:html={es('nav_catalog')}></a>
