  </div>
  <div class="ty-row" id="ty-row">
    <article class="ty-c">
      <div class="ty-s ty-marca" aria-hidden="true">
        <b class="ty-m1" data-ty></b>
        <b class="ty-m2" data-ty></b>
        <b class="ty-m3" data-ty></b>
      </div>
      <h3 class="ty-t" data-i18n="ty_c1_k" set:html={es('ty_c1_k')}></h3>
      <p class="ty-d" data-i18n="ty_c1" set:html={es('ty_c1')}></p>
    </article>
    <article class="ty-c">
      <div class="ty-s ty-web" aria-hidden="true">
        <p class="ty-bus" data-ty></p>
        <div class="ty-res">
          <small data-ty-dom></small>
          <b><span data-ty></span> | <span data-i18n="ty_w_t" set:html={es('ty_w_t')}></span></b>
          <p data-i18n="ty_w_d" set:html={es('ty_w_d')}></p>
        </div>
        <i></i><i></i><i></i><i></i>
      </div>
      <h3 class="ty-t" data-i18n="ty_c2_k" set:html={es('ty_c2_k')}></h3>
      <p class="ty-d" data-i18n="ty_c2" set:html={es('ty_c2')}></p>
    </article>
    <article class="ty-c">
      <div class="ty-s ty-chat" aria-hidden="true">
        <header><b data-ty></b><small data-i18n="ty_m_on" set:html={es('ty_m_on')}></small></header>
        <p class="ty-in-m"><span data-i18n="ty_m_q" set:html={es('ty_m_q')}></span><time>23:07</time></p>
        <p class="ty-out-m"><span data-i18n="ty_m_a" set:html={es('ty_m_a')}></span> <b data-ty></b>. <span data-i18n="ty_m_b" set:html={es('ty_m_b')}></span><time>23:07</time></p>
      </div>
      <h3 class="ty-t" data-i18n="ty_c3_k" set:html={es('ty_c3_k')}></h3>
      <p class="ty-d" data-i18n="ty_c3" set:html={es('ty_c3')}></p>
    </article>
    <article class="ty-c">
      <div class="ty-s ty-sis" aria-hidden="true">
        <header><b data-ty></b><small data-i18n="ty_s_h" set:html={es('ty_s_h')}></small></header>
