<!-- CATÁLOGO: se entiende que son 47 y que se puede pedir uno solo -->
<section id="productos" aria-label="Catálogo de productos">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="pc_k" set:html={es('pc_k')}></p>
      <h2 class="section-h2" data-i18n="pc_h" set:html={es('pc_h')}></h2>
      <p class="section-sub" data-i18n="pc_d" set:html={es('pc_d')}></p>
    </div>
  </div>
  <div class="px" id="px">
    <div class="px-sticky">
      <div class="px-chips" id="px-chips">
        {PX_CATS.map((c) => <button type="button" data-cat={c.num} data-es={CATS[c.num].es} data-en={CATS[c.num].en}>{CATS[c.num].es}</button>)}
      </div>
      <div class="px-main">
        <ol class="px-wheel" id="px-wheel">
          {PX_ITEMS.map((x) => (
            <li data-cat={x.cat} data-slug={x.slug} data-d-es={x.d.es} data-d-en={x.d.en}><a href={pHref(x.slug)} data-es={x.n.es} data-en={x.n.en}>{x.n.es}</a></li>
          ))}
        </ol>
        <aside class="px-card" id="px-card">
          <div class="px-map" id="px-map" aria-hidden="true"></div>
          <p class="px-count"><b id="px-n">1</b> / {PX_ITEMS.length}<span id="px-cat"></span></p>
          <p class="px-desc" id="px-desc">{PX_ITEMS[0].d.es}</p>
          <div class="px-ctas">
            <a class="btn-primary" id="px-wa" href={'https://wa.me/' + WA_NUM_SSR} target="_blank" rel="noopener"><span data-i18n="px_wa" set:html={es('px_wa')}></span></a>
            <a class="px-see" id="px-see" href={pHref(PX_ITEMS[0].slug)} data-i18n="px_see" set:html={es('px_see')}></a>
          </div>
        </aside>
      </div>
    </div>
  </div>
  <div class="section-inner px-after">
    <a class="pc-one" href="/catalogo/?src=home-catalogo" data-i18n="pc_all" set:html={es('pc_all')}></a>
  </div>
</section>

<!-- WORK -->
<section id="work">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="work_label" set:html={es('work_label')}></p>
      <h2 class="section-h2" data-i18n="work_h2" set:html={es('work_h2')}></h2>
      <p class="section-sub" data-i18n="work_sub" set:html={es('work_sub')}></p>
    </div>
  </div>
  <div class="gx reveal d1" id="gx" tabindex="0" role="group" aria-label="Trabajos de nuestros clientes. Usa las flechas del teclado para moverte."><div class="gx-stage" id="gx-stage"></div></div>
  <div class="section-inner gx-info">
