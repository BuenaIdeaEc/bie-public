    </ul>
  </div>
</section>

<!-- ESTE MES EN BIE: destacado mensual (datos en src/data/este-mes.ts) -->
<EsteMes data={ESTE_MES} />

<!-- LOS MÁS PEDIDOS -->
<section id="top">
  <canvas id="top-canvas"></canvas>
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="top_label" set:html={es('top_label')}></p>
      <h2 class="section-h2" data-i18n="top_h2" set:html={es('top_h2')}></h2>
      <p class="section-sub" data-i18n="top_sub" set:html={es('top_sub')}></p>
    </div>
    <a class="top-start reveal d1" href={WA_START_SSR} target="_blank" rel="noopener"><span class="ts-px"></span><span data-i18n="top_start" set:html={es('top_start')}></span><span class="ts-arrow" aria-hidden="true">→</span></a>
    <div class="packs reveal d1">
      {([['pk1', WA_PK1_SSR, 'pagina-web', true], ['pk2', WA_PK2_SSR, 'whatsapp-business-commerce', true], ['pk3', WA_PK3_SSR, 'crm-ia', false]] as [string, string, string, boolean][]).map(([k, href, media, vid], i) => (
        <a class={'pack' + (i === 1 ? ' pack-hot' : '')} href={href} target="_blank" rel="noopener">
          <span class="pack-media">{vid ? <video src={'/videos/productos/' + media + '.mp4'} poster={'/images/productos/' + media + '.webp'} muted loop playsinline autoplay preload="metadata" aria-hidden="true"></video> : <img src={'/images/productos/' + media + '.webp'} alt="" width="900" height="900" loading="lazy" decoding="async" />}{i === 1 && <span class="pack-tag" data-i18n="pk_tag2" set:html={es('pk_tag2')}></span>}</span>
          <span class="pack-k"><span data-i18n="pk_k" set:html={es('pk_k')}></span> 0{i + 1}</span>
