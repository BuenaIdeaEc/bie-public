html body #nav.dark-zone #burger span{background:var(--text)}
html body #mobile-menu{background:rgba(255,255,255,.82);-webkit-backdrop-filter:blur(26px);backdrop-filter:blur(26px)}
html body .mm-lang{background:none;border-width:0 0 1px;width:100%;color:inherit;font-family:var(--font);text-align:left}
html body .mm-cta{background:transparent}
/* tarjetas: blancas y rectas; el vidrio aparece donde hay foto o video detrás */
html body #voces,html body #catalog{background:#f5f5f3}
html body #catalog::before{display:none}
html body .est-right,html body .voz,html body .em-card,html body .qz-opt,html body .qz-answer,html body .panel-content{background:#fff;border:1px solid rgba(8,8,8,.1);box-shadow:none;border-radius:0;transform:none}
