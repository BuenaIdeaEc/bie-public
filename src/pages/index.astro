    <div class="waw-avatar">B</div>
    <div class="waw-head-info">
      <div class="waw-name" data-i18n="waw_name" set:html={es('waw_name')}></div>
      <div class="waw-status"><span class="waw-status-dot"></span><span data-i18n="waw_status" set:html={es('waw_status')}></span></div>
    </div>
