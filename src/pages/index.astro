@media (max-width:640px){.madlib{margin-top:36px}.ml-line{display:flex;flex-direction:column;gap:6px;margin:0 0 22px;font-size:0;line-height:1.4}.ml-line>span[data-i18n]{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--text3)}.ml-nw{display:contents}.ml-nw::after{display:none}.ml-field{display:block;width:100%}.ml-field input,.ml-sel select{display:block;width:100%!important;max-width:none;font-family:var(--font);font-size:22px;letter-spacing:-.02em;text-transform:none;color:var(--text);padding:6px 0 8px}.ml-sel::after{right:4px}.ml-msg{margin-top:4px}.ml-msg textarea{font-size:18px}.ml-actions{gap:22px;margin-top:28px}.madlib .form-submit{width:100%;text-align:center}}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;margin-top:56px;align-items:start}
