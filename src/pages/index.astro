/* === Pase de elegancia (2026-10-16): menos consola, más editorial. Sin tocar colores ni tipografías de marca === */
html body{cursor:auto}
html body a,html body button,html body select,html body input,html body textarea{cursor:pointer}
html body input,html body textarea{cursor:text}
html body #cursor{display:none}
#top-canvas,#catalog-canvas{display:none}
html body .eyebrow,html body .section-label{font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-weight:400;text-transform:none;letter-spacing:.005em;font-size:20px;color:var(--accent)}
html body .hero-dead{font-family:'Instrument Serif',Georgia,serif;font-style:italic;text-transform:none;letter-spacing:0;font-size:22px;color:var(--text3)}
html body .stat-l,html body .trust-label,html body .wc-kind,html body .qz-rec,html body .panel-next-label,html body .m-phase,html body .m-sec,html body .m-result-l,html body .feed-net,html body .field label,html body .video-tag,html body .ba-note,html body .top-tile .tt-badge{font-family:var(--font);text-transform:none;letter-spacing:.02em}
html body .wc-kind{font-size:13px}
html body .stat-l,html body .trust-label{font-size:13px}
html body .g-tag,html body .g-illus{font-family:var(--font);text-transform:none;letter-spacing:.02em}
html body .g-tag{font-size:12px}
html body .g-illus{font-size:11px}
html body .btn-primary,html body .btn-ghost,html body .nav-cta,html body .band-btn,html body .belt-cta-btn,html body .cat-btn-main,html body .cat-btn-ghost,html body .sim-cta,html body .qz-see,html body .qz-wa,html body .mm-cta,html body .wc-case{font-family:var(--font);text-transform:none;letter-spacing:.01em;font-size:15px}

/* === Ronda 2026-11-01: blanco, vidrio recto de verdad (cuadros que pasan detrás), letra limpia, nada intrusivo === */
html,body{background:#fff}
html body #hero.cubo,html body #work,html body #top,html body #simple.kin,html body #estrella,html body #voces,html body #catalog,html body #redes,html body #contact,html body footer,html body #nicho{background:#fff}
html body #catalog{border:0}
html body .serif{font-family:var(--font);font-style:normal;font-weight:inherit;font-size:1em;color:var(--text3);letter-spacing:inherit;line-height:inherit}
html body .section-h2,html body .kin-h2{letter-spacing:-.03em}
html body .section-label,html body .eyebrow,html body .kin-label{font-family:var(--font);font-style:normal;font-size:15px;letter-spacing:0;color:var(--text2)}
html body .section-label::before,html body .eyebrow::before{background:var(--accent);width:8px;height:8px}
html body .kin-label::before{content:'';display:inline-block;width:8px;height:8px;background:var(--accent);margin-right:10px;vertical-align:.08em}
html body .pack-k,html body .pack-ck,html body .est-price span,html body .kin-n,html body .rl-k,html body .nicho-head,html body .nicho-fuente,html body .nicho-link,html body .nicho-cta,html body .sim-cta,html body .belt-cta-btn,html body .cat-btn-main,html body .cat-btn-ghost,html body .qz-rec,html body .qz-see,html body .qz-wa,html body .top-tile .tt-num,html body .top-tile .tt-badge,html body .pack-tag,html body .voz-n,html body .footer-text,html body .footer-legal a,html body .pack-go,html body .form-note,html body .form-submit,html body .res-link,html body .cubo-lbl,html body #lang-toggle,html body .ml-line>span[data-i18n]{font-family:var(--font);letter-spacing:0;text-transform:none;font-size:13.5px}
/* botones: línea fina; el relleno rojo llega solo al pasar el cursor */
html body .btn-primary,html body .form-submit,html body .sim-cta,html body .nav-cta,html body .belt-cta-btn,html body .cat-btn-main,html body .top-start,html body .qz-see{background:transparent;border:1px solid var(--text);color:var(--text);font-size:15px}
html body .btn-primary::before,html body .form-submit::before,html body .nav-cta::before{background:var(--accent)}
html body .btn-primary:hover,html body .form-submit:hover,html body .nav-cta:hover{color:#fff;border-color:var(--accent);box-shadow:none;transform:none}
html body .sim-cta:hover,html body .belt-cta-btn:hover,html body .cat-btn-main:hover,html body .top-start:hover,html body .qz-see:hover{background:var(--accent);border-color:var(--accent);color:#fff}
html body .btn-ghost{color:var(--text2);text-decoration:underline;text-decoration-color:var(--border);text-underline-offset:5px}
