@media (max-width:860px){.results{grid-template-columns:1fr}.results li{border-right:0;margin-right:0;border-bottom:1px solid var(--border);padding:16px 0}.results li:last-child{border-bottom:0}.packs{grid-template-columns:1fr}.top-pick{margin:40px 0 -24px}.est-inner{grid-template-columns:1fr;gap:28px}#estrella{padding:80px 0}.top-start{width:100%;justify-content:space-between}}
