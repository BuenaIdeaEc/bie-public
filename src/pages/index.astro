.ml-field input,.ml-field select,.ml-msg textarea{font:inherit;letter-spacing:inherit;color:var(--text);background:transparent;border:0;border-bottom:2px solid rgba(8,8,8,.22);border-radius:0;padding:0 .2em .04em;outline:none;appearance:none;-webkit-appearance:none;transition:border-color .3s;min-width:0}
.ml-field input{width:8ch}
.ml-field input::placeholder,.ml-msg textarea::placeholder{color:var(--text3);opacity:1}
.ml-field input:focus,.ml-field select:focus,.ml-msg textarea:focus{border-bottom-color:var(--accent)}
.ml-field input:not(:placeholder-shown){border-bottom-color:rgba(8,8,8,.55)}
.ml-sel select{padding-right:1.1em;cursor:pointer;color:var(--text);max-width:min(70vw,22ch);text-overflow:ellipsis}
.ml-sel::after{content:'';position:absolute;right:.25em;top:50%;width:.42em;height:.42em;border-right:2px solid var(--accent);border-bottom:2px solid var(--accent);transform:translateY(-70%) rotate(45deg);pointer-events:none}
.ml-sel select option{background:var(--bg);color:var(--text);font-size:16px}
.ml-msg{margin-top:14px}
