.est-btn{align-self:flex-start;white-space:nowrap}
@media (max-width:860px){.results{grid-template-columns:1fr}.results li{border-right:0;margin-right:0;border-bottom:1px solid var(--border);padding:16px 0}.results li:last-child{border-bottom:0}.packs{grid-template-columns:1fr}.top-pick{margin:40px 0 -24px}.est-inner{grid-template-columns:1fr;gap:28px}#estrella{padding:80px 0}.top-start{width:100%;justify-content:space-between}}
#contact{padding:140px 0;background:var(--surface)}
/* Contacto como una frase: escribes dentro del texto, sin cajas */
.madlib{margin-top:64px;max-width:1040px}
.ml-line{font-family:var(--font);font-size:clamp(24px,3.6vw,50px);line-height:1.5;letter-spacing:-.025em;color:var(--text2);margin:0 0 6px}
.ml-field{display:inline-block;position:relative;vertical-align:baseline}
.ml-nw{white-space:nowrap}
.ml-field input,.ml-field select,.ml-msg textarea{font:inherit;letter-spacing:inherit;color:var(--text);background:transparent;border:0;border-bottom:2px solid rgba(255,253,249,.22);border-radius:0;padding:0 .2em .04em;outline:none;appearance:none;-webkit-appearance:none;transition:border-color .3s;min-width:0}
.ml-field input{width:8ch}
.ml-field input::placeholder,.ml-msg textarea::placeholder{color:var(--text3);opacity:1}
.ml-field input:focus,.ml-field select:focus,.ml-msg textarea:focus{border-bottom-color:var(--accent)}
.ml-field input:not(:placeholder-shown){border-bottom-color:rgba(255,253,249,.55)}
.ml-sel select{padding-right:1.1em;cursor:pointer;color:var(--text);max-width:min(70vw,22ch);text-overflow:ellipsis}
.ml-sel::after{content:'';position:absolute;right:.25em;top:50%;width:.42em;height:.42em;border-right:2px solid var(--accent);border-bottom:2px solid var(--accent);transform:translateY(-70%) rotate(45deg);pointer-events:none}
.ml-sel select option{background:var(--bg);color:var(--text);font-size:16px}
.ml-msg{margin-top:14px}
.ml-msg textarea{display:block;width:100%;resize:none;overflow:hidden;font-size:clamp(18px,2vw,26px);line-height:1.45;color:var(--text);min-height:1.6em}
.ml-actions{display:flex;align-items:center;gap:36px;flex-wrap:wrap;margin-top:44px}
.ml-points{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
.ml-points li{font-size:13px;color:var(--text3);padding-left:16px;position:relative}
.ml-points li::before{content:'';position:absolute;left:0;top:.5em;width:6px;height:6px;background:var(--accent)}
.madlib .form-submit{margin:0;padding:20px 34px;font-size:13px}
.madlib .form-note{text-align:left;margin-top:26px}
.madlib .form-privacy{margin-top:8px}
@media (max-width:640px){.madlib{margin-top:36px}.ml-line{display:flex;flex-direction:column;gap:6px;margin:0 0 22px;font-size:0;line-height:1.4}.ml-line>span[data-i18n]{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--text3)}.ml-nw{display:contents}.ml-nw::after{display:none}.ml-field{display:block;width:100%}.ml-field input,.ml-sel select{display:block;width:100%!important;max-width:none;font-family:var(--font);font-size:22px;letter-spacing:-.02em;text-transform:none;color:var(--text);padding:6px 0 8px}.ml-sel::after{right:4px}.ml-msg{margin-top:4px}.ml-msg textarea{font-size:18px}.ml-actions{gap:22px;margin-top:28px}.madlib .form-submit{width:100%;text-align:center}}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;margin-top:56px;align-items:start}
.contact-left h3{font-size:22px;font-weight:700;margin-bottom:16px}
.contact-left p{font-size:14.5px;color:var(--text2);line-height:1.75;margin-bottom:28px}
.contact-points{display:flex;flex-direction:column;gap:16px}
.cp{display:flex;align-items:center;gap:14px}
.cp-px{width:10px;height:10px;background:var(--accent);flex-shrink:0}
.cp span{font-size:13.5px;color:var(--text2)}
.form{display:flex;flex-direction:column;gap:14px;background:var(--bg);border:1px solid rgba(255,253,249,.1);padding:38px;border-radius:var(--r-lg)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.field{display:flex;flex-direction:column;gap:7px}
.field label{font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--text3)}
.field input,.field select,.field textarea{border:1px solid rgba(255,253,249,.16);padding:14px 16px;font-size:14px;background:var(--surface);
  transition:border-color .2s,background .2s,box-shadow .2s;outline:none;color:var(--text);appearance:none;border-radius:var(--r-sm)}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--accent);background:var(--bg);box-shadow:0 0 0 3px var(--accent-glow)}
.field textarea{resize:vertical;min-height:88px}
.form-submit{margin-top:6px;padding:16px;background:transparent;color:var(--bone);font-size:13px;font-weight:400;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--bone);position:relative;overflow:hidden;border-radius:0;
  transition:transform .3s var(--ease),box-shadow .35s var(--ease)}
.form-submit:hover{transform:translateY(-2px);box-shadow:0 14px 30px -8px rgba(37,211,102,.4)}
.form-submit::before{content:'';position:absolute;inset:0;background:#25D366;transform:translateY(101%);transition:transform .3s cubic-bezier(.16,1,.3,1)}
.form-submit:hover::before{transform:none}
