  </div>
</section>

<!-- PRODUCTO ESTRELLA: acompañamiento mensual -->
<section id="estrella">
  <div class="section-inner est-inner">
    <div class="est-left reveal">
      <p class="section-label" data-i18n="est_label" set:html={es('est_label')}></p>
      <h2 class="section-h2" data-i18n="est_h2" set:html={es('est_h2')}></h2>
      <p class="section-sub" data-i18n="est_p" set:html={es('est_p')}></p>
    </div>
    <div class="est-right reveal d1">
      <p class="est-price"><b data-i18n="est_price" set:html={es('est_price')}></b><span data-i18n="est_price_n" set:html={es('est_price_n')}></span></p>
      <ul class="est-l">{(UI_STATIC.est_l as any).es.map((x: string, j: number) => <li data-i18n-list="est_l" data-j={j}>{x}</li>)}</ul>
      <a class="btn-primary est-btn" href={WA_EST_SSR} target="_blank" rel="noopener"><span data-i18n="est_btn" set:html={es('est_btn')}></span> →</a>
    </div>
  </div>
</section>

<!-- MIENTRAS LO PIENSAS: la pantalla se tiñe de rojo, el contador sube y cada frase es un producto -->
<section id="nicho" aria-label="Tu nicho ya está en digital">
  <div class="nicho-sticky">
    <div class="nx-red" id="nx-red" aria-hidden="true"><div class="nx-tunnel" id="nx-tunnel"></div></div>
    <div class="section-inner nicho-inner">
      <div class="nicho-head">
        <span class="nicho-k" data-i18n="nicho_k" set:html={es('nicho_k')}></span>
      </div>
      <p class="nicho-num" aria-live="off"><span id="nicho-num">0</span></p>
      <p class="nicho-line" id="nicho-line"></p>
      <a class="nicho-link" id="nicho-link" href="/productos/"><span id="nicho-prod"></span><span class="nicho-arrow" aria-hidden="true">→</span></a>
      <p class="nicho-fuente" id="nicho-fuente"></p>
      <p class="nicho-end" id="nicho-end" data-i18n="nicho_end" set:html={es('nicho_end')}></p>
      <a class="nicho-cta" id="nicho-cta" href={WA_SIM_SSR} target="_blank" rel="noopener" data-i18n="nicho_cta" set:html={es('nicho_cta')}></a>
    </div>
    <div class="nicho-bar" aria-hidden="true"><i id="nicho-bar"></i></div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="ct_label" set:html={es('ct_label')}></p>
      <h2 class="section-h2" data-i18n="ct_h2" set:html={es('ct_h2')}></h2>
    </div>
    <form class="madlib reveal d1" id="contact-form">
      <p class="ml-line"><span data-i18n="ml1" set:html={es('ml1')}></span> <span class="ml-field"><input name="name" type="text" id="in-name" required placeholder={es('ph_name')} aria-label={es('f_name')} autocomplete="name"></span> <span data-i18n="ml2" set:html={es('ml2')}></span> <span class="ml-nw"><span class="ml-field"><input name="company" type="text" id="in-comp" placeholder={es('ph_comp')} aria-label={es('f_comp')} autocomplete="organization"></span>.</span></p>
      <p class="ml-line"><span data-i18n="ml3" set:html={es('ml3')}></span> <span class="ml-field ml-sel"><select name="need" id="in-need" aria-label={es('f_need')}></select></span> <span data-i18n="ml4" set:html={es('ml4')}></span> <span class="ml-nw"><span class="ml-field"><input name="phone" type="tel" id="in-phone" required placeholder="099 999 9999" aria-label={es('f_phone')} autocomplete="tel"></span>.</span></p>
      <p class="ml-line ml-msg"><textarea name="message" id="in-msg" rows="1" placeholder={es('ph_msg')} aria-label={es('f_msg')}></textarea></p>
      <div class="ml-actions">
        <button type="submit" class="form-submit"><span data-i18n="f_send" set:html={es('f_send')}></span> →</button>
        <ul class="ml-points">
          <li data-i18n="cp2" set:html={es('cp2')}></li>
          <li data-i18n="cp1" set:html={es('cp1')}></li>
          <li data-i18n="cp3" set:html={es('cp3')}></li>
        </ul>
      </div>
      <p class="form-note" data-i18n="f_note" set:html={es('f_note')}></p>
      <p class="form-note form-privacy" data-i18n="f_privacy" set:html={es('f_privacy')}></p>
    </form>
  </div>
</section>

</main>
<footer>
  <div class="footer-inner">
    <div class="footer-mark"><img src="/images/marca/bie-cuadro.webp" width="1000" height="1000" alt="Logo de BIE" loading="lazy" decoding="async"></div>
    <div class="footer-bottom">
      <span class="footer-text">BUSINESS INTELLIGENCE ENHANCER</span>
      <span class="footer-text">businessintelligence.solutions</span>
      <span class="footer-text" data-i18n="ft_ruc" set:html={es('ft_ruc')}></span>
      <span class="footer-text">© 2026</span>
      <span class="footer-legal"><a href="/quito/">Quito</a><a href="/guayaquil/">Guayaquil</a><a href="/cuenca/">Cuenca</a><a href="/restaurantes/">Restaurantes</a><a href="/moda/">Moda</a><a href="/salud/">Salud</a><a href="/recursos/">Recursos</a><a href="https://instagram.com/businessintelligence.ec" target="_blank" rel="noopener">Instagram</a><a href="https://wa.me/593988253030" target="_blank" rel="noopener">WhatsApp</a></span>
      <span class="footer-legal"><a href="/privacidad/" data-i18n="ft_lopdp" set:html={es('ft_lopdp')}></a><a href="/privacidad/">Privacidad</a><a href="/terminos/">Términos</a></span>
    </div>
  </div>
</footer>

<!-- PRODUCT MODAL -->
<div id="modal-overlay">
  <div id="modal">
    <button id="modal-close" aria-label="Cerrar">×</button>
    <div id="modal-body"></div>
  </div>
</div>


<script is:inline define:vars={{ UI: UI_STATIC }}>window.__UI = UI;</script>
<script is:inline define:vars={{ TASTING_ALT }}>window.__TASTING_ALT = TASTING_ALT;</script>
<script is:inline defer src={homeJs}></script>

<script src="/track.js" defer></script>

</body>
</html>
