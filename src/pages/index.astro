/* Contacto como una frase: escribes dentro del texto, sin cajas */
.madlib{margin-top:64px;max-width:1040px}
.ml-line{font-family:var(--font);font-size:clamp(24px,3.6vw,50px);line-height:1.5;letter-spacing:-.025em;color:var(--text2);margin:0 0 6px}
.ml-field{display:inline-block;position:relative;vertical-align:baseline}
