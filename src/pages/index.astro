.ml-actions{display:flex;align-items:center;gap:36px;flex-wrap:wrap;margin-top:44px}
.ml-points{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
.ml-points li{font-size:13px;color:var(--text3);padding-left:16px;position:relative}
.ml-points li::before{content:'';position:absolute;left:0;top:.5em;width:6px;height:6px;background:var(--accent)}
.madlib .form-submit{margin:0;padding:20px 34px;font-size:13px}
.madlib .form-note{text-align:left;margin-top:26px}
