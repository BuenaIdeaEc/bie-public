// ═══ Hero canvas ═══
(function(){
  const cv = document.getElementById('hero-canvas');
  const ctx = cv.getContext('2d');
  let W, H, px = [];
  const mouse = { x: -9999, y: -9999 };
  const DPR = Math.min(devicePixelRatio, 2);
  function resize(){
    W = cv.width = cv.offsetWidth * DPR;
    H = cv.height = cv.offsetHeight * DPR;
    cv.style.width = cv.offsetWidth + 'px';
    init();
  }
  function init(){
    const count = Math.min(120, Math.floor(cv.offsetWidth / 13));
    px = Array.from({length: count}, () => ({
      x: Math.random() * W, y: Math.random() * H,
      vx: (Math.random() - .5) * .22 * DPR, vy: (Math.random() - .5) * .22 * DPR,
      s: (Math.random() * 5 + 3) * DPR,
      red: Math.random() < .18,
      phase: Math.random() * 6.28, spd: .008 + Math.random() * .018,
    }));
  }
  let cubeC = null;
  function tick(){
    ctx.clearRect(0, 0, W, H);
    const cube = document.getElementById('hero-cube');
    if (cube){ const cr = cube.getBoundingClientRect(), vr = cv.getBoundingClientRect(); cubeC = { x: (cr.left + cr.width / 2 - vr.left) * DPR, y: (cr.top + cr.height / 2 - vr.top) * DPR }; }
    for (const p of px){
      p.x += p.vx; p.y += p.vy; p.phase += p.spd;
      if (p.x < -20) p.x = W + 20; if (p.x > W + 20) p.x = -20;
      if (p.y < -20) p.y = H + 20; if (p.y > H + 20) p.y = -20;
      const dx = mouse.x * DPR - p.x, dy = mouse.y * DPR - p.y;
      const d = Math.hypot(dx, dy);
      if (d < 180 * DPR && d > 1){ p.x -= dx / d * 1.1; p.y -= dy / d * 1.1; }
      if (cubeC){ const pull = .38 + (window.__cubeBuild || 0) * 2.4; const cx = cubeC.x - p.x, cy = cubeC.y - p.y; const cd = Math.hypot(cx, cy) || 1; p.x += cx / cd * pull * DPR; p.y += cy / cd * pull * DPR; if (cd < (30 + (window.__cubeBuild || 0) * 40) * DPR){ p.x = Math.random() * W; p.y = Math.random() * H; } }
      const a = (Math.sin(p.phase) * .5 + .5) * (p.red ? .7 : .42) + .06;
      ctx.fillStyle = p.red ? `rgba(229,57,53,${a})` : `rgba(255,255,255,${a})`;
      const s = p.s;
      ctx.fillRect(Math.round(p.x / s) * s, Math.round(p.y / s) * s, s, s);
    }
    RAF(tick);
  }
  window.addEventListener('resize', resize);
  const hero = document.getElementById('hero');
  hero.addEventListener('mousemove', e => {
    const r = cv.getBoundingClientRect();
    mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
  });
  hero.addEventListener('mouseleave', () => { mouse.x = -9999; mouse.y = -9999; });
  resize();
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) tick();
})();

// ═══ Cubo del hero: explotado al inicio, se arma al hacer scroll, luego cae ═══
(function(){
  const cube = document.getElementById('hero-cube');
  const wrap = document.getElementById('hero-cube-wrap');
  const hero = document.getElementById('hero');
  if (!cube) return;
  const t0 = performance.now();
  const ease = x => 1 - Math.pow(1 - x, 3);
  (function loop(tm){
    const sc = (document.scrollingElement || document.documentElement).scrollTop;
    const p = Math.min(sc / Math.max(hero.offsetHeight - 80, 1), 1);
    const build = ease(Math.min(p / .3, 1));
    const wasDone = cube.classList.contains('done');
    const isDone = build > .985;
    cube.classList.toggle('done', isDone);
    window.__cubeBuild = build;
    if (isDone && !wasDone && !window.__flashLock){
      window.__flashLock = true;
      const fl = document.getElementById('hero-flash');
      if (fl){ fl.classList.remove('on'); void fl.offsetWidth; fl.classList.add('on'); }
      setTimeout(() => { window.__flashLock = false; }, 1200);
    }
    const ex = (1 - build) * 150 + Math.sin((tm - t0) / 900) * (1 - build) * 10;
    const fallP = Math.max(0, (p - .62) / .38);
    const fall = Math.pow(fallP, 2) * 720;
    const rotY = (tm - t0) * .018 + sc * .25;
    cube.style.setProperty('--ex', ex.toFixed(1) + 'px');
    cube.style.transform = `rotateX(${-22 + fallP * 40}deg) rotateY(${rotY}deg) rotateZ(${fallP * 35}deg)`;
    wrap.style.transform = `translateY(${fall}px)`;
    wrap.style.opacity = String(1 - fallP * .6);
    RAF(loop);
  })(t0);
})();

// ═══ Hero parallax + fade ═══
(function(){
  const inner = document.getElementById('hero-inner');
  const hero = document.getElementById('hero');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  let mx = 0, my = 0, scrollShift = 0, scrollFade = 1;
  hero.addEventListener('mousemove', e => {
    const r = hero.getBoundingClientRect();
    mx = ((e.clientY - r.top) / r.height - .5) * -3.5;
    my = ((e.clientX - r.left) / r.width - .5) * 3.5;
    apply();
  });
  hero.addEventListener('mouseleave', () => { mx = 0; my = 0; apply(); });
  window.addEventListener('scroll', () => {
    const sc = (document.scrollingElement || document.documentElement).scrollTop;
    const p = Math.min(sc / innerHeight, 1);
    scrollShift = p * 60;
    scrollFade = 1;
    apply();
  }, { passive: true });
  function apply(){
    inner.style.transform = `translateY(${scrollShift}px) rotateX(${mx}deg) rotateY(${my}deg)`;
    inner.style.opacity = scrollFade;
  }
})();

// ═══ Lluvia de píxeles en el catálogo/cadena ═══
(function(){
  const cv = document.getElementById('catalog-canvas');
  if (!cv) return;
  const ctx = cv.getContext('2d');
  const DPR = Math.min(devicePixelRatio, 2);
  let W, H, cols = [], sz;
  function resize(){
    W = cv.width = cv.offsetWidth * DPR;
    H = cv.height = cv.offsetHeight * DPR;
    cv.style.width = cv.offsetWidth + 'px';
    sz = 11 * DPR;
    cols = Array.from({length: Math.ceil(W / sz)}, () => ({ y: Math.random() * H, spd: (.35 + Math.random() * 1.1) * DPR, on: Math.random() < .55 }));
  }
  function tick(){
    ctx.fillStyle = 'rgba(11,11,13,.16)';
    ctx.fillRect(0, 0, W, H);
    cols.forEach((c, i) => {
      if (!c.on){ if (Math.random() < .002) c.on = true; return; }
      c.y += c.spd;
      if (c.y > H + 60){ c.y = -40; c.on = Math.random() < .8; }
      const red = Math.random() < .14;
      ctx.fillStyle = red ? 'rgba(229,57,53,.8)' : 'rgba(255,253,249,.22)';
      ctx.fillRect(i * sz, Math.round(c.y / sz) * sz, sz - DPR, sz - DPR);
    });
    RAF(tick);
  }
  window.addEventListener('resize', resize);
  resize();
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) tick();
})();

