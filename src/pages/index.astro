  </div>
  <div class="waw-foot" data-i18n="waw_foot" set:html={es('waw_foot')}></div>
</div>

<!-- HERO -->
<main>
<CuboHero waHref={WA_HERO_SSR} />

<div id="marquee"><div class="marquee-track" id="mq-track"></div></div>

<!-- QUÉ HACEMOS: cuatro paneles que se apilan al bajar -->
<section id="hacemos" aria-label="Qué hacemos">
  {SERVICIOS.map((x) => (
    <article class="sv-p">
      <div class="sv-in">
        <div class="sv-text">
          <p class="sv-k" data-i18n="sv_k" set:html={es('sv_k')}></p>
          <h2 class="sv-h" data-i18n={x.k + '_h'} set:html={es(x.k + '_h')}></h2>
          <p class="sv-d" data-i18n={x.k + '_d'} set:html={es(x.k + '_d')}></p>
          <a class="sv-go" href={x.href}><span data-i18n="sv_go" set:html={es('sv_go')}></span> →</a>
        </div>
        <div class="sv-media">
          {x.video
            ? <video data-src={'/videos/productos/' + x.video + '.mp4'} data-poster={'/images/productos/' + x.video + '.webp'} muted loop playsinline preload="none" aria-hidden="true"></video>
            : <img src={x.img.replace('.webp', '-800.webp')} srcset={x.img.replace('.webp', '-800.webp') + ' 800w, ' + x.img + ' 1600w'} sizes="(max-width:860px) 100vw, 50vw" alt={x.alt} width="1600" height="1600" loading="lazy" decoding="async" fetchpriority="low" />}
          <span class="sv-cap" data-i18n={x.k + '_c'} set:html={es(x.k + '_c')}></span>
        </div>
      </div>
    </article>
  ))}
</section>

<!-- TU NEGOCIO: el visitante escribe su nombre y se ve en los cuatro productos -->
