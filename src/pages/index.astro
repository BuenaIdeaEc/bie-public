    <button id="lang-toggle" aria-label="Cambiar idioma / Switch language">EN</button>
    <a href="#contact" class="nav-cta"><span data-i18n="nav_cta" set:html={es('nav_cta')}></span></a>
    <button id="burger" aria-label="Menú" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span><span></span></button>
  </div>
</nav>

<div id="mobile-menu">
  <a href="#work" class="mm-link"><span data-i18n="nav_work" set:html={es('nav_work')}></span><span class="mm-arrow">→</span></a>
  <a href="#catalog" class="mm-link"><span data-i18n="nav_catalog" set:html={es('nav_catalog')}></span><span class="mm-arrow">→</span></a>
  <a href="#top" class="mm-link"><span data-i18n="nav_prod" set:html={es('nav_prod')}></span><span class="mm-arrow">→</span></a>
  <a href="#contact" class="mm-link"><span data-i18n="nav_contact" set:html={es('nav_contact')}></span><span class="mm-arrow">→</span></a>
  <a id="mm-wa" href={WA_MENU_SSR} class="mm-cta" data-i18n="mm_cta" set:html={es('mm_cta')}></a>
</div>

<canvas id="fab-px"></canvas>
<div id="wa-bubble"><span class="wb-px"></span><span id="wa-bubble-text"></span></div>
<button id="wa-fab" aria-label="WhatsApp">
  <span class="wa-float"><span class="wa-cube">
    <span class="wa-face f"><span class="wa-edge"></span></span>
    <span class="wa-face b"><span class="wa-edge"></span></span>
    <span class="wa-face r"><span class="wa-edge"></span></span>
    <span class="wa-face l"><span class="wa-edge"></span></span>
    <span class="wa-face t"></span>
    <span class="wa-face d"></span>
  </span></span>
  <span class="fab-x">×</span>
</button>

<div id="wa-widget">
  <div class="waw-head">
    <div class="waw-avatar">B</div>
    <div class="waw-head-info">
      <div class="waw-name" data-i18n="waw_name" set:html={es('waw_name')}></div>
      <div class="waw-status"><span class="waw-status-dot"></span><span data-i18n="waw_status" set:html={es('waw_status')}></span></div>
    </div>
  </div>
  <div class="waw-body">
    <div class="waw-bubble" data-i18n="waw_bubble" set:html={es('waw_bubble')}></div>
    <div class="waw-opts" id="waw-opts"></div>
  </div>
  <div class="waw-foot" data-i18n="waw_foot" set:html={es('waw_foot')}></div>
</div>

<!-- HERO -->
<main>
<CuboHero waHref={WA_HERO_SSR} />

<div id="marquee"><div class="marquee-track" id="mq-track"></div></div>

<!-- WORK -->
