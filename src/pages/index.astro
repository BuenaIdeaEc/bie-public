  <div class="section-inner ty-foot">
    <a class="btn-primary" id="ty-wa" href={'https://wa.me/' + WA_NUM_SSR} target="_blank" rel="noopener"><span data-i18n="ty_btn" set:html={es('ty_btn')}></span> <span id="ty-wa-n">mi negocio</span></a>
    <p class="ty-note" data-i18n="ty_note" set:html={es('ty_note')}></p>
