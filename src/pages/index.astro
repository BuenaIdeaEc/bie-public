.form-note{font-family:var(--mono);font-size:10px;color:var(--text3);text-align:center;letter-spacing:.05em}
.form-privacy{margin-top:8px;text-transform:none}
.form-privacy a{color:var(--text2);border-bottom:1px solid var(--border)}
