.field input,.field select,.field textarea{border:1px solid rgba(8,8,8,.16);padding:14px 16px;font-size:14px;background:var(--surface);
  transition:border-color .2s,background .2s,box-shadow .2s;outline:none;color:var(--text);appearance:none;border-radius:var(--r-sm)}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--accent);background:var(--bg);box-shadow:0 0 0 3px var(--accent-glow)}
.field textarea{resize:vertical;min-height:88px}
.form-submit{margin-top:6px;padding:16px;background:transparent;color:var(--bone);font-size:13px;font-weight:400;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--bone);position:relative;overflow:hidden;border-radius:0;
  transition:transform .3s var(--ease),box-shadow .35s var(--ease)}
.form-submit:hover{transform:translateY(-2px);box-shadow:0 14px 30px -8px rgba(37,211,102,.4)}
