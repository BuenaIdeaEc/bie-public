  .belt-cta{flex-direction:column;align-items:flex-start}
  .work-grid{display:flex !important;overflow-x:auto;scroll-snap-type:x mandatory;gap:14px;margin-top:40px;padding-bottom:16px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  .work-grid::-webkit-scrollbar{display:none}
  .work-grid>*{flex:0 0 86%;min-width:0;scroll-snap-align:center}
  .g-slide>*{max-width:88%;}
  .g-slide .browser{width:88%}
  .dash-row{flex-wrap:nowrap}
  .dash-kpi{min-width:0}
  .g-slide{padding:0 8px}
  .wc-big,.wc-small{grid-column:span 1}
  .cta-band{scroll-snap-align:center}
  .gallery,.wc-small .gallery{height:230px}
  .wc-info{padding:18px 18px 20px}
  .wc-top{flex-direction:column;gap:10px}
  .wc-socials{align-self:flex-start}
  .wc-name{font-size:20px}
  .ba-block{padding:26px 20px}
  .ba-stage{height:220px}
  .cta-band{flex-direction:column;align-items:flex-start;gap:18px;padding:28px 22px}
  .band-text{font-size:clamp(19px,5.6vw,26px)}
  .band-btn{width:100%;text-align:center}
