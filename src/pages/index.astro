    <a class="gx-link" id="gx-link" target="_blank" rel="noopener"></a>
  </div>
</section>

<!-- COMENTARIOS DE CLIENTES (frases solo cuando el cliente las dio; nunca inventadas) -->
<section id="voces">
  <div class="voces-sticky"><div class="section-inner">
    <div class="reveal voces-head" id="voces-head">
      <p class="section-label">Comentarios</p>
      <h2 class="section-h2">Lo que dicen <span class="serif">nuestros clientes.</span></h2>
    </div>
    <div class="voces-grid reveal d2">
      {TESTIMONIOS.map((t, i) => (
        <article class={'voz' + (t.frase ? ' con-frase' : '')}>
          {t.frase && <blockquote class="voz-q">{t.frase}</blockquote>}
          <div class="voz-who">
            <b class="voz-name">{t.persona || t.negocio}</b>
            <span class="voz-biz">{t.persona && t.persona !== t.negocio && (t.url ? <a href={t.url} target="_blank" rel="noopener">{t.negocio}</a> : t.negocio)}{t.persona && t.persona !== t.negocio ? ' · ' : ''}{t.sector}</span>
          </div>
        </article>
      ))}
    </div>
    <div class="gx-bar voces-bar" aria-hidden="true"><i id="voces-bar"></i></div>
  </div></div>
</section>

<!-- ESTE MES EN BIE: destacado mensual (datos en src/data/este-mes.ts) -->
<EsteMes data={ESTE_MES} />

<!-- LOS MÁS PEDIDOS -->
<section id="top">
  <canvas id="top-canvas"></canvas>
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="top_label" set:html={es('top_label')}></p>
      <h2 class="section-h2" data-i18n="top_h2" set:html={es('top_h2')}></h2>
      <p class="section-sub" data-i18n="top_sub" set:html={es('top_sub')}></p>
    </div>
    <div class="packs reveal d1">
      {([['pk1', WA_PK1_SSR, '/images/casos/escuela-heridas/web.webp', false], ['pk2', WA_PK2_SSR, 'whatsapp-business-commerce', true], ['pk3', WA_PK3_SSR, '/images/casos/luway/os.webp', false]] as [string, string, string, boolean][]).map(([k, href, media, vid], i) => (
        <a class={'pack' + (i === 1 ? ' pack-hot' : '')} href={href} target="_blank" rel="noopener">
          <span class="pack-media">{vid ? <video data-src={'/videos/productos/' + media + '.mp4'} data-poster={'/images/productos/' + media + '.webp'} muted loop playsinline preload="none" aria-hidden="true"></video> : <img src={media} alt="" width="1600" height="1600" loading="lazy" decoding="async" />}{i === 1 && <span class="pack-tag" data-i18n="pk_tag2" set:html={es('pk_tag2')}></span>}</span>
          <div class="pack-body">
          <span class="pack-k"><span data-i18n="pk_k" set:html={es('pk_k')}></span> 0{i + 1}</span>
          <h3 class="pack-n" data-i18n={k + '_n'} set:html={es(k + '_n')}></h3>
          <p class="pack-d" data-i18n={k + '_d'} set:html={es(k + '_d')}></p>
          <ul class="pack-l">{(UI_STATIC[k + '_l'] as any).es.map((x: string, j: number) => <li data-i18n-list={k + '_l'} data-j={j}>{x}</li>)}</ul>
          <span class="pack-p"><span data-i18n="pk_from" set:html={es('pk_from')}></span> <b data-i18n={k + '_p'} set:html={es(k + '_p')}></b><em data-i18n="pk_note" set:html={es('pk_note')}></em></span>
          <span class="pack-go"><span data-i18n="pk_go" set:html={es('pk_go')}></span> →</span>
          </div>
        </a>
      ))}
    </div>
    <a class="pc-one" href="#productos" data-i18n="pc_one" set:html={es('pc_one')}></a>
  </div>
</section>

<!-- CATALOG -->
<section id="catalog">
  <canvas id="catalog-canvas"></canvas>
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="cat_label" set:html={es('cat_label')}></p>
      <h2 class="section-h2" data-i18n="cat_h2" set:html={es('cat_h2')}></h2>
