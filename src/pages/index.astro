/* === Letra (2026-11-01): Figtree, más ancha; espaciado normal; títulos en peso medio === */
html body,html body button,html body input,html body select,html body textarea{font-family:var(--font)}
html body .section-h2,html body .kin-h2,html body .cubo-h,html body #hero.cubo h1.cubo-h,html body .est-left .section-h2,html body .gx-names button,html body .pack-n,html body .pack-p b,html body .est-price b,html body .qz-name,html body .nicho-num,html body .top-more summary,html body .qz-opt,html body .qz-opt:hover,html body .qz-opt.on,html body .kin-step h3,html body .nicho-line{font-weight:500;letter-spacing:-.022em}
html body .section-h2,html body .kin-h2{font-size:clamp(36px,5.2vw,80px);line-height:1.02;max-width:18ch}
html body .est-left .section-h2{font-size:clamp(34px,4.4vw,66px)}
html body .cubo-h{font-size:clamp(33px,3.8vw,58px);line-height:1.04}
html body #hero.cubo h1.cubo-h{font-size:clamp(31px,3.5vw,52px);line-height:1.06;max-width:18ch}
html body .nicho-num{letter-spacing:-.04em}
html body .nicho-line{font-size:clamp(24px,3vw,44px);line-height:1.1}
html body .voz-q{letter-spacing:-.018em}
html body .gx-names button{font-size:clamp(26px,3vw,44px);line-height:1.12}
html body .pack-n{font-size:clamp(28px,2.1vw,32px)}
html body .pack-p b{font-size:clamp(28px,2.4vw,36px)}
html body .qz-opt,html body .qz-opt:hover,html body .qz-opt.on{font-size:clamp(21px,2.5vw,36px);line-height:1.15}
html body .kin-step h3{font-size:clamp(22px,2.9vw,40px)}
html body .ml-line{letter-spacing:-.02em}
html body .btn-primary,html body .form-submit,html body .sim-cta,html body .nav-cta{font-weight:500;letter-spacing:0}
html body .sb-in b{letter-spacing:0}
@media (min-width:861px){html body #hero.cubo h1.cubo-h{max-width:13ch}}
/* comentarios: uno a la vez */
html body #voces{height:236vh;padding:0;overflow:visible;position:relative}
.voces-sticky{position:sticky;top:0;height:100vh;height:100dvh;display:flex;align-items:center;overflow:hidden}
.voces-sticky .section-inner{width:100%}
html body #voces .section-h2{font-size:clamp(26px,3vw,44px);max-width:none}
html body #voces .section-h2 .serif{color:var(--text3)}
html body #voces .voces-grid{display:grid;margin-top:clamp(26px,4vh,48px)}
html body #voces .voz,html body #voces .voz.con-frase{grid-area:1/1;display:flex;flex-direction:column;gap:18px;padding:0;border:0;opacity:0;transform:translateY(26px);transition:opacity .5s ease,transform .7s var(--ease);pointer-events:none}
html body #voces .voz.on{opacity:1;transform:none;pointer-events:auto}
html body #voces .voz-q{font-size:clamp(25px,3.3vw,48px);line-height:1.18;max-width:30ch;font-weight:500}
html body #voces .voz-who{order:0}
.voces-bar{margin-top:clamp(24px,4vh,44px)}
@media (max-width:860px){
  html body .section-h2,html body .kin-h2{font-size:clamp(33px,9.2vw,44px)}
  html body .cubo-h{font-size:clamp(31px,8.6vw,40px)}
  html body #hero.cubo h1.cubo-h{font-size:clamp(29px,8vw,36px);max-width:none}
  html body #voces .section-h2{font-size:26px}
  html body #voces .voz-q{font-size:clamp(23px,6.2vw,28px);line-height:1.22}
  html body .gx-names button{font-size:22px}
  html body #voces{height:250vh}
}
@media (prefers-reduced-motion: reduce){
  html body #voces{height:auto;padding:80px 0}
  .voces-sticky{position:static;height:auto;display:block}
  html body #voces .voz,html body #voces .voz.con-frase{grid-area:auto;opacity:1;transform:none;margin-bottom:34px}
  .voces-bar{display:none}
}
/* === Golpe final (2026-11-01): paneles a pantalla completa y fondo vivo; el vidrio se ve porque ahora hay algo detrás === */
#campo{position:fixed;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none}
html body{background:transparent}
html body #work,html body #top,html body #simple.kin,html body #estrella,html body #catalog,html body #voces,html body #contact,html body footer,html body #nicho{background:transparent}
html body .gx-info,html body .section-sub{position:relative}
html body .est-right,html body .qz-answer{background:rgba(255,255,255,.55);-webkit-backdrop-filter:blur(20px) saturate(1.3);backdrop-filter:blur(20px) saturate(1.3);border:1px solid rgba(8,8,8,.07)}
html body .pack-body{background:rgba(255,255,255,.62);-webkit-backdrop-filter:blur(20px) saturate(1.3);backdrop-filter:blur(20px) saturate(1.3)}
html body .top-tile.has-img{background:rgba(255,255,255,.7)}
/* Qué hacemos */
#hacemos{position:relative;z-index:1}
.sv-p{--in:1;--out:0;position:sticky;top:0;height:100vh;height:100dvh;background:#fff;overflow:hidden}
.sv-p.entering{box-shadow:0 -34px 60px -44px rgba(8,8,8,.4)}
.sv-in{height:100%;display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);transform:scale(calc(1 - var(--out) * .05));transform-origin:50% 30%;opacity:calc(1 - var(--out) * .35);will-change:transform}
.sv-text{display:flex;flex-direction:column;justify-content:flex-end;align-items:flex-start;gap:14px;padding:clamp(84px,12vh,120px) clamp(24px,4vw,64px) clamp(36px,7vh,72px) clamp(24px,6vw,80px)}
.sv-text>*{opacity:calc(var(--in) * 1.5 - .5);transform:translateY(calc((1 - var(--in)) * 46px))}
.sv-k{margin:0 0 auto;font-size:16px;color:var(--text3)}
.sv-h{margin:0;font-size:clamp(46px,6.6vw,104px);font-weight:500;letter-spacing:-.03em;line-height:1}
.sv-d{margin:0;font-size:clamp(18px,1.6vw,23px);line-height:1.32;color:var(--text2);max-width:30ch}
.sv-go{margin-top:8px;font-size:17px;color:var(--text);border-bottom:1px solid currentColor;padding-bottom:3px;transition:color .25s}
.sv-go:hover{color:var(--cta)}
.sv-media{position:relative;overflow:hidden;background:#111}
.sv-media img,.sv-media video{display:block;width:100%;height:100%;object-fit:cover;transform:scale(calc(1.14 - var(--in) * .14));will-change:transform}
.sv-cap{position:absolute;left:14px;bottom:14px;padding:9px 13px;font-size:14px;color:var(--text);background:rgba(255,255,255,.72);-webkit-backdrop-filter:blur(16px) saturate(1.4);backdrop-filter:blur(16px) saturate(1.4)}
@media (max-width:860px){
  .sv-in{display:flex;flex-direction:column}
  .sv-media{order:-1;flex:none;width:100%;aspect-ratio:1;max-height:56dvh}
  .sv-text{flex:1;justify-content:flex-end;padding:18px 22px 30px;gap:10px;min-height:0}
  .sv-k{margin:0 0 auto;font-size:15px}
  .sv-h{font-size:clamp(44px,12.4vw,58px)}
  .sv-d{font-size:18px;max-width:30ch}
  /* en teléfono el desenfoque sobre un fondo en movimiento pesa: blanco casi sólido */
  html body .pack-body,html body .est-right,html body .qz-answer{-webkit-backdrop-filter:none;backdrop-filter:none;background:rgba(255,255,255,.93)}
}
@media (prefers-reduced-motion: reduce){.sv-p{position:relative;height:auto}.sv-in{transform:none;opacity:1}.sv-text>*{opacity:1;transform:none}.sv-media img,.sv-media video{transform:none}}
/* === Ronda 5 (2026-11-01): alto estable, mundo rojo, cubo que se abre hacia el primer panel === */
#lvh{position:fixed;top:0;left:0;width:0;height:100vh;height:100lvh;visibility:hidden;pointer-events:none}
#campo{height:100vh;height:100lvh}
.cubo-sticky,.sv-p,.kin-sticky,.voces-sticky,html body .nicho-sticky{height:100vh;height:100lvh}
/* lo que va abajo no queda detrás de la barra del navegador */
html body .cubo-copy{bottom:calc(11vh + 100lvh - 100svh)}
.sv-text{padding-bottom:calc(clamp(36px,7vh,72px) + 100lvh - 100svh)}
/* el primer panel vive dentro del cubo hasta que termina de abrirse */
#hacemos{margin-top:-100vh;margin-top:-100lvh}
.sv-p:first-child{visibility:hidden}
body.past-cube .sv-p:first-child{visibility:visible}
html body .cubo-line[data-i="0"] .cubo-h{max-width:21ch}
/* mundo rojo */
html body #nicho{background:transparent}
html body .nicho-sticky{background:none;color:var(--text);overflow:hidden}
.nx-red{position:absolute;inset:0;background:#E53935;overflow:hidden;clip-path:inset(50%)}
.nx-tunnel{position:absolute;left:50%;top:50%;width:0;height:0;display:none}
.nx-tunnel i{position:absolute;left:0;top:0;width:100vmax;height:100vmax;margin:-50vmax 0 0 -50vmax;border:2px solid rgba(8,8,8,.18);background:rgba(90,0,0,.045);will-change:transform,opacity}
.nx-on .nx-tunnel{display:block}
html body .nicho-inner{position:relative;z-index:2;opacity:0;will-change:transform}
html body .nicho-num{transform-origin:0 62%;will-change:transform,opacity}
html body .nicho-bar{z-index:3;opacity:0}
body.in-nicho #nav{opacity:0;transform:translateY(-10px);pointer-events:none}
/* comentarios: el título aparece una sola vez */
.voces-head{max-height:220px;overflow:hidden;transition:max-height .65s var(--ease),opacity .3s ease,margin .65s var(--ease)}
.voces-head.out{max-height:0;opacity:0!important;margin:0}
html body .voces-head.out + .voces-grid{margin-top:0}
html body #voces .voces-grid{transition:margin .65s var(--ease)}
@media (max-width:860px){
  html body .cubo-copy{bottom:calc(32px + 100lvh - 100svh)}
  .sv-text{padding-bottom:calc(30px + 100lvh - 100svh)}
  html body .cubo-line[data-i="0"] .cubo-h{font-size:clamp(29px,7.8vw,36px);max-width:none}
}
@media (prefers-reduced-motion: reduce){
  #hacemos{margin-top:0}
  .sv-p:first-child{visibility:visible}
  .nx-red{clip-path:none}
  .nx-tunnel{display:none}
  html body .nicho-inner,html body .nicho-bar{opacity:1}
}
/* === Catálogo (2026-11-01): 47 productos a la vista y categorías que se despliegan === */
html body #productos{position:relative;padding:clamp(80px,11vw,170px) 0 clamp(50px,7vw,110px);overflow:hidden}
.pc-rows{margin-top:clamp(34px,5vw,70px);display:flex;flex-direction:column;gap:clamp(4px,.8vw,12px)}
.pc-row{overflow:hidden}
.pc-track{display:flex;width:max-content;will-change:transform}
.pc-track a{flex:none;padding-right:.9em;font-size:clamp(30px,4.6vw,70px);font-weight:500;letter-spacing:-.025em;line-height:1.14;color:var(--text);white-space:nowrap;transition:color .25s}
.pc-row:nth-child(2) .pc-track a{color:rgba(8,8,8,.32)}
.pc-track a:hover{color:var(--cta)!important}
.pc-cats{margin-top:clamp(36px,5vw,70px);border-bottom:1px solid var(--border)}
.pc-cat{border-top:1px solid var(--border)}
.pc-cat summary{list-style:none;display:flex;align-items:center;gap:12px;padding:19px 0;font-size:clamp(20px,2.2vw,30px);font-weight:500;letter-spacing:-.02em;line-height:1.15;cursor:pointer;transition:color .2s}
.pc-cat summary::-webkit-details-marker{display:none}
.pc-cat summary:hover{color:var(--cta)}
.pc-cat summary small{font-size:15px;font-weight:400;letter-spacing:0;color:var(--text3);margin-right:auto}
.pc-cat[open] .tm-x::after{transform:none}
.pc-cat ul{list-style:none;margin:0;padding:0 0 18px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 clamp(24px,4vw,60px)}
.pc-cat li a{display:grid;grid-template-columns:minmax(0,1fr) 20px;column-gap:12px;padding:13px 0;border-top:1px solid rgba(8,8,8,.07);color:var(--text)}
.pc-cat li b{font-weight:500;font-size:17px;letter-spacing:-.01em}
.pc-cat li span{grid-column:1;font-size:14.5px;line-height:1.35;color:var(--text2);margin-top:3px}
.pc-cat li em{grid-column:2;grid-row:1 / span 2;align-self:center;font-style:normal;color:var(--text3);transition:transform .3s var(--ease),color .2s}
.pc-cat li a:hover b,.pc-cat li a:hover em{color:var(--cta)}
.pc-cat li a:hover em{transform:translateX(4px)}
html body .pc-all{margin-top:30px}
html body .pc-all span::before{display:none}
.pc-one{display:inline-block;margin-top:clamp(28px,4vw,48px);font-size:17px;color:var(--text);border-bottom:1px solid currentColor;padding-bottom:3px}
.pc-one:hover{color:var(--cta)}
@media (max-width:860px){
  .pc-track a{font-size:clamp(28px,8vw,36px)}
  .pc-cat ul{grid-template-columns:minmax(0,1fr)}
  html body .pc-all{display:block;text-align:center}
}
@media (prefers-reduced-motion: reduce){.pc-row{overflow-x:auto}}
/* === Rueda de productos (2026-11-01): uno por uno, a pantalla completa === */
html body #productos{padding-bottom:0;overflow:visible}
.px{position:relative;margin-top:clamp(20px,3vw,40px)}
.px-sticky{position:sticky;top:0;height:100vh;height:100lvh;display:flex;flex-direction:column;overflow:hidden;padding:clamp(76px,10vh,92px) 0 calc(clamp(20px,4vh,40px) + 100lvh - 100svh)}
.px-chips{flex:none;display:flex;gap:6px 22px;padding:0 clamp(22px,6vw,80px);overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none}
.px-chips::-webkit-scrollbar{display:none}
.px-chips button{flex:none;background:none;border:0;padding:4px 0;font:inherit;font-size:15px;color:var(--text3);border-bottom:1.5px solid transparent;white-space:nowrap;transition:color .25s,border-color .25s}
.px-chips button:hover{color:var(--text)}
.px-chips button.on{color:var(--text);border-color:var(--accent)}
.px-main{flex:1;min-height:0;display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,1fr);gap:clamp(20px,4vw,70px);align-items:center;padding:0 clamp(22px,6vw,80px)}
.px-wheel{position:relative;list-style:none;margin:0;padding:0;height:100%;-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 24%,#000 76%,transparent 100%);mask-image:linear-gradient(180deg,transparent 0,#000 24%,#000 76%,transparent 100%)}
.px-wheel li{position:absolute;left:0;right:0;top:50%;padding:.08em 0;transform-origin:0 50%;will-change:transform,opacity}
.px-wheel a{display:block;font-size:clamp(40px,5vw,80px);font-weight:500;letter-spacing:-.03em;line-height:1.02;color:var(--text);text-wrap:balance}
.px-wheel li.on a:hover{color:var(--cta)}
.px-card{display:flex;flex-direction:column;gap:14px;align-self:center;padding:clamp(20px,2.4vw,32px);background:rgba(255,255,255,.55);-webkit-backdrop-filter:blur(20px) saturate(1.3);backdrop-filter:blur(20px) saturate(1.3);border:1px solid rgba(8,8,8,.08)}
.px-map{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;width:min(100%,196px)}
.px-map button{aspect-ratio:1;padding:0;border:0;background:rgba(8,8,8,.09);transition:background .2s,transform .25s var(--ease)}
.px-map button.past{background:rgba(8,8,8,.32)}
.px-map button.on{background:var(--accent);transform:scale(1.25)}
.px-count{margin:4px 0 0;font-size:15px;color:var(--text3);display:flex;flex-wrap:wrap;gap:2px 6px;align-items:baseline}
.px-count b{font-size:24px;font-weight:500;letter-spacing:-.02em;color:var(--text);font-variant-numeric:tabular-nums}
.px-count span{flex-basis:100%;color:var(--text2)}
.px-desc{margin:0;font-size:clamp(17px,1.5vw,21px);line-height:1.32;color:var(--text);min-height:4em}
.px-ctas{display:flex;flex-wrap:wrap;align-items:center;gap:10px 20px;margin-top:4px}
.px-see{font-size:16px;color:var(--text);border-bottom:1px solid currentColor;padding-bottom:2px}
.px-see:hover{color:var(--cta)}
html body .px-ctas .btn-primary span::before{display:none}
.px-after{margin-top:clamp(10px,2vw,24px);padding-bottom:clamp(50px,7vw,110px)}
.px.still .px-sticky{position:static;height:auto;overflow:visible}
.px.still .px-wheel{height:auto;-webkit-mask-image:none;mask-image:none}
.px.still .px-wheel li{position:static}
.px.still .px-card{display:none}
@media (max-width:860px){
  .px-sticky{padding-top:18px;padding-bottom:calc(18px + 100lvh - 100svh)}
  .px-chips{padding:0 20px;gap:4px 18px}
  .px-main{display:flex;flex-direction:column;align-items:stretch;gap:10px;padding:0 20px;min-height:0}
  .px-wheel{flex:1;min-height:0;height:auto}
  .px-wheel a{font-size:clamp(36px,10.4vw,46px)}
  .px-card{flex:none;background:rgba(255,255,255,.9);-webkit-backdrop-filter:none;backdrop-filter:none;padding:16px;gap:10px}
  .px-map{display:none}
  .px-count{margin:0}
  .px-count span{flex-basis:auto;margin-left:auto}
  .px-desc{font-size:16px;min-height:4em}
  html body .px-ctas .btn-primary{padding:15px 18px;flex:1;width:auto;text-align:center}
  body.in-px #wa-fab{opacity:0;pointer-events:none}
}

/* ═══ Tu negocio: el nombre del visitante en los cuatro productos ═══ */
#tuyo{position:relative;z-index:1;padding:clamp(80px,11vw,170px) 0 clamp(60px,8vw,120px);overflow:hidden;scroll-margin-top:0}
html body .ty-q{display:block;margin:0;cursor:text}
.ty-in{display:block;width:100%;margin:clamp(14px,2vw,26px) 0 0;padding:0 0 10px;border:0;border-bottom:1px solid var(--text);border-radius:0;background:transparent;outline:0;font-family:var(--font);font-size:clamp(30px,5vw,68px);font-weight:400;letter-spacing:-.035em;line-height:1.1;color:var(--accent);caret-color:var(--accent);scroll-margin-top:28px;-webkit-appearance:none;appearance:none}
.ty-in::placeholder{color:#8a8a87;opacity:1}
.ty-in:focus{border-bottom-width:2px;padding-bottom:9px}
.ty-sub{margin:14px 0 0;font-size:clamp(16px,1.4vw,20px);color:var(--text2)}
.ty-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;width:min(100%,1500px);margin:clamp(26px,3.4vw,50px) auto 0;padding:0 clamp(22px,6vw,80px)}
.ty-c{min-width:0}
.ty-s{height:clamp(280px,25vw,360px);border:1px solid rgba(8,8,8,.14);background:#fff;overflow:hidden;display:flex;flex-direction:column;--ty-f:24px}
.ty-t{margin:14px 0 0;font-size:17px;font-weight:500;letter-spacing:-.015em;color:var(--text)}
.ty-d{margin:3px 0 0;font-size:15px;line-height:1.35;color:var(--text2)}
.ty-foot{display:flex;align-items:center;flex-wrap:wrap;gap:16px clamp(20px,3vw,44px);margin-top:clamp(26px,3vw,44px)}
.ty-note{flex:1 1 320px;max-width:62ch;margin:0;font-size:13.5px;line-height:1.4;color:var(--text3)}
#ty-wa-n{font-weight:600}
.ty-marca b{flex:1;display:flex;align-items:center;padding:0 16px;min-height:0;overflow:hidden;font-size:var(--ty-f);line-height:1.04;overflow-wrap:anywhere}
.ty-m1{background:#fff;color:#080808;font-weight:600;letter-spacing:-.04em}
.ty-m2{background:#080808;color:#fff;font-weight:400;letter-spacing:.05em;text-transform:uppercase;font-size:calc(var(--ty-f) * .74)!important}
.ty-m3{background:#E53935;color:#fff;font-weight:500;letter-spacing:-.02em;text-transform:lowercase}
.ty-web{padding:16px;gap:14px}
.ty-bus{margin:0;padding:9px 12px;border:1px solid rgba(8,8,8,.2);font-size:14px;color:var(--text);text-transform:lowercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ty-res small{display:block;font-size:12px;color:var(--text3)}
.ty-res b{display:block;margin-top:3px;font-size:17px;font-weight:500;line-height:1.16;letter-spacing:-.015em;color:var(--text);overflow-wrap:anywhere}
.ty-res p{margin:5px 0 0;font-size:13.5px;line-height:1.3;color:var(--text2)}
.ty-web i{display:block;flex:0 0 11px;background:#f1f1ef}
.ty-web i:nth-of-type(even){width:68%}
.ty-chat{background:#f6f6f4;font-size:14px;line-height:1.3}
.ty-chat header,.ty-sis header{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:13px 16px;background:#fff;border-bottom:1px solid rgba(8,8,8,.1)}
.ty-chat header b,.ty-sis header b{min-width:0;font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text)}
.ty-chat header small,.ty-sis header small{flex:none;font-size:12px;color:var(--text3)}
.ty-chat p{margin:12px 16px 0;padding:9px 11px;max-width:82%;overflow-wrap:anywhere;color:var(--text)}
.ty-in-m{margin-top:auto!important;align-self:flex-start;background:#fff;border:1px solid rgba(8,8,8,.1)}
.ty-chat .ty-out-m{align-self:flex-end;background:#080808;color:#fff}
.ty-out-m b{font-weight:600}
.ty-chat .ty-out-m{margin-bottom:14px}
.ty-chat time{display:block;margin-top:3px;font-size:10.5px;opacity:.6;text-align:right}
.ty-sis ul{list-style:none;margin:0;padding:0 16px;flex:1;display:flex;flex-direction:column}
.ty-sis li{flex:1;display:flex;align-items:center;justify-content:space-between;gap:10px;border-bottom:1px solid rgba(8,8,8,.08);font-size:15px;color:var(--text)}
.ty-sis li:last-child{border-bottom:0}
.ty-sis em{font-style:normal;font-size:13px;color:var(--text3)}
.ty-sis em.rev{color:var(--accent-dark)}
@media (max-width:1040px){
  .ty-row{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:0 22px;scroll-padding:0 22px}
  .ty-row::-webkit-scrollbar{display:none}
  .ty-c{flex:0 0 min(78vw,360px);scroll-snap-align:start}
  .ty-s{height:clamp(240px,34lvh,320px)}
}
@media (max-width:640px){
  #tuyo{padding-top:72px}
  .ty-foot{flex-direction:column;align-items:stretch}
  html body .ty-foot .btn-primary{width:100%;text-align:center}
  .ty-note{flex:none}
}
/* nombres de la galería: legibles aunque no estén elegidos */
html body .gx-names button:not(.on):not(:hover){color:#757573}
html body #tuyo .section-inner{width:min(100%,1500px);max-width:none;margin-inline:auto;padding-inline:clamp(22px,6vw,80px)}
html body #tuyo .ty-foot{margin-top:clamp(26px,3vw,44px)}
@media (min-width:861px){.ty-in{scroll-margin-top:96px}}
@media (min-width:861px){
  html body .ty-q{font-size:clamp(34px,3.4vw,50px);line-height:1.05}
  .ty-in{font-size:clamp(30px,3.4vw,50px)}
  #tuyo{padding-top:clamp(84px,8vw,120px)}
  .ty-s{height:clamp(240px,29vh,320px)}
}
html body.in-contact #wa-fab,html body.in-contact #wa-bubble{opacity:0;pointer-events:none}
</style>


</head>
<body class="cubo-intro">
