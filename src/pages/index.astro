// ═══ Hileras de empresas: avanzan solas; con el scroll, cuando la sección está en pantalla, corren mucho más rápido ═══
(function(){
  const tracks = Array.from(document.querySelectorAll('.reel-track'));
  if (!tracks.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const sec = document.getElementById('work');
  const st = tracks.map((el, i) => ({ el, x: 0, half: 0, dir: -1, k: i ? 0.72 : 1, boost: 0, hover: false }));
  function measure(){ st.forEach((t, i) => { t.half = t.el.scrollWidth / 2; if (i && !t.seeded && t.half) { t.seeded = true; t.x = -t.half * 0.42; } }); }
  window.__reelsMeasure = measure; measure(); addEventListener('resize', measure, { passive: true });
  st.forEach(t => { t.el.parentElement.addEventListener('pointerenter', () => { t.hover = true; }); t.el.parentElement.addEventListener('pointerleave', () => { t.hover = false; }); });
  let lastY = scrollY, lastT = performance.now();
  addEventListener('scroll', () => {
    const r = sec.getBoundingClientRect(); const dy = scrollY - lastY; lastY = scrollY;
    // solo empuja cuando la sección ocupa el centro de la pantalla
    if (r.top < innerHeight * 0.55 && r.bottom > innerHeight * 0.45) st.forEach(t => { t.boost += Math.abs(dy) * 4; });
  }, { passive: true });
  function frame(now){
    requestAnimationFrame(frame);
    const dt = Math.min(0.05, (now - lastT) / 1000); lastT = now;
    for (const t of st){
      if (!t.half) continue;
      const base = t.hover ? 0 : 26;
      t.boost *= Math.pow(0.08, dt);
      const v = (base + Math.min(t.boost, 1400)) * t.k;
      t.x += t.dir * v * dt;
      if (t.x <= -t.half) t.x += t.half; if (t.x > 0) t.x -= t.half;
      t.el.style.transform = 'translate3d(' + t.x.toFixed(2) + 'px,0,0)';
    }
  }
  requestAnimationFrame(frame);
})();

// ═══ "Así de simple": tipografía en movimiento dirigida por el scroll ═══
(function(){
  const sec = document.getElementById('simple'), h2 = document.getElementById('kin-h2');
  const steps = Array.from(document.querySelectorAll('.kin-step')), cta = document.getElementById('kin-cta');
  if (!sec || !h2) return;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let words = [];
  function split(){
    // envuelve cada palabra en un span, conservando <br> y los spans de estilo
    const walk = node => {
      Array.from(node.childNodes).forEach(n => {
        if (n.nodeType === 3){
          const parts = n.textContent.split(/(\s+)/);
          const frag = document.createDocumentFragment();
          parts.forEach(pt => {
            if (!pt) return;
            if (/^\s+$/.test(pt)) frag.appendChild(document.createTextNode(pt));
            else { const w = document.createElement('span'); w.className = 'kin-w'; w.textContent = pt; frag.appendChild(w); }
          });
          n.replaceWith(frag);
        } else if (n.nodeType === 1 && n.tagName !== 'BR' && !n.classList.contains('kin-w')) walk(n);
      });
    };
    if (!h2.querySelector('.kin-w')) walk(h2);
    words = Array.from(h2.querySelectorAll('.kin-w'));
  }
  window.__kinSplit = split; split();
  if (reduce) { words.forEach(w => w.classList.add('on')); steps.forEach(st => st.classList.add('on')); cta.classList.add('on'); return; }
  let last = -1;
  function frame(){
    requestAnimationFrame(frame);
    const r = sec.getBoundingClientRect(), span = sec.offsetHeight - innerHeight;
    if (r.bottom < 0 || r.top > innerHeight || span <= 0) return;
    const p = Math.min(1, Math.max(0, -r.top / span));
    const key = Math.round(p * 400);
    if (key === last) return; last = key;
    // 0-0.28 titular palabra a palabra · 0.3-0.84 los pasos · 0.86+ botón
    words.forEach((w, i) => w.classList.toggle('on', p > 0.03 + (i / Math.max(1, words.length)) * 0.25));
    const sp = (p - 0.30) / 0.54, n = steps.length;
    steps.forEach((st, i) => {
      const a = i / n, b = (i + 1) / n;
      st.classList.toggle('on', sp >= a && sp < b);
      st.classList.toggle('seen', sp >= b);
    });
    cta.classList.toggle('on', p > 0.86);
  }
  requestAnimationFrame(frame);
})();

