import EsteMes from '../components/ui/EsteMes.astro';
import { ESTE_MES } from '../data/este-mes';
import CuboHero from '../components/interactive/CuboHero.astro';
import homeJs from '../scripts/home.js?url';
import { TASTING_ALT } from '../data/tasting-alt';
import { TESTIMONIOS, REDES } from '../data/testimonios';
const UI_STATIC = Object.fromEntries(Object.entries(UI).filter(([, v]) => typeof v.es !== 'function'));
const es = (k: string) => UI[k].es as string;
// Destinos de WhatsApp renderizados en servidor (H04 de la auditoría 2026-09-11: sin esto,
// con JS bloqueado estos botones eran href="#" — el cliente los reescribe igual al cargar,
// con el idioma y el origen de trazabilidad correctos, esto es solo el respaldo sin JS.
const WA_NUM_SSR = '593988253030';
const waSSR = (msg: string) => `https://wa.me/${WA_NUM_SSR}?text=${encodeURIComponent(msg)}`;
const WA_HERO_SSR = waSSR('Hola, tengo un negocio. Vendo: \n\n— Origen: web/home/hero/es');
const WA_MENU_SSR = waSSR('Hola, quiero cotizar un producto de BIE. ¿Qué me recomiendan para mi negocio?\n\n— Origen: web/home/menu/es');
const WA_START_SSR = waSSR('Hola, no sé por dónde empezar. Les cuento mi negocio: \n\n— Origen: web/home/empezar/es');
const WA_PK1_SSR = waSSR('Hola, me interesa la ruta "Que te encuentren" (página web, Google Maps, marca). Mi negocio es: \n\n— Origen: web/home/ruta-1/es');
const WA_PK2_SSR = waSSR('Hola, me interesa la ruta "Que te compren" (WhatsApp Business, asistente 24/7, redes). Mi negocio es: \n\n— Origen: web/home/ruta-2/es');
const WA_PK3_SSR = waSSR('Hola, me interesa la ruta "Que funcione solo" (automatizaciones, CRM, sistema). Mi negocio es: \n\n— Origen: web/home/ruta-3/es');
const WA_EST_SSR = waSSR('Hola, quiero el acompañamiento mensual de BIE. Mi negocio es: \n\n— Origen: web/home/acompanamiento/es');
const WA_SIM_SSR = waSSR('Hola, quiero empezar. Les cuento mi negocio para saber qué necesito.\n\n— Origen: web/home/asi-de-simple/es');
// Qué hacemos: trabajo real de clientes; el video de WhatsApp es una escena generada y se rotula como tal
const SERVICIOS: { k: string, href: string, img?: string, video?: string, alt: string }[] = [
  { k: 'sv1', href: '/productos/identidad-de-marca/?src=home-que-hacemos', img: '/images/casos/tasting/branding.webp', alt: 'Marca de Tasting Ecuador: logo, colores y aplicaciones' },
  { k: 'sv2', href: '/productos/pagina-web/?src=home-que-hacemos', img: '/images/casos/escuela-heridas/web.webp', alt: 'Página web de la Escuela de Heridas Guayaquil' },
  { k: 'sv3', href: '/productos/asistente-inteligente-whatsapp/?src=home-que-hacemos', video: 'asistente-inteligente-whatsapp', alt: '' },
  { k: 'sv4', href: '/productos/sistema-operativo/?src=home-que-hacemos', img: '/images/casos/luway/os.webp', alt: 'Sistema de Luway con ventas, inventario y métricas' },
];
// Catálogo en el inicio: los mismos 47 productos de /catalogo/, con nombres de categoría en lenguaje simple
const CATS: Record<string, { es: string; en: string }> = {
  '01': { es: 'Entender tu mercado', en: 'Understand your market' },
  '02': { es: 'Ordenar tu empresa', en: 'Organize your company' },
  '03': { es: 'Marca, contenido y sonido', en: 'Brand, content and sound' },
  '04': { es: 'Aparecer en internet', en: 'Show up online' },
  '05': { es: 'Automatizar con inteligencia artificial', en: 'Automate with AI' },
  '06': { es: 'Conseguir más clientes', en: 'Get more customers' },
  '07': { es: 'Papeles, impuestos y personal', en: 'Paperwork, taxes and staff' },
  '08': { es: 'Capacitar a tu equipo', en: 'Train your team' },
};
const pHref = (slug?: string) => '/productos/' + slug + '/?src=home-catalogo';
// orden de la rueda: primero lo que más se busca; dentro de cada categoría, en su orden del catálogo
const PX_ORDER = ['04', '03', '05', '06', '07', '01', '02', '08'];
const PX_START: Record<string, string> = { '04': 'pagina-web' };
const PX_CATS = PX_ORDER.map((num) => {
  const p = PHASES.find((x) => x.num === num)!;
  const k = Math.max(0, p.products.findIndex((x) => x.slug === PX_START[num]));
  return { num, products: [...p.products.slice(k), ...p.products.slice(0, k)] };
});
const PX_ITEMS = PX_CATS.flatMap((c) => c.products.map((x) => ({ ...x, cat: c.num })));
const WA_DIAG_SSR = waSSR('Hola, quiero un diagnóstico gratuito para mi empresa.\n\n— Origen: web/home/catalogo/es');
const WA_COMM_SSR = waSSR('Hola, quiero unirme a la comunidad de BIE.\n\n— Origen: web/home/comunidad/es');
// BIE-P06 — Home (v37b: copy honesto en feed_sub, sin prometer sincronizacion automatica que no existe).
