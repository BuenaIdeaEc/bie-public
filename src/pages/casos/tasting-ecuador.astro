---
// BIE — Primer caso de estudio real, autorizado por la clienta (Fase 2 del plan
// de contenido/SEO, 2026-09-12). Hechos confirmados por EGO (2026-10-03): empezó con meal prep, negocio
// estable pero sin crecer (no es historia de "cero"); BIE lo convirtió en un sistema
// empresarial con 3 líneas activas (clases, productos, e-books) y marca físico-digital;
// las rutas gastronómicas siguen sin lanzar en tasting-ecuador.com: no se muestran (EGO, 2026-10-16);
// es un satélite (crece con productos BIE a cambio de participación). Sin cifras inventadas.
import '../../styles/site.css';
import { TASTING_ALT } from '../../data/tasting-alt';

const SITE = 'https://businessintelligence.solutions';
const url = `${SITE}/casos/tasting-ecuador/`;
const title = 'Tasting Ecuador — de cocinar bien a tener un negocio que crece';
const description = 'Tasting Ecuador empezó con meal prep: un negocio estable, pero que no crecía. Junto a BIE lo convertimos en un negocio con clases de cocina, productos y e-books, y toda su marca.';
const wa = (m: string) => `https://wa.me/593988253030?text=${encodeURIComponent(m + '\n\n— Origen: web/casos/tasting-ecuador/es')}`;

// Para sumar un servicio nuevo: copiar la imagen a public/images/casos/tasting/ y agregar una entrada aquí.
const SLIDES = [
  { img: 'web', alt: TASTING_ALT.web, tag: 'Presencia digital', title: 'Página web completa',
    text: 'Sitio propio con blog, tienda en línea, pagos con tarjeta, reservas y pedidos, y análisis de datos. Reúne en un solo lugar las clases de cocina, el meal prep, la revista editorial y los productos horneados por encargo.' },
  { img: 'os', alt: TASTING_ALT.os, tag: 'Sistema operativo', title: 'Tasting OS — más que un CRM',
    text: 'Un sistema operativo propio para el negocio: dashboard, agenda, ventas, producción, clases, clientes, finanzas, reportes, lista de compras y marketing en un mismo lugar.', note: 'Las cifras que se ven son datos de ejemplo, no resultados reales de la clienta.' },
  { img: 'branding', alt: TASTING_ALT.branding, tag: 'Marca', title: 'Branding',
    text: 'Logotipos principal y alternos, tipografías y paleta de colores definidos en una guía de marca, con ejemplos de aplicación en fotografía y piezas gráficas.' },
  { img: 'instagram', alt: TASTING_ALT.instagram, tag: 'Redes sociales', title: 'Malla de contenidos en Instagram',
    text: 'Una línea editorial planificada para el perfil: piezas con una misma voz, fotografía propia y frases de marca que hacen que el feed se lea como un conjunto.' },
  { img: 'disenos', alt: TASTING_ALT.disenos, tag: 'Diseño gráfico', title: 'Agenda, e-books y menús',
    text: 'Los diseños que el negocio necesita para operar, todos con la identidad de la marca: una agenda, e-books y menús listos para compartir con los clientes.' },
  { img: 'documentos', alt: TASTING_ALT.documentos, tag: 'Documentos', title: 'Cotizaciones, diplomas y papelería',
    text: 'Documentos con la misma imagen de marca: cotizaciones, diplomas y papelería. Cada propuesta que sale del negocio se ve igual de cuidada que el resto.', note: 'Los datos del cliente del documento están difuminados.' },
];

const ld = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, url,
    image: `${SITE}/images/casos/tasting/web.webp`,
    about: { '@type': 'Organization', name: 'Tasting Ecuador', url: 'https://tasting-ecuador.com',
      address: { '@type': 'PostalAddress', addressLocality: 'Cuenca', addressCountry: 'EC' } },
    author: { '@type': 'Organization', name: 'BIE — Business Intelligence Enhancer', url: SITE, sameAs: ['https://instagram.com/businessintelligence.ec'] },
    publisher: { '@type': 'Organization', name: 'BIE — Business Intelligence Enhancer', url: SITE, sameAs: ['https://instagram.com/businessintelligence.ec'], logo: { '@type': 'ImageObject', url: `${SITE}/icons/logo.svg` } },
    inLanguage: 'es-EC', datePublished: '2026-09-12T09:00:00-05:00', dateModified: '2026-10-16T18:37:00-05:00' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'Casos', item: SITE + '/#work' },
    { '@type': 'ListItem', position: 3, name: 'Tasting Ecuador', item: url } ] },
];
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title} | BIE</title>
<meta name="description" content={description}>
<link rel="canonical" href={url}>
<meta name="robots" content="index, follow">
<meta property="og:type" content="article">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={`${SITE}/images/og/og-default.jpg`}>
<meta property="og:locale" content="es_EC">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<script type="application/ld+json" is:inline set:html={JSON.stringify(ld)}></script>
<style is:global>
body{background:var(--black);color:var(--text)}
main{max-width:920px;margin:0 auto;padding:min(9vh,72px) 24px 100px}
.px{position:fixed;top:18px;left:18px;width:8px;height:8px;background:var(--accent)}
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);display:flex;align-items:center;gap:10px}
.eyebrow::before{content:'';width:22px;height:1px;background:var(--accent)}
.crumbs{font-family:var(--mono);font-size:11px;color:var(--text3);margin-bottom:22px}
.crumbs a{color:var(--text3);border-bottom:1px solid var(--border)}
h1{font-size:clamp(26px,4vw,42px);font-weight:400;letter-spacing:-.02em;line-height:1.15;margin-top:16px;text-wrap:balance}
.dek{font-size:clamp(16px,1.6vw,19px);line-height:1.55;color:var(--text2);margin-top:18px}
.meta-row{display:flex;flex-wrap:wrap;gap:24px;margin-top:28px;padding-top:20px;border-top:1px solid var(--border)}
.meta-item{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--text3)}
.meta-item b a{color:inherit;border-bottom:1px solid var(--accent)}
.meta-item b a:hover{color:var(--accent)}
.visit{margin-top:6px}
.meta-item b{display:block;font-family:var(--font);font-size:15px;letter-spacing:normal;text-transform:none;color:var(--text);margin-top:4px}
article{margin-top:44px}
article h2{font-size:clamp(21px,2.6vw,28px);font-weight:400;letter-spacing:-.015em;margin-top:44px;margin-bottom:14px}
article p{font-size:16px;line-height:1.7;color:var(--text2);margin-top:14px;max-width:66ch}
.split{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:20px}
.split > div{border:1px solid var(--border);padding:20px 22px}
.split h3{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);margin-bottom:10px}
.split.after h3{color:var(--accent)}
.split p{margin-top:0;font-size:14.5px}
.honest-note{border-left:2px solid var(--accent);padding-left:16px;margin-top:24px;font-size:14.5px;color:var(--text3);line-height:1.6}
.cta-box{margin-top:52px;border:1px solid var(--bone);padding:26px 28px}
.cta-box p{color:var(--text2);margin-top:0}
footer{border-top:1px solid var(--border);padding:32px 24px;text-align:center;font-family:var(--mono);font-size:11px;color:var(--text3)}
footer a{color:var(--text2);border-bottom:1px solid var(--border)}
.offer-bridge{margin-top:44px;border:1px solid var(--border);padding:24px 26px}
.offer-bridge h2{margin-top:0}
.offer-bridge .btn-primary{margin-top:18px}
.tgal{margin-top:36px;max-width:720px}
.lines{margin-top:14px;padding-left:20px;max-width:66ch}
.lines li{font-size:16px;line-height:1.7;color:var(--text2);margin-top:6px}
.lines b{color:var(--text);font-weight:500}
.tg-stage{display:grid;border:1px solid var(--border);background:#000;aspect-ratio:1600/1131;overflow:hidden}
.tg-slide{grid-area:1/1;margin:0;opacity:0;transition:opacity .7s ease;pointer-events:none}
.tg-slide.on{opacity:1;pointer-events:auto}
.tg-slide img{display:block;width:100%;height:100%;object-fit:cover}
.tg-caption{display:grid;margin-top:18px;min-height:8em}
.tg-text{grid-area:1/1;opacity:0;visibility:hidden;transition:opacity .5s ease}
.tg-text.on{opacity:1;visibility:visible}
.tg-tag{font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-size:19px;color:var(--accent)}
.tg-text h3{font-size:clamp(20px,2.4vw,26px);font-weight:400;letter-spacing:-.01em;margin-top:8px}
.tg-text p{font-size:15.5px;line-height:1.65;color:var(--text2);margin-top:10px;max-width:70ch}
.tg-text .tg-note{font-family:var(--font);font-size:13px;color:var(--text3)}
.tg-controls{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:16px}
.tg-btn{background:transparent;border:1px solid var(--border);color:var(--text2);font-family:var(--mono);font-size:12px;letter-spacing:.08em;padding:10px 16px;cursor:pointer;min-height:44px;min-width:44px}
.tg-btn:hover{border-color:var(--bone);color:var(--bone)}
.tg-dots{display:flex;gap:2px;margin-left:6px}
.tg-dot{width:44px;height:44px;background:transparent;border:0;cursor:pointer;position:relative}
.tg-dot::after{content:'';position:absolute;left:12px;right:12px;top:50%;height:3px;background:var(--border);transition:background .3s}
.tg-dot.on::after{background:var(--accent)}
.tg-count{font-family:var(--mono);font-size:11px;color:var(--text3);margin-left:auto;font-variant-numeric:tabular-nums}
.tg-btn:focus-visible,.tg-dot:focus-visible{outline:2px solid var(--bone);outline-offset:2px}
@media(prefers-reduced-motion:reduce){.tg-slide,.tg-text{transition:none}}
@media(max-width:640px){.split{grid-template-columns:1fr}.tg-caption{min-height:13em}.tg-dot{width:32px}.tg-dot::after{left:6px;right:6px}.tg-count{margin-left:0;width:100%}}
</style>
</head>
<body>
<span class="px" aria-hidden="true"></span>
<main>
  <p class="crumbs"><a href="/">Inicio</a> · <a href="/#work">Casos</a></p>
  <span class="eyebrow">Caso real · Autorizado por la clienta</span>
  <h1>Tasting Ecuador cocinaba muy bien. Lo que le faltaba era un negocio que creciera.</h1>
  <p class="dek">Todo era manual: pizarras, papel y pluma. Organizar les tomaba más tiempo que cocinar. Hoy un sistema lo hace por ellos.</p>

  <div class="meta-row">
    <span class="meta-item">Cliente<b><a href="https://tasting-ecuador.com" target="_blank" rel="noopener">Tasting Ecuador</a></b></span>
    <span class="meta-item">Sector<b>Experiencias gastronómicas</b></span>
    <span class="meta-item">Ubicación<b>Cuenca, Ecuador</b></span>
    <span class="meta-item">Modelo<b>Satélite BIE</b></span>
  </div>

  <article>
    <h2>Dónde empezaron</h2>
    <p>Tasting Ecuador preparaba comida por encargo (meal prep) y funcionaba. Pero todo se llevaba a mano, con pizarras, papel y pluma. Era estable, no crecía, y la organización tomaba más tiempo que la cocina.</p>

    <h2>Qué hicimos juntos</h2>
    <p>Pasamos del papel al sistema. Hoy el negocio tiene tres líneas, creadas junto a ellos:</p>
    <ul class="lines">
      <li><b>Clases de cocina</b> con la chef.</li>
      <li><b>Productos</b> horneados por encargo.</li>
      <li><b>E-books</b> con su conocimiento.</li>
    </ul>
    <p>Y una marca completa, física y digital: logotipo, redes, página web con tienda y su propio sistema.</p>

    <div class="split">
      <div>
        <h3>Antes</h3>
        <p>Todo a mano, con pizarras, papel y pluma. Más tiempo organizando que cocinando.</p>
      </div>
      <div class="after">
        <h3>Hoy</h3>
        <p>Un sistema que ordena todo, tres líneas de negocio y una marca que se reconoce.</p>
      </div>
    </div>

    <h2>Lo que hemos implementado</h2>
    <p>Lo que ya está funcionando. La lista crece.</p>
    <p class="visit"><a class="btn-ghost" href="https://tasting-ecuador.com" target="_blank" rel="noopener">Visitar tasting-ecuador.com <span aria-hidden="true">↗</span></a></p>
  </article>

  <section class="tgal" id="galeria" role="group" aria-roledescription="carrusel" aria-label="Servicios implementados en Tasting Ecuador">
    <div class="tg-stage" id="tg-stage">
      {SLIDES.map((s, i) => (
        <figure class={`tg-slide${i === 0 ? ' on' : ''}`} data-i={i} aria-hidden={i === 0 ? 'false' : 'true'}>
          <img src={`/images/casos/tasting/${s.img}.webp`} alt={s.alt} width="1600" height="1131" loading="eager" decoding="async">
        </figure>
      ))}
    </div>
    <div class="tg-caption" id="tg-caption" aria-live="off">
      {SLIDES.map((s, i) => (
        <div class={`tg-text${i === 0 ? ' on' : ''}`} data-i={i}>
          <span class="tg-tag">{s.tag}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          {s.note && <p class="tg-note">{s.note}</p>}
        </div>
      ))}
    </div>
    <div class="tg-controls">
      <button type="button" class="tg-btn" id="tg-prev" aria-label="Servicio anterior">←</button>
      <button type="button" class="tg-btn" id="tg-play" aria-label="Pausar rotación automática" aria-pressed="false">Pausar</button>
      <button type="button" class="tg-btn" id="tg-next" aria-label="Servicio siguiente">→</button>
      <div class="tg-dots">
        {SLIDES.map((s, i) => (
          <button type="button" class={`tg-dot${i === 0 ? ' on' : ''}`} data-i={i} aria-label={`Ver ${s.title}`}></button>
        ))}
      </div>
      <span class="tg-count" id="tg-count">1 / {SLIDES.length}</span>
    </div>
  </section>

  <article>
    <h2>Qué es un satélite</h2>
    <p>Un satélite es un negocio que crece junto a BIE. Usa lo que sabemos hacer (marca, web, sistemas, redes) y a cambio nos da una participación.</p>
    <p>Si a ellos les va bien, a nosotros también. Por eso nos quedamos al lado.</p>

    <h2>Lo que muestra este caso</h2>
    <p>Bien hecho y bien acompañado, crecer deja de ser suerte y se vuelve método.</p>

    <p class="honest-note">No publicamos cifras de ventas: Tasting Ecuador autorizó este caso con su nombre, no con los datos de su negocio.</p>

    <div class="offer-bridge">
      <h2>¿Solo necesitas tu página web?</h2>
      <p>Lo que ves en este caso es un proyecto integral, construido por etapas. No todo eso viene en nuestro piloto de página web: el piloto es una página de hasta cinco secciones con acompañamiento mensual, desde USD 150 de creación más USD 25 al mes.</p>
      <a class="btn-primary" href="/productos/pagina-web/?src=caso-tasting-ecuador"><span>Ver la oferta de página web</span></a>
    </div>

    <div class="cta-box">
      <p>Si tu negocio ya funciona pero no crece, cuéntanos tu caso.</p>
      <a class="btn-primary" href={wa('Hola, vi el caso de Tasting Ecuador en la web de BIE. Mi negocio ya funciona pero quiero que crezca. ¿Podemos hablar?')} target="_blank" rel="noopener noreferrer"><span>Contar mi caso por WhatsApp</span></a>
      <a class="btn-ghost" href="https://tasting-ecuador.com" target="_blank" rel="noopener">Visitar tasting-ecuador.com <span aria-hidden="true">↗</span></a>
    </div>
  </article>
</main>
<script is:inline>
(function(){
  var slides=document.querySelectorAll('.tg-slide'),texts=document.querySelectorAll('.tg-text'),dots=document.querySelectorAll('.tg-dot');
  var count=document.getElementById('tg-count'),play=document.getElementById('tg-play');
  if(!slides.length)return;
  var n=slides.length,cur=0,timer=null,paused=false;
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function show(i){
    cur=(i+n)%n;
    for(var k=0;k<n;k++){
      var on=k===cur;
      slides[k].classList.toggle('on',on);slides[k].setAttribute('aria-hidden',on?'false':'true');
      texts[k].classList.toggle('on',on);dots[k].classList.toggle('on',on);
      if(on)dots[k].setAttribute('aria-current','true');else dots[k].removeAttribute('aria-current');
    }
    count.textContent=(cur+1)+' / '+n;
  }
  function stop(){if(timer){clearInterval(timer);timer=null;}}
  function start(){stop();if(!paused&&!reduce)timer=setInterval(function(){show(cur+1);},5500);}
  function setPaused(p){paused=p;play.textContent=p?'Reanudar':'Pausar';play.setAttribute('aria-pressed',p?'true':'false');play.setAttribute('aria-label',p?'Reanudar rotación automática':'Pausar rotación automática');start();}
  document.getElementById('tg-prev').addEventListener('click',function(){show(cur-1);start();});
  document.getElementById('tg-next').addEventListener('click',function(){show(cur+1);start();});
  play.addEventListener('click',function(){setPaused(!paused);});
  dots.forEach(function(d){d.addEventListener('click',function(){show(+d.getAttribute('data-i'));start();});});
  var g=document.getElementById('galeria');
  g.addEventListener('mouseenter',stop);g.addEventListener('mouseleave',start);
  g.addEventListener('focusin',stop);g.addEventListener('focusout',start);
  if(reduce){play.style.display='none';}
  start();
})();
</script>
<footer>BUSINESS INTELLIGENCE ENHANCER · <a href={SITE}>businessintelligence.solutions</a> · <a href="/privacidad/">Privacidad</a></footer>
</body>
</html>
