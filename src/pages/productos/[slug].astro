---
// BIE-P06 — Plantilla estándar de página de producto.
// Una URL por producto, SEO propio (title, description, JSON-LD Service + FAQ + Breadcrumb),
// psicología de venta (dolor → qué es → cómo trabajamos → demo → para quién → FAQ → CTA),
// e interconexión (se potencia con / siguiente paso en la cadena). Sin precios.
import '../../styles/site.css';
import { PRODUCTS } from '../../data/products';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const SITE = 'https://businessintelligence.solutions';
// Interconexión: un relacionado enlaza a su página real solo si ya existe; si no, al catálogo de la home.
const SLUGS = new Set(PRODUCTS.map((x) => x.slug));
// Los enlaces internos llevan ?src=<slug-de-esta-página> para saber desde dónde llegó el interés.
const rhref = (slug: string) => (SLUGS.has(slug) ? `/productos/${slug}/?src=${p.slug}` : '/#catalog');
const hasDemo = !!(p.demo && p.demo.length);
// Cadena: orden oficial de navegación entre productos publicados (fase y código del catálogo).
const CHAIN = ['analisis-de-marca', 'analisis-de-competencia', 'analisis-de-mercado', 'identidad-de-marca', 'estrategia-de-contenidos', 'gestion-redes-sociales', 'pagina-web', 'posicionamiento-seo', 'perfil-google-maps', 'link-hub', 'asistente-inteligente-whatsapp', 'crm-ia', 'sistema-operativo', 'automatizaciones', 'whatsapp-business-commerce', 'data-analytics'];
const ci = CHAIN.indexOf(p.slug);
const byteSlug = (s: string) => PRODUCTS.find((x) => x.slug === s)!;
const prev = ci > 0 ? byteSlug(CHAIN[ci - 1]) : null;
const nextP = ci >= 0 && ci < CHAIN.length - 1 ? byteSlug(CHAIN[ci + 1]) : null;
const chainHref = (s: string) => `/productos/${s}/?src=cadena-${p.slug}`;
const url = `${SITE}/productos/${p.slug}/`;
const WA = '593988253030';
const wa = (m: string) => `https://wa.me/${WA}?text=${encodeURIComponent(m)}`;

// Diccionario bilingüe para el toggle cliente; el HTML se renderiza en español (SEO).
const T: Record<string, { es: string; en: string }> = {
  nav_work: { es: 'Empresas', en: 'Companies' }, nav_catalog: { es: 'Catálogo', en: 'Catalog' },
  nav_comm: { es: 'Comunidad', en: 'Community' }, nav_contact: { es: 'Contacto', en: 'Contact' },
  nav_cta: { es: 'Diagnóstico gratuito', en: 'Free diagnosis' },
  mm_cta: { es: 'Diagnóstico gratuito por WhatsApp', en: 'Free diagnosis on WhatsApp' },
  bc_home: { es: 'Inicio', en: 'Home' }, bc_cat: { es: 'Catálogo', en: 'Catalog' },
  phase_w: { es: 'Fase', en: 'Phase' },
  phase: p.phase.title, name: p.name, h1: p.hero.h1, sub: p.hero.sub, trust: p.hero.trust,
  cta_buy: { es: 'Quiero esto', en: 'I want this' },
  cta_diag: { es: 'Diagnóstico gratuito', en: 'Free diagnosis' },
  cta_how: { es: 'Ver cómo funciona ↓', en: 'See how it works ↓' },
  pain_label: { es: 'Lo que te está costando no tenerlo', en: 'What not having it is costing you' },
  pain_h2: { es: 'Cada mensaje sin respuesta<br><span class="serif">es una venta que se fue.</span>', en: 'Every unanswered message<br><span class="serif">is a sale that left.</span>' },
  what_label: { es: 'Qué es', en: 'What it is' },
  what_h2: { es: 'Un vendedor que nunca duerme,<br><span class="serif">entrenado con tu empresa.</span>', en: 'A salesperson that never sleeps,<br><span class="serif">trained on your company.</span>' },
  what: p.what,
  deliv_label: { es: 'Lo que recibes', en: 'What you receive' },
  how_label: { es: 'Cómo trabajamos', en: 'How we work' },
  how_h2: { es: 'Cuatro pasos,<br><span class="serif">cero fricción.</span>', en: 'Four steps,<br><span class="serif">zero friction.</span>' },
  demo_label: { es: 'Así conversa', en: 'This is how it talks' },
  demo_h2: { es: 'Una conversación real,<br><span class="serif">sin nadie detrás del teléfono.</span>', en: 'A real conversation,<br><span class="serif">with nobody behind the phone.</span>' },
  demo_tag: { es: 'Simulación · 02:14 a.m.', en: 'Simulation · 02:14 a.m.' },
  who_label: { es: 'Para quién', en: 'Who it is for' },
  who_h2: { es: 'Si recibes más mensajes<br><span class="serif">de los que puedes contestar.</span>', en: 'If you get more messages<br><span class="serif">than you can answer.</span>' },
  faq_label: { es: 'Preguntas frecuentes', en: 'Frequently asked' },
  faq_h2: { es: 'Lo que todos preguntan<br><span class="serif">antes de decidir.</span>', en: 'What everyone asks<br><span class="serif">before deciding.</span>' },
  rel_label: { es: 'Se potencia con', en: 'Works better with' },
  rel_h2: { es: 'No es una pieza suelta.<br><span class="serif">Es parte de la cadena.</span>', en: 'Not a loose piece.<br><span class="serif">Part of the chain.</span>' },
  next_label: { es: 'Siguiente paso en la cadena', en: 'Next step in the chain' },
  soon: { es: 'Página muy pronto', en: 'Page coming soon' },
  band_t: { es: '¿Lo quieres para tu empresa? <span class="serif">Empezamos por WhatsApp.</span>', en: 'Want it for your company? <span class="serif">We start on WhatsApp.</span>' },
  band_btn: { es: 'Quiero esto', en: 'I want this' },
  waw_name: { es: 'Equipo BIE', en: 'BIE Team' }, waw_status: { es: 'En línea · responde en minutos', en: 'Online · replies in minutes' },
  waw_bubble: { es: 'Hola. <b>¿En cuál de estos momentos está tu empresa?</b> Elige y seguimos por WhatsApp:', en: 'Hi. <b>Which of these moments is your company in?</b> Pick one and we continue on WhatsApp:' },
  waw_foot: { es: 'CONVERSACIÓN DIRECTA · 099 825 3030', en: 'DIRECT CONVERSATION · 099 825 3030' },
};
p.pains.forEach((x, i) => { T[`pain${i}_t`] = x.title; T[`pain${i}_b`] = x.body; });
p.deliverables.forEach((x, i) => { T[`del${i}`] = x; });
p.steps.forEach((x, i) => { T[`step${i}_t`] = x.title; T[`step${i}_b`] = x.body; });
(p.demo || []).forEach((x, i) => { T[`demo${i}`] = x.text; });
if (p.heads?.pain) T.pain_h2 = p.heads.pain;
if (p.heads?.what) T.what_h2 = p.heads.what;
if (p.heads?.who) T.who_h2 = p.heads.who;
if (p.heads?.band) T.band_t = p.heads.band;
p.forWhom.forEach((x, i) => { T[`who${i}`] = x; });
p.faq.forEach((x, i) => { T[`faq${i}_q`] = x.q; T[`faq${i}_a`] = x.a; });
p.related.forEach((x, i) => { T[`rel${i}_n`] = x.name; T[`rel${i}_w`] = x.why; });
T.next_n = p.next.name; T.next_w = p.next.why;
(p.chips || []).forEach((x, i) => { T[`chip${i}`] = x; });
(p.usedBy || []).forEach((x, i) => { T[`used${i}`] = x.note; });
T.used_label = { es: 'Empresas que ya lo usan', en: 'Companies already using it' };
T.used_h2 = { es: 'No es teoría.<br><span class="serif">Ya está atendiendo clientes reales.</span>', en: 'Not theory.<br><span class="serif">Already serving real customers.</span>' };
T.used_more = { es: 'Tu empresa podría ser la siguiente', en: 'Your company could be next' };
T.os_k1 = { es: 'Ventas', en: 'Sales' }; T.os_k2 = { es: 'Leads', en: 'Leads' }; T.os_k3 = { es: 'A tiempo', en: 'On time' };
T.crm_c1 = { es: 'Nuevos', en: 'New' }; T.crm_c2 = { es: 'Propuesta', en: 'Proposal' }; T.crm_c3 = { es: 'Cierre', en: 'Closing' };
T.fl_1 = { es: 'Pedido recibido → factura creada', en: 'Order received → invoice created' };
T.fl_2 = { es: 'Datos sincronizados con la hoja', en: 'Data synced to the sheet' };
T.fl_3 = { es: 'Reporte enviado al dueño 07:00', en: 'Report sent to the owner 07:00' };
T.com_st = { es: 'catálogo en el chat', en: 'catalog in the chat' };
T.ch_prev = { es: 'Anterior en la cadena', en: 'Previous in the chain' };
T.ch_next = { es: 'Siguiente en la cadena', en: 'Next in the chain' };
T.ch_pos = { es: `Paso ${ci + 1} de ${CHAIN.length} en la cadena`, en: `Step ${ci + 1} of ${CHAIN.length} in the chain` };
if (prev) T.ch_prev_n = prev.name;
if (nextP) T.ch_next_n = nextP.name;
T.com_order = { es: 'Pedido confirmado · Combo 2 + envío', en: 'Order confirmed · Combo 2 + shipping' };
T.ph_name = { es: 'Tu empresa', en: 'Your company' }; T.ph_st = { es: 'en línea · responde al instante', en: 'online · replies instantly' };
const es = (k: string) => T[k].es;

const WAW_OPTS = [
  { t: { es: 'Voy a abrir un negocio o empresa', en: 'I am opening a business' }, m: { es: 'Hola, voy a abrir un negocio o empresa y quiero saber cómo empezar bien desde el inicio.', en: 'Hi, I am opening a business and want to know how to start right from day one.' } },
  { t: { es: 'Ya sé lo que necesito', en: 'I know what I need' }, m: { es: 'Hola, ya sé lo que mi empresa necesita. Quiero hablar de un producto en específico.', en: 'Hi, I already know what my company needs. I want to talk about a specific product.' } },
  { t: { es: 'Me gustaría una asesoría', en: 'I would like advisory' }, m: { es: 'Hola, me gustaría una asesoría para saber qué necesita mi empresa y por dónde empezar.', en: 'Hi, I would like advisory to understand what my company needs and where to start.' } },
  { t: { es: 'Hablar con un humano', en: 'Talk to a human' }, m: { es: 'Hola, quiero hablar directamente con una persona del equipo de BIE.', en: 'Hi, I want to talk directly with a person from the BIE team.' } },
];
const BUBBLES = { es: ['¿Necesitas ayuda?', '¿Ya sabes lo que deseas?', '¿Vas a abrir un negocio?', '¿Quieres que lo veamos juntos?', 'Estoy aquí, escríbeme.'], en: ['Need a hand?', 'Already know what you want?', 'Opening a business?', 'Want to look at it together?', 'I am here — write me.'] };

const strip = (h: string) => h.replace(/<[^>]+>/g, '');
const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: p.name.es, serviceType: p.name.es, description: p.seoDescription.es, url,
    provider: { '@type': 'ProfessionalService', name: 'BIE — Business Intelligence Enhancer', url: SITE, telephone: '+593988253030' },
    areaServed: { '@type': 'Country', name: 'Ecuador' }, availableLanguage: ['es', 'en'] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: p.faq.map((f) => ({ '@type': 'Question', name: f.q.es, acceptedAnswer: { '@type': 'Answer', text: f.a.es } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: 'Catálogo', item: SITE + '/#catalog' },
    { '@type': 'ListItem', position: 3, name: p.name.es, item: url } ] },
];
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{p.seoTitle.es}</title>
<meta name="description" content={p.seoDescription.es}>
<link rel="canonical" href={url}>
<meta name="robots" content="index, follow">
<meta property="og:type" content="website">
<meta property="og:title" content={p.seoTitle.es}>
<meta property="og:description" content={p.seoDescription.es}>
<meta property="og:url" content={url}>
<meta property="og:image" content={`${SITE}/images/og/${p.slug}.jpg`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={`${SITE}/images/og/${p.slug}.jpg`}>
<meta property="og:locale" content="es_EC">
<meta name="theme-color" content="#070709">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<script type="application/ld+json" is:inline set:html={JSON.stringify(ld)}></script>
<style is:global>
/* ── Página de producto ── */
.p-hero{background:var(--black);color:#fff;padding:150px 0 110px;position:relative;overflow:hidden;min-height:96vh;display:flex;align-items:center}
.p-hero::after{content:'';position:absolute;left:50%;top:45%;width:100vw;height:100vh;transform:translate(-50%,-50%);pointer-events:none;background:radial-gradient(40% 40% at 70% 50%,rgba(229,57,53,.12) 0%,transparent 60%)}
.p-hero-grid{position:absolute;inset:0;opacity:.07;pointer-events:none;
  background-image:linear-gradient(rgba(255,255,255,.6) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.6) 1px,transparent 1px);background-size:56px 56px;
  mask-image:radial-gradient(60% 60% at 70% 50%,#000 0%,transparent 100%);-webkit-mask-image:radial-gradient(60% 60% at 70% 50%,#000 0%,transparent 100%)}
.p-hero .section-inner{z-index:2}
.bc{display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.45);margin-bottom:34px;flex-wrap:wrap}
.bc a:hover{color:#fff}
.bc .bc-sep{width:5px;height:5px;background:var(--accent)}
.p-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
.p-kicker{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);display:flex;align-items:center;gap:10px;margin-bottom:22px}
.p-kicker::before{content:'';width:9px;height:9px;background:var(--accent)}
.p-h1{font-size:clamp(36px,5vw,68px);font-weight:700;letter-spacing:-.038em;line-height:1.04;text-wrap:balance}
.p-sub{font-size:17px;line-height:1.72;color:rgba(255,255,255,.6);margin-top:26px;max-width:560px}
.p-ctas{display:flex;gap:12px;margin-top:36px;flex-wrap:wrap}
.p-hero .btn-primary{background:#fff;color:var(--black);box-shadow:none}
.p-hero .btn-primary:hover{color:#fff}
.p-hero .btn-ghost{border-color:rgba(255,255,255,.28);color:#fff;background:transparent}
.p-hero .btn-ghost:hover{border-color:var(--accent);background:rgba(229,57,53,.14)}
.p-trust{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.38);margin-top:22px}
/* cubo del producto (estático, girando) */
.p-cube-wrap{perspective:1200px;display:flex;justify-content:center;align-items:center;min-height:340px}
.p-cube{--cs:220px;--half:110px;width:var(--cs);height:var(--cs);position:relative;transform-style:preserve-3d;animation:p-spin 16s linear infinite}
@keyframes p-spin{from{transform:rotateX(-22deg) rotateY(0)}to{transform:rotateX(-22deg) rotateY(360deg)}}
.p-cube .hc{position:absolute;inset:0;border:1px solid rgba(255,255,255,.5);background:rgba(255,255,255,.035)}
.p-cube .hc.f{transform:translateZ(var(--half));background:rgba(229,57,53,.82)}
.p-cube .hc.b{transform:rotateY(180deg) translateZ(var(--half))}
.p-cube .hc.r{transform:rotateY(90deg) translateZ(var(--half))}
.p-cube .hc.l{transform:rotateY(-90deg) translateZ(var(--half))}
.p-cube .hc.t{transform:rotateX(90deg) translateZ(var(--half))}
.p-cube .hc.d{transform:rotateX(-90deg) translateZ(var(--half))}
.p-cube .hc-label{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:#fff;text-transform:uppercase}
/* visual: teléfono 3D con conversación viva (productos de chat) */
.p-visual{display:flex;justify-content:center;align-items:center;min-height:520px;perspective:1400px}
.ph3d-scene{position:relative;width:300px;height:500px;transform-style:preserve-3d;will-change:transform;transition:transform .12s linear;transform:rotateY(-22deg) rotateX(8deg)}
.ph3d{position:absolute;left:50%;top:50%;width:236px;height:460px;margin:-230px 0 0 -118px;background:#101014;border:1.5px solid rgba(255,255,255,.26);padding:10px;
  transform-style:preserve-3d;box-shadow:40px 60px 90px -30px rgba(0,0,0,.85),0 0 0 1px rgba(0,0,0,.6) inset;animation:ph-float 5.5s ease-in-out infinite}
.ph3d::after{content:'';position:absolute;left:-6px;top:90px;width:3px;height:44px;background:rgba(255,255,255,.25)}
@keyframes ph-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
.ph3d-shadow{position:absolute;left:50%;bottom:-34px;width:220px;height:24px;transform:translateX(-50%);background:rgba(0,0,0,.7);filter:blur(16px);border-radius:50%}
.ph3d::before{content:;position:absolute;top:0;left:50%;transform:translateX(-50%);width:70px;height:5px;background:#000;border-radius:0 0 4px 4px}
.ph3d-screen{background:#0b0b0d;height:100%;display:flex;flex-direction:column;overflow:hidden}
.ph3d-head{display:flex;align-items:center;gap:9px;padding:16px 12px 10px;border-bottom:1px solid rgba(255,255,255,.1);background:#070709}
.ph3d-av{width:28px;height:28px;background:var(--accent);display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;font-size:11px;flex-shrink:0}
.ph3d-head b{display:block;color:#fff;font-size:11px;font-weight:700}
.ph3d-head i{display:block;font-style:normal;font-family:var(--mono);font-size:8px;color:#25D366;margin-top:2px}
.ph3d-body{padding:12px 10px;display:flex;flex-direction:column;gap:8px;flex:1}
.pb{max-width:86%;padding:8px 10px;font-size:10.5px;line-height:1.45;opacity:0;transform:translateY(8px);animation:pb-loop 11s infinite}
.pb.client{align-self:flex-end;background:#fff;color:var(--text)}
.pb.bot{align-self:flex-start;background:rgba(255,255,255,.09);color:#fff;border-left:2px solid var(--accent)}
.pb:nth-child(1){animation-delay:.4s}.pb:nth-child(2){animation-delay:2.1s}.pb:nth-child(3){animation-delay:4s}.pb:nth-child(4){animation-delay:5.9s}
@keyframes pb-loop{0%{opacity:0;transform:translateY(8px)}5%{opacity:1;transform:none}80%{opacity:1;transform:none}88%,100%{opacity:0;transform:translateY(-4px)}}
.ph3d-chip{position:absolute;background:#fff;color:var(--text);font-size:11px;font-weight:700;letter-spacing:-.01em;padding:10px 13px;display:flex;align-items:center;gap:8px;
  box-shadow:0 20px 40px -12px rgba(0,0,0,.6);white-space:nowrap;opacity:0;animation:chip-pop 11s infinite}
.ph3d-chip .px{width:7px;height:7px;background:var(--accent);flex-shrink:0}
.ph3d-chip.c0{right:-46px;top:56px;animation-delay:2.6s}
.ph3d-chip.c1{left:-70px;top:250px;animation-delay:6.4s}
.ph3d-chip.c2{right:-36px;bottom:70px;animation-delay:8.6s}
@keyframes chip-pop{0%{opacity:0;transform:translateZ(70px) translateY(10px) scale(.92)}4%{opacity:1;transform:translateZ(70px) translateY(0) scale(1)}28%{opacity:1;transform:translateZ(70px)}34%,100%{opacity:0;transform:translateZ(70px) translateY(-8px) scale(.96)}}
/* visual: ventana de navegador 3D que se construye sola (productos web) */
.web3d{position:absolute;left:50%;top:50%;width:340px;height:420px;margin:-210px 0 0 -170px;background:#101014;border:1.5px solid rgba(255,255,255,.26);
  box-shadow:40px 60px 90px -30px rgba(0,0,0,.85);animation:ph-float 5.5s ease-in-out infinite;display:flex;flex-direction:column}
.web3d-bar{display:flex;align-items:center;gap:6px;padding:11px 12px;border-bottom:1px solid rgba(255,255,255,.12);background:#0b0b0d}
.wb-dot{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.25)}
.wb-url{flex:1;margin-left:8px;background:rgba(255,255,255,.08);font-family:var(--mono);font-size:9px;color:rgba(255,255,255,.5);padding:5px 12px}
.web3d-page{flex:1;padding:20px 18px;display:flex;flex-direction:column;gap:10px}
.wp{opacity:0;animation:wp-build 10s infinite}
.wp.el{background:rgba(255,255,255,.14);height:14px}
.wp.e1{width:70%;height:22px;background:rgba(255,255,255,.28)}
.wp.e2{width:88%}
.wp.e3{width:56%}
.wp.btn{width:110px;height:32px;background:var(--accent)}
.wp.img{height:88px;background:linear-gradient(135deg,rgba(229,57,53,.25),rgba(255,255,255,.06))}
.wp.card{height:44px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1)}
.wp.e1{animation-delay:.5s}.wp.e2{animation-delay:1.1s}.wp.e3{animation-delay:1.6s}.wp.e4{animation-delay:2.2s}.wp.e5{animation-delay:3s}.wp.e6{animation-delay:3.7s}.wp.e7{animation-delay:4.2s}
@keyframes wp-build{0%{opacity:0;transform:translateY(10px)}6%{opacity:1;transform:none}86%{opacity:1}94%,100%{opacity:0}}
/* visual: panel de control (crm / automatizaciones / analytics) */
.os-page{gap:12px}
.os-kpis{display:flex;gap:8px}
.os-kpi{flex:1;background:rgba(255,255,255,.07);padding:12px 10px;display:flex;flex-direction:column;gap:4px}
.os-kpi b{color:#fff;font-size:18px;font-weight:700;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.os-kpi i{font-style:normal;font-family:var(--mono);font-size:7.5px;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.45)}
.os-bars{display:flex;align-items:flex-end;gap:6px;height:92px;background:rgba(255,255,255,.04);padding:10px}
.os-bars i{flex:1;background:var(--accent);opacity:.85;animation:bar-live 2.6s ease-in-out infinite alternate}
@keyframes bar-live{from{transform:scaleY(.72)}to{transform:scaleY(1)}}
.os-row{height:16px;background:rgba(255,255,255,.1)}
/* visual: tablero de marca */
.brand3d{position:absolute;left:50%;top:50%;width:320px;height:400px;margin:-200px 0 0 -160px;background:#101014;border:1.5px solid rgba(255,255,255,.26);
  box-shadow:40px 60px 90px -30px rgba(0,0,0,.85);animation:ph-float 5.5s ease-in-out infinite;padding:20px;display:flex;flex-direction:column;gap:14px}
.bd-logo{background:#fff;color:#070709;font-weight:700;font-size:30px;letter-spacing:-.04em;line-height:1;padding:26px 20px;text-align:left}
.bd-swatches{display:flex;gap:8px}
.bd-swatches i{flex:1;height:34px}
.bd-type{display:flex;gap:14px;align-items:center}
.bd-type b{color:#fff;font-size:38px;font-weight:700;letter-spacing:-.03em}
.bd-type span{flex:1;display:flex;flex-direction:column;gap:7px}
.bd-type span i{height:8px;background:rgba(255,255,255,.18);display:block}
.bd-apps{display:flex;gap:8px}
.bd-apps i{flex:1;height:44px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12)}
/* navegación en cadena: flechas laterales fijas + barra anterior/siguiente */
.chain-arrow{position:fixed;top:50%;transform:translateY(-50%);z-index:90;width:52px;height:52px;background:var(--bg);
  border:1px solid rgba(0,0,0,.12);display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--text2);
  box-shadow:var(--sh-md);transition:background .25s,color .25s,transform .3s var(--ease);opacity:0;pointer-events:none}
body.past-hero .chain-arrow{opacity:1;pointer-events:auto}
.chain-arrow:hover{background:var(--accent);color:#fff;border-color:var(--accent)}
.chain-arrow.left{left:18px}
.chain-arrow.right{right:18px}
.chain-arrow .ca-tip{position:absolute;top:-38px;left:50%;transform:translateX(-50%);white-space:nowrap;background:var(--black);color:#fff;
  font-family:var(--mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;padding:6px 10px;opacity:0;transition:opacity .2s;pointer-events:none}
.chain-arrow:hover .ca-tip{opacity:1}
.chain-bar{display:grid;grid-template-columns:1fr auto 1fr;gap:14px;align-items:stretch;margin-top:0;padding:0 0 40px}
.chain-cell{border:1px solid rgba(0,0,0,.08);background:var(--bg);padding:22px 24px;display:flex;flex-direction:column;gap:8px;
  transition:transform .3s var(--ease),box-shadow .4s var(--ease),border-color .25s}
.chain-cell:hover{transform:translateY(-4px);box-shadow:var(--sh-md);border-color:var(--accent)}
.chain-cell.empty{visibility:hidden}
.chain-cell.nxt{text-align:right;align-items:flex-end}
.chain-k{font-family:var(--mono);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--text3)}
.chain-n{font-size:17px;font-weight:700;letter-spacing:-.02em}
.chain-pos{display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;
  text-transform:uppercase;color:var(--text3);padding:0 20px;border-left:1px solid var(--border);border-right:1px solid var(--border)}
@media(max-width:960px){.chain-arrow{display:none}}
@media(max-width:640px){.chain-bar{grid-template-columns:1fr;padding-bottom:26px}.chain-pos{border:none;padding:6px 0}.chain-cell.nxt{text-align:left;align-items:flex-start}}
/* visual hub: teléfono con botones de enlace y un toque */
.hub-scr{display:flex;flex-direction:column;align-items:center;gap:9px;padding:26px 16px}
.hub-av{width:40px;height:40px;background:var(--accent)}
.hub-name{color:#fff;font-size:11px;font-weight:700;letter-spacing:-.01em;margin-bottom:4px}
.hub-btn{width:100%;height:34px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.16)}
.hub-btn.h1{animation-delay:.4s}.hub-btn.h2{animation-delay:1s}.hub-btn.h3{animation-delay:1.6s}.hub-btn.h4{animation-delay:2.2s}
.hub-btn.tap{animation:wp-build 10s infinite,hub-tap 10s infinite}
@keyframes hub-tap{0%,32%{background:rgba(255,255,255,.1)}36%,44%{background:var(--accent);transform:scale(1.04)}48%,100%{background:rgba(255,255,255,.1)}}
/* visual crm: pipeline con tarjeta que avanza */
.crm-page{flex:1;display:flex;gap:8px;padding:16px 14px;position:relative}
.crm-col{flex:1;background:rgba(255,255,255,.05);padding:8px;display:flex;flex-direction:column;gap:7px}
.crm-col.win{outline:1px solid rgba(229,57,53,.5)}
.crm-h{font-style:normal;font-family:var(--mono);font-size:7px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.45);margin-bottom:2px}
.crm-card{height:26px;background:rgba(255,255,255,.12)}
.crm-move{position:absolute;top:52px;left:22px;width:26%;height:26px;background:#fff;display:flex;align-items:center;justify-content:flex-end;padding:0 6px;
  animation:crm-go 9s cubic-bezier(.4,0,.2,1) infinite;box-shadow:0 8px 18px rgba(0,0,0,.5)}
.crm-move b{font-size:9px;color:var(--accent);font-weight:700}
@keyframes crm-go{0%,18%{left:22px}30%,52%{left:calc(33% + 14px)}64%,86%{left:calc(66% + 6px)}94%,100%{left:calc(66% + 6px);opacity:0}}
/* visual flow: nodos con pulso que recorre */
.flow-page{flex:1;display:flex;flex-direction:column;justify-content:center;gap:26px;padding:22px 18px}
.flow-track{display:flex;align-items:center;position:relative}
.flow-node{width:38px;height:38px;border:1.5px solid rgba(255,255,255,.35);display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;flex-shrink:0;background:#0b0b0d;animation:node-on 8s infinite}
.flow-node.n1{animation-delay:.2s;color:var(--accent)}
.flow-node.n2{animation-delay:2.2s}.flow-node.n3{animation-delay:4.2s}
.flow-node.n4{animation-delay:6.2s;color:#25D366}
@keyframes node-on{0%,2%{border-color:rgba(255,255,255,.35);background:#0b0b0d}6%,90%{border-color:var(--accent);background:rgba(229,57,53,.15)}96%,100%{border-color:rgba(255,255,255,.35);background:#0b0b0d}}
.flow-line{flex:1;height:1.5px;background:rgba(255,255,255,.22)}
.flow-dot{position:absolute;top:50%;left:0;width:9px;height:9px;background:var(--accent);transform:translateY(-50%);animation:dot-run 8s linear infinite}
@keyframes dot-run{0%{left:4%}25%{left:32%}50%{left:60%}75%{left:88%}100%{left:88%;opacity:0}}
.flow-logs{display:flex;flex-direction:column;gap:8px}
.flow-log{font-family:var(--mono);font-size:9px;color:rgba(255,255,255,.55);padding:8px 10px;background:rgba(255,255,255,.05);border-left:2px solid var(--accent)}
.flow-log.f1{animation-delay:2.4s}.flow-log.f2{animation-delay:4.4s}.flow-log.f3{animation-delay:6.4s}
/* visual commerce: catálogo en el chat + pedido */
.com-scr{display:flex;flex-direction:column}
.com-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;padding:12px 10px}
.com-p{aspect-ratio:1;background:rgba(255,255,255,.08);position:relative;display:flex;flex-direction:column;justify-content:flex-end;padding:6px;gap:4px}
.com-p i{display:block;height:52%;background:linear-gradient(135deg,rgba(255,255,255,.22),rgba(255,255,255,.06));position:absolute;top:6px;left:6px;right:6px}
.com-p em{display:block;height:6px;width:60%;background:rgba(255,255,255,.3)}
.com-p.p1{animation-delay:.4s}.com-p.p2{animation-delay:.9s}.com-p.p3{animation-delay:1.4s}.com-p.p4{animation-delay:1.9s}
.com-p.pick{animation:wp-build 10s infinite,com-pick 10s infinite}
@keyframes com-pick{0%,26%{outline:0 solid transparent}30%,88%{outline:2px solid var(--accent)}92%,100%{outline:0 solid transparent}}
.com-order{margin:0 10px;background:var(--accent);color:#fff;font-size:9px;font-weight:700;padding:9px 10px;animation-delay:3.2s}
/* visuales batch002 — cada producto con su propia escena */
.vz{flex:1;position:relative;padding:22px 20px;display:block}
/* scan: tablero de marca escaneado */
.vz-scan .sc-logo{position:absolute;top:22px;left:20px;width:64px;height:64px;background:#fff;color:#070709;font-weight:700;font-size:30px;display:flex;align-items:center;justify-content:center}
.vz-scan .sc-row{position:absolute;left:104px;height:13px;background:rgba(255,255,255,.16);display:block}
.vz-scan .sc-row:nth-of-type(2){top:26px}.vz-scan .sc-row:nth-of-type(3){top:50px}.vz-scan .sc-row:nth-of-type(4){top:74px}
.vz-scan .sc-score{position:absolute;width:52px;height:52px;border:1.5px solid var(--accent);color:var(--accent);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:19px;opacity:0;animation:wp-build 9s infinite}
.vz-scan .s1{left:20px;bottom:88px;animation-delay:2.4s}
.vz-scan .s2{left:88px;bottom:88px;animation-delay:3.2s}
.vz-scan .sc-beam{position:absolute;left:0;right:0;height:3px;background:var(--accent);box-shadow:0 0 22px rgba(229,57,53,.9);animation:beam 4.5s ease-in-out infinite}
@keyframes beam{0%{top:8%}50%{top:92%}100%{top:8%}}
/* radar: mapa perceptual */
.vz-radar .rd-x{position:absolute;left:8%;right:8%;top:50%;height:1px;background:rgba(255,255,255,.25)}
.vz-radar .rd-y{position:absolute;top:6%;bottom:6%;left:50%;width:1px;background:rgba(255,255,255,.25)}
.vz-radar .rd-dot{position:absolute;width:13px;height:13px;background:rgba(255,255,255,.4);opacity:0;animation:wp-build 9s infinite}
.vz-radar .d1{left:24%;top:30%;animation-delay:.6s}.vz-radar .d2{left:64%;top:24%;animation-delay:1.2s}
.vz-radar .d3{left:30%;top:66%;animation-delay:1.8s}.vz-radar .d4{left:56%;top:58%;animation-delay:2.4s}
.vz-radar .you{width:17px;height:17px;background:var(--accent);left:74%;top:70%;opacity:0;animation:you-pop 9s infinite;box-shadow:0 0 24px rgba(229,57,53,.8)}
@keyframes you-pop{0%,34%{opacity:0;transform:scale(.5)}40%{opacity:1;transform:scale(1.25)}44%,88%{opacity:1;transform:scale(1)}96%,100%{opacity:0}}
.vz-radar .rd-gap{position:absolute;left:66%;top:62%;width:88px;height:74px;border:1.5px dashed rgba(229,57,53,.6);opacity:0;animation:wp-build 9s infinite;animation-delay:3s}
/* market: TAM/SAM/SOM creciendo */
.vz-market{display:flex;align-items:flex-end;gap:18px;padding:26px 24px 44px}
.vz-market .mk-bar{flex:1;height:100%;position:relative;display:block}
.vz-market .mk-bar i{position:absolute;left:0;right:0;bottom:0;display:block;transform-origin:bottom;animation:mk-grow 8s var(--ease) infinite}
.vz-market .b1 i{height:96%;background:rgba(255,255,255,.14)}
.vz-market .b2 i{height:62%;background:rgba(255,255,255,.3);animation-delay:.5s}
.vz-market .b3 i{height:34%;background:var(--accent);animation-delay:1s;box-shadow:0 0 26px rgba(229,57,53,.45)}
@keyframes mk-grow{0%{transform:scaleY(0)}14%{transform:scaleY(1)}86%{transform:scaleY(1)}96%,100%{transform:scaleY(0)}}
.vz-market .mk-lab{position:absolute;bottom:16px;font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;color:rgba(255,255,255,.5)}
.vz-market .l1{left:12%}.vz-market .l2{left:46%}.vz-market .l3{left:78%;color:var(--accent)}
/* calendar: mes encendiéndose */
.vz-cal{display:grid;grid-template-columns:repeat(5,1fr);grid-auto-rows:1fr;gap:8px;height:100%;padding:22px 20px}
.cl-cell{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);position:relative;opacity:0;animation:cal-on 10s infinite}
.cl-cell::after{content:'';position:absolute;left:6px;bottom:6px;width:10px;height:10px}
.cl-cell.q0::after{background:var(--accent)}.cl-cell.q2::after{background:rgba(255,255,255,.5)}.cl-cell.q3::after{background:rgba(255,255,255,.25)}
.cl-cell.c0{animation-delay:.2s}.cl-cell.c1{animation-delay:.55s}.cl-cell.c2{animation-delay:.9s}.cl-cell.c3{animation-delay:1.25s}
.cl-cell.c4{animation-delay:1.6s}.cl-cell.c5{animation-delay:1.95s}.cl-cell.c6{animation-delay:2.3s}
@keyframes cal-on{0%{opacity:0;transform:scale(.9)}6%{opacity:1;transform:scale(1)}88%{opacity:1}96%,100%{opacity:0}}
/* serp: tu resultado sube al #1 */
.vz-serp{display:flex;flex-direction:column;gap:14px;padding:24px 22px}
.sp-search{height:34px;border:1.5px solid rgba(255,255,255,.3);border-radius:17px;display:block}
.sp-res{height:44px;background:rgba(255,255,255,.08);display:block}
.sp-res.you{background:rgba(229,57,53,.16);border-left:3px solid var(--accent);position:relative;animation:serp-rise 8s var(--ease) infinite}
.sp-res.you i{position:absolute;right:12px;top:50%;transform:translateY(-50%);width:26px;height:14px;background:var(--accent)}
@keyframes serp-rise{0%,18%{transform:translateY(0)}38%,88%{transform:translateY(-116px)}96%,100%{transform:translateY(0)}}
/* map: pin y estrellas */
.vz-map{background:rgba(255,255,255,.03)}
.mp-road{position:absolute;background:rgba(255,255,255,.14)}
.mp-road.h1{left:0;right:0;top:34%;height:9px}.mp-road.h2{left:0;right:0;top:68%;height:6px}
.mp-road.v1{top:0;bottom:0;left:28%;width:7px}.mp-road.v2{top:0;bottom:0;left:66%;width:9px}
.mp-pin{position:absolute;left:58%;top:40%;width:22px;height:22px;background:var(--accent);animation:pin-drop 8s var(--ease) infinite;box-shadow:0 14px 26px rgba(0,0,0,.6)}
.mp-pin::after{content:'';position:absolute;left:50%;top:100%;transform:translateX(-50%);border:8px solid transparent;border-top:11px solid var(--accent)}
@keyframes pin-drop{0%,8%{transform:translateY(-140px);opacity:0}16%{transform:translateY(0);opacity:1}20%{transform:translateY(-10px)}24%,88%{transform:translateY(0);opacity:1}96%,100%{opacity:0}}
.mp-ring{position:absolute;left:58%;top:40%;width:22px;height:22px;border:2px solid var(--accent);animation:mp-pulse 8s infinite;animation-delay:1.6s;opacity:0}
@keyframes mp-pulse{0%,20%{opacity:0;transform:scale(1)}24%{opacity:.8}40%,100%{opacity:0;transform:scale(3.4)}}
.mp-stars{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);color:var(--accent);font-size:17px;letter-spacing:5px;opacity:0;animation:wp-build 8s infinite;animation-delay:2.2s}
/* modules: sistema encendiéndose */
.vz-mod{display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:1fr;gap:9px;height:100%;padding:22px 20px;position:relative}
.md-cell{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);animation:mod-on 9s infinite;opacity:.25}
.md-cell.m0{animation-delay:.3s}.md-cell.m1{animation-delay:.9s}.md-cell.m2{animation-delay:1.5s}.md-cell.m3{animation-delay:2.1s}
.md-cell.m5{animation-delay:2.7s}.md-cell.m6{animation-delay:3.3s}.md-cell.m7{animation-delay:3.9s}.md-cell.m8{animation-delay:4.5s}
.md-cell.m4{opacity:0}
@keyframes mod-on{0%{opacity:.25;border-color:rgba(255,255,255,.12)}8%,86%{opacity:1;border-color:rgba(229,57,53,.6);background:rgba(229,57,53,.1)}94%,100%{opacity:.25}}
.md-core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:26%;height:26%;background:var(--accent);animation:px-blink 2.2s steps(2) infinite;box-shadow:0 0 34px rgba(229,57,53,.7)}
/* social: post con corazones */
.soc-scr{position:relative;display:flex;flex-direction:column;padding:14px 12px;gap:10px}
.soc-head{display:flex;align-items:center;gap:8px}
.soc-av{width:26px;height:26px;border-radius:50%;background:var(--accent)}
.soc-user{width:70px;height:9px;background:rgba(255,255,255,.3)}
.soc-img{flex:1;background:linear-gradient(135deg,rgba(229,57,53,.3),rgba(255,255,255,.08));min-height:170px}
.soc-row{display:flex;align-items:center;gap:8px}
.soc-heart{color:var(--accent);font-size:17px;animation:heart-beat 2.2s infinite}
@keyframes heart-beat{0%,100%{transform:scale(1)}12%{transform:scale(1.35)}24%{transform:scale(1)}}
.soc-count{width:52px;height:8px;background:rgba(255,255,255,.3)}
.soc-fly{position:absolute;right:18px;color:var(--accent);font-size:15px;opacity:0;animation:fly-up 5.5s infinite}
.soc-fly.f1{bottom:60px;animation-delay:.4s}.soc-fly.f2{bottom:60px;right:34px;animation-delay:1.6s;font-size:12px}.soc-fly.f3{bottom:60px;right:26px;animation-delay:3s}
@keyframes fly-up{0%{opacity:0;transform:translateY(0) scale(.7)}12%{opacity:1}55%{opacity:1}100%{opacity:0;transform:translateY(-130px) scale(1.25) rotate(14deg)}}
/* empresas que ya lo usan */
.used{margin-top:56px;display:flex;flex-wrap:wrap;gap:12px}
.used-tile{display:flex;align-items:center;gap:16px;padding:22px 26px;background:var(--bg);border:1px solid rgba(0,0,0,.06);min-width:280px;transition:transform .35s var(--ease),box-shadow .45s var(--ease)}
.used-tile:hover{transform:translateY(-4px);box-shadow:var(--sh-md)}
.used-mark{width:44px;height:44px;background:var(--black);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;letter-spacing:-.03em;flex-shrink:0}
.used-name{font-size:17px;font-weight:700;letter-spacing:-.02em}
.used-note{font-family:var(--mono);font-size:10px;letter-spacing:.08em;color:var(--text3);margin-top:3px;text-transform:uppercase}
.used-more{display:flex;align-items:center;padding:22px 26px;border:1px dashed rgba(0,0,0,.18);font-family:var(--mono);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--text3)}
/* secciones */
.p-sec{padding:120px 0}
.p-sec.alt{background:var(--surface)}
.pain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:56px}
.pain{background:var(--bg);border:1px solid rgba(0,0,0,.06);padding:32px 28px;transition:transform .35s var(--ease),box-shadow .45s var(--ease)}
.pain:hover{transform:translateY(-5px);box-shadow:var(--sh-lg)}
.pain .px{width:10px;height:10px;background:var(--accent);margin-bottom:20px}
.pain h3{font-size:18px;font-weight:700;letter-spacing:-.02em;margin-bottom:12px;line-height:1.25}
.pain p{font-size:14px;color:var(--text2);line-height:1.7}
.what-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;margin-top:56px;align-items:start}
.what-text{font-size:17px;line-height:1.8;color:var(--text2)}
.deliv{border-top:1px solid var(--border)}
.deliv-label{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--text3);padding:18px 0 6px}
.deliv-item{display:flex;gap:16px;padding:14px 0;border-bottom:1px solid var(--border);font-size:14.5px;line-height:1.5}
.deliv-item .px{width:8px;height:8px;background:var(--accent);flex-shrink:0;margin-top:7px}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:56px;border-top:1px solid var(--border)}
.step{padding:30px 24px 30px 0;border-right:1px solid var(--border);padding-left:24px}
.step:first-child{padding-left:0}
.step:last-child{border-right:none}
.step-n{font-size:40px;font-weight:700;letter-spacing:-.04em;color:transparent;-webkit-text-stroke:1.2px rgba(10,10,12,.3);line-height:1;margin-bottom:18px}
.step h3{font-size:16px;font-weight:700;letter-spacing:-.015em;margin-bottom:10px}
.step p{font-size:13.5px;color:var(--text2);line-height:1.65}
/* demo chat */
.demo-wrap{margin-top:56px;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.chat{background:var(--black);padding:26px 22px;max-width:440px;margin:0 auto;width:100%;box-shadow:var(--sh-lg);position:relative}
.chat-head{display:flex;align-items:center;gap:12px;padding-bottom:16px;border-bottom:1px solid rgba(255,255,255,.1);margin-bottom:16px}
.chat-av{width:34px;height:34px;background:var(--accent);display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;font-size:13px}
.chat-name{color:#fff;font-size:13px;font-weight:700}
.chat-st{font-family:var(--mono);font-size:9.5px;color:rgba(255,255,255,.45);margin-top:2px}
.chat-body{display:flex;flex-direction:column;gap:10px;min-height:300px}
.msg{max-width:82%;padding:11px 14px;font-size:13px;line-height:1.5;opacity:0;transform:translateY(8px);transition:opacity .35s var(--ease),transform .35s var(--ease)}
.msg.on{opacity:1;transform:none}
.msg.client{align-self:flex-end;background:#fff;color:var(--text)}
.msg.bot{align-self:flex-start;background:rgba(255,255,255,.08);color:#fff;border-left:2px solid var(--accent)}
.typing{align-self:flex-start;display:none;gap:4px;padding:10px 14px;background:rgba(255,255,255,.08)}
.typing.on{display:flex}
.typing i{width:6px;height:6px;background:rgba(255,255,255,.6);animation:tdot 1s infinite}
.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}
@keyframes tdot{0%,100%{opacity:.3;transform:translateY(0)}50%{opacity:1;transform:translateY(-3px)}}
.chat-tag{position:absolute;top:-12px;right:16px;font-family:var(--mono);font-size:9px;letter-spacing:.12em;text-transform:uppercase;background:var(--accent);color:#fff;padding:5px 9px}
.demo-side h2{margin-bottom:18px}
.demo-points{display:flex;flex-direction:column;gap:14px;margin-top:28px}
.demo-points div{display:flex;gap:14px;align-items:flex-start;font-size:14.5px;color:var(--text2);line-height:1.6}
.demo-points .px{width:8px;height:8px;background:var(--accent);flex-shrink:0;margin-top:7px}
.who-grid{display:flex;flex-wrap:wrap;gap:10px;margin-top:48px}
.who{padding:16px 22px;border:1px solid rgba(0,0,0,.1);font-size:14px;font-weight:700;letter-spacing:-.01em;display:inline-flex;align-items:center;gap:11px;transition:all .25s}
.who:hover{border-color:var(--accent);background:var(--accent-pale)}
.who .px{width:8px;height:8px;background:var(--accent)}
.faq{margin-top:48px;border-top:1px solid var(--border)}
.faq details{border-bottom:1px solid var(--border)}
.faq summary{list-style:none;cursor:pointer;padding:22px 0;font-size:17px;font-weight:700;letter-spacing:-.02em;display:flex;justify-content:space-between;align-items:center;gap:20px}
.faq summary::-webkit-details-marker{display:none}
.faq summary .fq-plus{font-family:var(--mono);font-size:18px;color:var(--accent);transition:transform .3s var(--ease)}
.faq details[open] summary .fq-plus{transform:rotate(45deg)}
.faq .fq-a{padding:0 0 22px;font-size:14.5px;color:var(--text2);line-height:1.75;max-width:720px}
.rel-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:56px}
.rel{background:var(--bg);border:1px solid rgba(0,0,0,.06);padding:30px 26px;display:flex;flex-direction:column;gap:12px;min-height:200px;transition:transform .35s var(--ease),box-shadow .45s var(--ease),border-color .3s;position:relative}
.rel:hover{transform:translateY(-5px);box-shadow:var(--sh-lg);border-color:var(--accent)}
.rel .rel-k{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--text3)}
.rel h3{font-size:19px;font-weight:700;letter-spacing:-.025em;line-height:1.15}
.rel p{font-size:13.5px;color:var(--text2);line-height:1.6;flex:1}
.rel .rel-arrow{font-size:18px;color:var(--accent);transition:transform .3s var(--ease)}
.rel:hover .rel-arrow{transform:translateX(5px)}
.rel.next{background:var(--black);color:#fff;border-color:transparent;grid-column:span 3;flex-direction:row;align-items:center;gap:30px;min-height:0;padding:40px 44px}
.rel.next .rel-k{color:var(--accent)}
.rel.next h3{font-size:clamp(22px,2.6vw,32px)}
.rel.next p{color:rgba(255,255,255,.55);flex:1}
.rel.next .nx-box{width:14px;height:14px;background:var(--accent);flex-shrink:0;animation:px-blink 2.2s steps(2) infinite}
.p-band{padding:0 0 140px}
.p-band .cta-band{display:flex}
@media(max-width:960px){
  .p-grid,.what-grid,.demo-wrap{grid-template-columns:1fr;gap:36px}
  .p-cube-wrap{min-height:260px;order:-1}.p-cube{--cs:160px;--half:80px}
  .p-visual{min-height:400px;order:-1}.ph3d-scene{transform:scale(.74)!important;height:400px}
  .used-tile{min-width:0;width:100%}
  .pain-grid,.rel-grid{grid-template-columns:1fr}
  .rel.next{grid-column:span 1;flex-direction:column;align-items:flex-start}
  .steps{grid-template-columns:1fr 1fr}
  .step{border-right:none;border-bottom:1px solid var(--border);padding-left:0}
}
@media(max-width:640px){
  .p-hero{padding:110px 0 70px}.p-sec{padding:76px 0}
  .steps{grid-template-columns:1fr}
  .p-ctas{flex-direction:column}.p-ctas .btn-primary,.p-ctas .btn-ghost{width:100%;text-align:center}
  .chat-body{min-height:260px}
}
</style>
</head>
<body>
<div id="progress"></div>
<div id="cursor"><div id="cursor-ring"><span id="cursor-text"></span></div><div id="cursor-dot"></div></div>

<nav id="nav" class="dark-zone">
  <a class="nav-logo" href="/">BIE</a>
  <div class="nav-links">
    <a href="/#work" class="nav-link" data-i18n="nav_work">{es('nav_work')}</a>
    <a href="/#catalog" class="nav-link" data-i18n="nav_catalog">{es('nav_catalog')}</a>
    <a href="/#community" class="nav-link" data-i18n="nav_comm">{es('nav_comm')}</a>
    <button id="lang-toggle">EN</button>
    <a href="/#contact" class="nav-cta"><span data-i18n="nav_cta">{es('nav_cta')}</span></a>
    <button id="burger" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
</nav>
<div id="mobile-menu">
  <a href="/#work" class="mm-link"><span data-i18n="nav_work">{es('nav_work')}</span><span class="mm-arrow">→</span></a>
  <a href="/#catalog" class="mm-link"><span data-i18n="nav_catalog">{es('nav_catalog')}</span><span class="mm-arrow">→</span></a>
  <a href="/#community" class="mm-link"><span data-i18n="nav_comm">{es('nav_comm')}</span><span class="mm-arrow">→</span></a>
  <a href="/#contact" class="mm-link"><span data-i18n="nav_contact">{es('nav_contact')}</span><span class="mm-arrow">→</span></a>
  <a id="mm-wa" href={wa(p.waMessage.es)} class="mm-cta" data-i18n="mm_cta">{es('mm_cta')}</a>
</div>

<canvas id="fab-px"></canvas>
<div id="wa-bubble"><span class="wb-px"></span><span id="wa-bubble-text"></span></div>
<button id="wa-fab" aria-label="WhatsApp">
  <span class="wa-float"><span class="wa-cube">
    <span class="wa-face f"><span class="wa-edge"></span></span><span class="wa-face b"><span class="wa-edge"></span></span>
    <span class="wa-face r"><span class="wa-edge"></span></span><span class="wa-face l"><span class="wa-edge"></span></span>
    <span class="wa-face t"></span><span class="wa-face d"></span>
  </span></span>
  <span class="fab-x">×</span>
</button>
<div id="wa-widget">
  <div class="waw-head">
    <div class="waw-avatar">B</div>
    <div class="waw-head-info">
      <div class="waw-name" data-i18n="waw_name">{es('waw_name')}</div>
      <div class="waw-status"><span class="waw-status-dot"></span><span data-i18n="waw_status">{es('waw_status')}</span></div>
    </div>
  </div>
  <div class="waw-body">
    <div class="waw-bubble" data-i18n="waw_bubble" set:html={es('waw_bubble')}></div>
    <div class="waw-opts" id="waw-opts"></div>
  </div>
  <div class="waw-foot" data-i18n="waw_foot">{es('waw_foot')}</div>
</div>

<!-- HERO DEL PRODUCTO -->
<section class="p-hero">
  <div class="p-hero-grid"></div>
  <div class="section-inner">
    <div class="bc">
      <a href="/" data-i18n="bc_home">{es('bc_home')}</a><span class="bc-sep"></span>
      <a href="/#catalog" data-i18n="bc_cat">{es('bc_cat')}</a><span class="bc-sep"></span>
      <span><span data-i18n="phase_w">{es('phase_w')}</span> {p.phase.num} · <span data-i18n="phase">{es('phase')}</span></span>
    </div>
    <div class="p-grid">
      <div>
        <p class="p-kicker" data-i18n="name">{es('name')}</p>
        <h1 class="p-h1" data-i18n="h1" set:html={es('h1')}></h1>
        <p class="p-sub" data-i18n="sub">{es('sub')}</p>
        <div class="p-ctas">
          <a href={wa(p.waMessage.es)} target="_blank" rel="noopener" class="btn-primary wa-buy"><span data-i18n="cta_buy">{es('cta_buy')}</span></a>
          <a href={wa(p.waMessage.es)} target="_blank" rel="noopener" class="btn-ghost wa-diag" data-i18n="cta_diag">{es('cta_diag')}</a>
        </div>
        <p class="p-trust"><span data-i18n="trust">{es('trust')}</span> · <a href="#como" data-i18n="cta_how" style="color:#fff;text-decoration:underline;text-underline-offset:3px">{es('cta_how')}</a></p>
      </div>
      {p.visual === 'chat' ? (
      <div class="p-visual">
        <div class="ph3d-scene" id="ph3d-scene">
          <div class="ph3d-shadow"></div>
          <div class="ph3d">
            <div class="ph3d-screen">
              <div class="ph3d-head"><span class="ph3d-av">B</span><span><b data-i18n="ph_name">{es('ph_name')}</b><i data-i18n="ph_st">{es('ph_st')}</i></span></div>
              <div class="ph3d-body">
                <div class="pb client" data-i18n="demo0">{p.demo[0].text.es}</div>
                <div class="pb bot" data-i18n="demo1">{p.demo[1].text.es}</div>
                <div class="pb client" data-i18n="demo2">{p.demo[2].text.es}</div>
                <div class="pb bot" data-i18n="demo3">{p.demo[3].text.es}</div>
              </div>
            </div>
          </div>
          {(p.chips || []).map((c, i) => (<div class={`ph3d-chip c${i}`}><span class="px"></span><span data-i18n={`chip${i}`}>{c.es}</span></div>))}
        </div>
      </div>
      ) : p.visual === 'web' ? (
      <div class="p-visual">
        <div class="ph3d-scene" id="ph3d-scene">
          <div class="ph3d-shadow" style="width:300px"></div>
          <div class="web3d">
            <div class="web3d-bar"><span class="wb-dot"></span><span class="wb-dot"></span><span class="wb-dot"></span><span class="wb-url">tuempresa.com</span></div>
            <div class="web3d-page">
              <div class="wp el e1"></div>
              <div class="wp el e2"></div>
              <div class="wp el e3"></div>
              <div class="wp btn e4"></div>
              <div class="wp img e5"></div>
              <div class="wp card e6"></div>
              <div class="wp card e7"></div>
            </div>
          </div>
          {(p.chips || []).map((c, i) => (<div class={`ph3d-chip c${i}`}><span class="px"></span><span data-i18n={`chip${i}`}>{c.es}</span></div>))}
        </div>
      </div>
      ) : p.visual === 'hub' ? (
      <div class="p-visual">
        <div class="ph3d-scene" id="ph3d-scene">
          <div class="ph3d-shadow"></div>
          <div class="ph3d">
            <div class="ph3d-screen hub-scr">
              <span class="hub-av"></span>
              <b class="hub-name">@tumarca</b>
              <span class="wp hub-btn h1"></span>
              <span class="wp hub-btn h2 tap"></span>
              <span class="wp hub-btn h3"></span>
              <span class="wp hub-btn h4"></span>
            </div>
          </div>
          {(p.chips || []).map((c, i) => (<div class={`ph3d-chip c${i}`}><span class="px"></span><span data-i18n={`chip${i}`}>{c.es}</span></div>))}
        </div>
      </div>
      ) : p.visual === 'crm' ? (
      <div class="p-visual">
        <div class="ph3d-scene" id="ph3d-scene">
          <div class="ph3d-shadow" style="width:300px"></div>
          <div class="web3d">
            <div class="web3d-bar"><span class="wb-dot"></span><span class="wb-dot"></span><span class="wb-dot"></span><span class="wb-url">crm.tuempresa.com</span></div>
            <div class="crm-page">
              <div class="crm-col"><i class="crm-h" data-i18n="crm_c1">{es('crm_c1')}</i><span class="crm-card"></span><span class="crm-card"></span></div>
              <div class="crm-col"><i class="crm-h" data-i18n="crm_c2">{es('crm_c2')}</i><span class="crm-card"></span></div>
              <div class="crm-col win"><i class="crm-h" data-i18n="crm_c3">{es('crm_c3')}</i><span class="crm-card"></span></div>
              <span class="crm-move"><b>92</b></span>
            </div>
          </div>
          {(p.chips || []).map((c, i) => (<div class={`ph3d-chip c${i}`}><span class="px"></span><span data-i18n={`chip${i}`}>{c.es}</span></div>))}
        </div>
      </div>
      ) : p.visual === 'flow' ? (
      <div class="p-visual">
        <div class="ph3d-scene" id="ph3d-scene">
          <div class="ph3d-shadow" style="width:300px"></div>
          <div class="web3d flow-frame">
            <div class="web3d-bar"><span class="wb-dot"></span><span class="wb-dot"></span><span class="wb-dot"></span><span class="wb-url">make · flujo activo</span></div>
            <div class="flow-page">
              <div class="flow-track">
                <span class="flow-node n1">⚡</span><span class="flow-line l1"></span>
                <span class="flow-node n2"></span><span class="flow-line l2"></span>
                <span class="flow-node n3"></span><span class="flow-line l3"></span>
                <span class="flow-node n4 ok">✓</span>
                <span class="flow-dot"></span>
              </div>
              <div class="flow-logs">
                <span class="wp flow-log f1" data-i18n="fl_1">{es('fl_1')}</span>
                <span class="wp flow-log f2" data-i18n="fl_2">{es('fl_2')}</span>
                <span class="wp flow-log f3" data-i18n="fl_3">{es('fl_3')}</span>
              </div>
            </div>
          </div>
          {(p.chips || []).map((c, i) => (<div class={`ph3d-chip c${i}`}><span class="px"></span><span data-i18n={`chip${i}`}>{c.es}</span></div>))}
        </div>
      </div>
      ) : p.visual === 'commerce' ? (
      <div class="p-visual">
        <div class="ph3d-scene" id="ph3d-scene">
          <div class="ph3d-shadow"></div>
          <div class="ph3d">
            <div class="ph3d-screen com-scr">
              <div class="ph3d-head"><span class="ph3d-av">B</span><span><b data-i18n="ph_name">{es('ph_name')}</b><i data-i18n="com_st">{es('com_st')}</i></span></div>
              <div class="com-grid">
                <span class="wp com-p p1"><i></i><em></em></span>
                <span class="wp com-p p2 pick"><i></i><em></em></span>
                <span class="wp com-p p3"><i></i><em></em></span>
                <span class="wp com-p p4"><i></i><em></em></span>
              </div>
              <div class="wp com-order" data-i18n="com_order">{es('com_order')}</div>
            </div>
          </div>
          {(p.chips || []).map((c, i) => (<div class={`ph3d-chip c${i}`}><span class="px"></span><span data-i18n={`chip${i}`}>{c.es}</span></div>))}
        </div>
      </div>
      ) : ['scan','radar','market','calendar','serp','map','modules'].includes(p.visual) ? (
      <div class="p-visual">
        <div class="ph3d-scene" id="ph3d-scene">
          <div class="ph3d-shadow" style="width:300px"></div>
          <div class="web3d">
            <div class="web3d-bar"><span class="wb-dot"></span><span class="wb-dot"></span><span class="wb-dot"></span><span class="wb-url">{p.visual === 'serp' ? 'google.com' : p.visual === 'map' ? 'maps.google.com' : 'bie · ' + p.slug}</span></div>
            {p.visual === 'scan' && (<div class="vz vz-scan"><span class="sc-logo">M</span><span class="sc-row" style="width:82%"></span><span class="sc-row" style="width:64%"></span><span class="sc-row" style="width:74%"></span><span class="sc-score s1">A</span><span class="sc-score s2">B+</span><span class="sc-beam"></span></div>)}
            {p.visual === 'radar' && (<div class="vz vz-radar"><span class="rd-x"></span><span class="rd-y"></span><span class="rd-dot d1"></span><span class="rd-dot d2"></span><span class="rd-dot d3"></span><span class="rd-dot d4"></span><span class="rd-dot you"></span><span class="rd-gap"></span></div>)}
            {p.visual === 'market' && (<div class="vz vz-market"><span class="mk-bar b1"><i></i></span><span class="mk-bar b2"><i></i></span><span class="mk-bar b3"><i></i></span><span class="mk-lab l1">TAM</span><span class="mk-lab l2">SAM</span><span class="mk-lab l3">SOM</span></div>)}
            {p.visual === 'calendar' && (<div class="vz vz-cal">{Array.from({length:20}).map((_,i)=>(<span class={`cl-cell c${i%7} q${i%5}`}></span>))}</div>)}
            {p.visual === 'serp' && (<div class="vz vz-serp"><span class="sp-search"></span><span class="sp-res r1"></span><span class="sp-res r2"></span><span class="sp-res you"><i></i></span></div>)}
            {p.visual === 'map' && (<div class="vz vz-map"><span class="mp-road h1"></span><span class="mp-road h2"></span><span class="mp-road v1"></span><span class="mp-road v2"></span><span class="mp-pin"></span><span class="mp-stars">★★★★★</span><span class="mp-ring"></span></div>)}
            {p.visual === 'modules' && (<div class="vz vz-mod">{Array.from({length:9}).map((_,i)=>(<span class={`md-cell m${i}`}></span>))}<span class="md-core"></span></div>)}
          </div>
          {(p.chips || []).map((c, i) => (<div class={`ph3d-chip c${i}`}><span class="px"></span><span data-i18n={`chip${i}`}>{c.es}</span></div>))}
        </div>
      </div>
      ) : p.visual === 'social' ? (
      <div class="p-visual">
        <div class="ph3d-scene" id="ph3d-scene">
          <div class="ph3d-shadow"></div>
          <div class="ph3d">
            <div class="ph3d-screen soc-scr">
              <div class="soc-head"><span class="soc-av"></span><span class="soc-user"></span></div>
              <div class="soc-img"></div>
              <div class="soc-row"><span class="soc-heart">♥</span><span class="soc-count"></span></div>
              <span class="soc-fly f1">♥</span><span class="soc-fly f2">♥</span><span class="soc-fly f3">♥</span>
            </div>
          </div>
          {(p.chips || []).map((c, i) => (<div class={`ph3d-chip c${i}`}><span class="px"></span><span data-i18n={`chip${i}`}>{c.es}</span></div>))}
        </div>
      </div>
      ) : p.visual === 'os' ? (
      <div class="p-visual">
        <div class="ph3d-scene" id="ph3d-scene">
          <div class="ph3d-shadow" style="width:300px"></div>
          <div class="web3d">
            <div class="web3d-bar"><span class="wb-dot"></span><span class="wb-dot"></span><span class="wb-dot"></span><span class="wb-url">panel.tuempresa.com</span></div>
            <div class="web3d-page os-page">
              <div class="wp os-kpis e1"><span class="os-kpi"><b>128</b><i data-i18n="os_k1">{es('os_k1')}</i></span><span class="os-kpi"><b>36</b><i data-i18n="os_k2">{es('os_k2')}</i></span><span class="os-kpi"><b>92%</b><i data-i18n="os_k3">{es('os_k3')}</i></span></div>
              <div class="wp os-bars e2"><i style="height:38%"></i><i style="height:64%"></i><i style="height:50%"></i><i style="height:82%"></i><i style="height:68%"></i><i style="height:100%"></i><i style="height:74%"></i></div>
              <div class="wp os-row e3"></div>
              <div class="wp os-row e4" style="width:78%"></div>
              <div class="wp os-row e5" style="width:64%"></div>
            </div>
          </div>
          {(p.chips || []).map((c, i) => (<div class={`ph3d-chip c${i}`}><span class="px"></span><span data-i18n={`chip${i}`}>{c.es}</span></div>))}
        </div>
      </div>
      ) : p.visual === 'brand' ? (
      <div class="p-visual">
        <div class="ph3d-scene" id="ph3d-scene">
          <div class="ph3d-shadow" style="width:300px"></div>
          <div class="brand3d">
            <div class="wp bd-logo e1">TU<br/>MARCA</div>
            <div class="wp bd-swatches e2"><i style="background:#E53935"></i><i style="background:#070709"></i><i style="background:#fff;border:1px solid rgba(255,255,255,.4)"></i><i style="background:#a1a1a6"></i></div>
            <div class="wp bd-type e3"><b>Aa</b><span><i style="width:90%"></i><i style="width:70%"></i><i style="width:52%"></i></span></div>
            <div class="wp bd-apps e4"><i></i><i></i><i></i></div>
          </div>
          {(p.chips || []).map((c, i) => (<div class={`ph3d-chip c${i}`}><span class="px"></span><span data-i18n={`chip${i}`}>{c.es}</span></div>))}
        </div>
      </div>
      ) : (
      <div class="p-cube-wrap">
        <div class="p-cube">
          <div class="hc f"></div><div class="hc b"></div><div class="hc r"></div><div class="hc l"></div><div class="hc t"></div><div class="hc d"></div>
        </div>
      </div>
      )}
    </div>
  </div>
</section>

<!-- DOLOR -->
<section class="p-sec">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="pain_label">{es('pain_label')}</p>
      <h2 class="section-h2" data-i18n="pain_h2" set:html={es('pain_h2')}></h2>
    </div>
    <div class="pain-grid">
      {p.pains.map((x, i) => (
        <div class={`pain reveal d${i + 1}`}><div class="px"></div><h3 data-i18n={`pain${i}_t`}>{x.title.es}</h3><p data-i18n={`pain${i}_b`}>{x.body.es}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- QUÉ ES + ENTREGABLES -->
<section class="p-sec alt">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="what_label">{es('what_label')}</p>
      <h2 class="section-h2" data-i18n="what_h2" set:html={es('what_h2')}></h2>
    </div>
    <div class="what-grid">
      <p class="what-text reveal d1" data-i18n="what">{es('what')}</p>
      <div class="deliv reveal d2">
        <div class="deliv-label" data-i18n="deliv_label">{es('deliv_label')}</div>
        {p.deliverables.map((x, i) => (<div class="deliv-item"><span class="px"></span><span data-i18n={`del${i}`}>{x.es}</span></div>))}
      </div>
    </div>
  </div>
</section>

<!-- CÓMO TRABAJAMOS -->
<section class="p-sec" id="como">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="how_label">{es('how_label')}</p>
      <h2 class="section-h2" data-i18n="how_h2" set:html={es('how_h2')}></h2>
    </div>
    <div class="steps reveal d1">
      {p.steps.map((x, i) => (
        <div class="step"><div class="step-n">0{i + 1}</div><h3 data-i18n={`step${i}_t`}>{x.title.es}</h3><p data-i18n={`step${i}_b`}>{x.body.es}</p></div>
      ))}
    </div>
  </div>
</section>

{hasDemo && (
<!-- DEMO -->
<section class="p-sec alt">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="demo_label">{es('demo_label')}</p>
      <h2 class="section-h2" data-i18n="demo_h2" set:html={es('demo_h2')}></h2>
    </div>
    <div class="demo-wrap">
      <div class="chat reveal d1" id="chat">
        <span class="chat-tag" data-i18n="demo_tag">{es('demo_tag')}</span>
        <div class="chat-head"><div class="chat-av">B</div><div><div class="chat-name">Asistente · Tu empresa</div><div class="chat-st">WhatsApp Business</div></div></div>
        <div class="chat-body" id="chat-body">
          {p.demo.map((m, i) => (<div class={`msg ${m.from}`} data-i="{i}" data-i18n={`demo${i}`}>{m.text.es}</div>))}
          <div class="typing" id="typing"><i></i><i></i><i></i></div>
        </div>
      </div>
      <div class="demo-side reveal d2">
        <div class="demo-points">
          <div><span class="px"></span><span data-i18n="del1">{p.deliverables[1].es}</span></div>
          <div><span class="px"></span><span data-i18n="del2">{p.deliverables[2].es}</span></div>
          <div><span class="px"></span><span data-i18n="del3">{p.deliverables[3].es}</span></div>
        </div>
      </div>
    </div>
  </div>
</section>
)}

{(p.usedBy && p.usedBy.length > 0) && (
<!-- YA LO USAN -->
<section class="p-sec">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="used_label">{es('used_label')}</p>
      <h2 class="section-h2" data-i18n="used_h2" set:html={es('used_h2')}></h2>
    </div>
    <div class="used reveal d1">
      {p.usedBy.map((u, i) => (
        <a class="used-tile" href="/#work"><span class="used-mark">{u.name.slice(0, 1)}</span><span><span class="used-name">{u.name}</span><span class="used-note" data-i18n={`used${i}`}>{u.note.es}</span></span></a>
      ))}
      <span class="used-more" data-i18n="used_more">{es('used_more')}</span>
    </div>
  </div>
</section>
)}

<!-- PARA QUIÉN -->
<section class="p-sec alt">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="who_label">{es('who_label')}</p>
      <h2 class="section-h2" data-i18n="who_h2" set:html={es('who_h2')}></h2>
    </div>
    <div class="who-grid reveal d1">
      {p.forWhom.map((x, i) => (<span class="who"><span class="px"></span><span data-i18n={`who${i}`}>{x.es}</span></span>))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="p-sec">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="faq_label">{es('faq_label')}</p>
      <h2 class="section-h2" data-i18n="faq_h2" set:html={es('faq_h2')}></h2>
    </div>
    <div class="faq reveal d1">
      {p.faq.map((f, i) => (
        <details><summary><span data-i18n={`faq${i}_q`}>{f.q.es}</span><span class="fq-plus">+</span></summary><div class="fq-a" data-i18n={`faq${i}_a`}>{f.a.es}</div></details>
      ))}
    </div>
  </div>
</section>

<!-- INTERCONEXIÓN -->
<section class="p-sec alt">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label" data-i18n="rel_label">{es('rel_label')}</p>
      <h2 class="section-h2" data-i18n="rel_h2" set:html={es('rel_h2')}></h2>
    </div>
    <div class="rel-grid">
      {p.related.map((r, i) => (
        <a class={`rel reveal d${i + 1}`} href={rhref(r.slug)} title={SLUGS.has(r.slug) ? undefined : es('soon')}><span class="rel-k" data-i18n="rel_label">{es('rel_label')}</span><h3 data-i18n={`rel${i}_n`}>{r.name.es}</h3><p data-i18n={`rel${i}_w`}>{r.why.es}</p><span class="rel-arrow">→</span></a>
      ))}
      <a class="rel next reveal d4" href={rhref(p.next.slug)} title={SLUGS.has(p.next.slug) ? undefined : es('soon')}>
        <span class="nx-box"></span>
        <div style="flex:1"><span class="rel-k" data-i18n="next_label">{es('next_label')}</span><h3 data-i18n="next_n">{p.next.name.es}</h3><p data-i18n="next_w">{p.next.why.es}</p></div>
        <span class="rel-arrow">→</span>
      </a>
    </div>
  </div>
</section>

{ci >= 0 && (
<!-- CADENA: anterior / siguiente -->
<section class="p-sec" style="padding-top:0;padding-bottom:0">
  <div class="section-inner">
    <div class="chain-bar">
      {prev ? (
        <a class="chain-cell" href={chainHref(prev.slug)}><span class="chain-k">← <span data-i18n="ch_prev">{es('ch_prev')}</span></span><span class="chain-n" data-i18n="ch_prev_n">{prev.name.es}</span></a>
      ) : (<span class="chain-cell empty"></span>)}
      <span class="chain-pos" data-i18n="ch_pos">{es('ch_pos')}</span>
      {nextP ? (
        <a class="chain-cell nxt" href={chainHref(nextP.slug)}><span class="chain-k"><span data-i18n="ch_next">{es('ch_next')}</span> →</span><span class="chain-n" data-i18n="ch_next_n">{nextP.name.es}</span></a>
      ) : (<span class="chain-cell empty"></span>)}
    </div>
  </div>
</section>
)}

{prev && (<a class="chain-arrow left" href={chainHref(prev.slug)} aria-label={prev.name.es}><span class="ca-tip" data-i18n="ch_prev_n">{prev.name.es}</span>←</a>)}
{nextP && (<a class="chain-arrow right" href={chainHref(nextP.slug)} aria-label={nextP.name.es}><span class="ca-tip" data-i18n="ch_next_n">{nextP.name.es}</span>→</a>)}

<!-- CTA -->
<section class="p-band">
  <div class="section-inner">
    <a href={wa(p.waMessage.es)} target="_blank" rel="noopener" class="cta-band wa-buy">
      <div class="band-px"></div>
      <div class="band-text" data-i18n="band_t" set:html={es('band_t')}></div>
      <span class="band-btn"><span data-i18n="band_btn">{es('band_btn')}</span> →</span>
    </a>
  </div>
</section>

<footer>
  <div class="footer-inner">
    <div class="footer-mark">BIE<span class="fm-px"></span></div>
    <div class="footer-bottom">
      <span class="footer-text">BUSINESS INTELLIGENCE ENHANCER</span>
      <span class="footer-text">businessintelligence.solutions</span>
      <span class="footer-text">© 2026 · ECUADOR</span>
    </div>
  </div>
</footer>

<script is:inline define:vars={{ T, WAW_OPTS, BUBBLES, WA, SLUG: p.slug, PNAME: p.name }}>
function RAF(cb){ let c=false; const w=t=>{ if(c)return; c=true; cb(t); }; requestAnimationFrame(w); setTimeout(()=>w(performance.now()),28); }
let lang='es';
const wa=m=>`https://wa.me/${WA}?text=${encodeURIComponent(m)}`;
// Trazabilidad: toda conversación que nace en esta página lleva su origen. Formato fijo para poder contar por producto.
// Si llegó por un cuadrado de la home o por un producto relacionado, ?src= lo registra como "vía".
const SRC=(()=>{const m=new URLSearchParams(location.search).get('src');return m&&/^[a-z0-9-]{1,40}$/.test(m)?m:null})();
const origin=()=>`\n\n— Origen: web/producto/${SLUG}/${lang}`+(SRC?` · vía ${SRC}`:'');
const MSG={
  buy:{ es:n=>`Hola, quiero contratar "${n}" para mi empresa. ¿Cómo empezamos?`, en:n=>`Hi, I want to hire "${n}" for my company. How do we start?` },
  diag:{ es:n=>`Hola, quiero mi diagnóstico gratuito de 30 minutos. Me interesa "${n}".`, en:n=>`Hi, I want my free 30-minute diagnosis. I am interested in "${n}".` },
};
function applyLang(){
  document.documentElement.lang=lang;
  document.querySelectorAll('[data-i18n]').forEach(el=>{ const v=T[el.dataset.i18n]; if(v) el.innerHTML=v[lang]; });
  document.getElementById('lang-toggle').textContent=lang==='es'?'EN':'ES';
  document.querySelectorAll('.wa-buy').forEach(a=>a.href=wa(MSG.buy[lang](PNAME[lang])+origin()));
  document.querySelectorAll('.wa-diag, #mm-wa').forEach(a=>a.href=wa(MSG.diag[lang](PNAME[lang])+origin()));
  document.getElementById('waw-opts').innerHTML=WAW_OPTS.map(o=>`<a class="waw-opt" href="${wa(o.m[lang]+origin())}" target="_blank"><span class="waw-opt-px"></span>${o.t[lang]}</a>`).join('');
}
document.getElementById('lang-toggle').addEventListener('click',()=>{ lang=lang==='es'?'en':'es'; applyLang(); });
applyLang();
document.body.classList.add('past-hero');
// cadena con teclado: ← anterior, → siguiente
document.addEventListener('keydown',e=>{ if(e.target.closest('input,textarea,select'))return;
  if(e.key==='ArrowRight'){ const a=document.querySelector('.chain-arrow.right'); if(a) location.href=a.href; }
  if(e.key==='ArrowLeft'){ const a=document.querySelector('.chain-arrow.left'); if(a) location.href=a.href; } });

// nav
const nav=document.getElementById('nav'), progress=document.getElementById('progress');
const heroEl=document.querySelector('.p-hero');
window.addEventListener('scroll',()=>{ const sc=(document.scrollingElement||document.documentElement).scrollTop; nav.classList.toggle('scrolled',sc>40);
  progress.style.width=(sc/((document.scrollingElement||document.documentElement).scrollHeight-innerHeight)*100)+'%';
  nav.classList.toggle('dark-zone', heroEl.getBoundingClientRect().bottom>66); },{passive:true});
// menú móvil
const burger=document.getElementById('burger'), mm=document.getElementById('mobile-menu');
burger.addEventListener('click',()=>{ const o=!mm.classList.contains('open'); mm.classList.toggle('open',o); burger.classList.toggle('open',o); document.body.style.overflow=o?'hidden':''; });
mm.addEventListener('click',e=>{ if(e.target.closest('a')){ mm.classList.remove('open'); burger.classList.remove('open'); document.body.style.overflow=''; } });
// scroll suave interno
function smoothTo(sel){ const el=document.querySelector(sel); if(!el)return; const s=document.scrollingElement||document.documentElement; const a=s.scrollTop, b=el.getBoundingClientRect().top+a-70, t0=performance.now(); (function st(tm){ const p=Math.min((tm-t0)/750,1); s.scrollTop=a+(b-a)*(1-Math.pow(1-p,3)); if(p<1)RAF(st); })(t0); }
document.addEventListener('click',e=>{ const a=e.target.closest('a[href^="#"]'); if(!a)return; const h=a.getAttribute('href'); if(h.length>1&&document.querySelector(h)){ e.preventDefault(); smoothTo(h); } });
// reveal
const obs=new IntersectionObserver(es=>es.forEach(e=>{ if(e.isIntersecting) e.target.classList.add('in'); }),{threshold:.1});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));
// cursor
(function(){ if(matchMedia('(pointer:coarse)').matches)return; const cur=document.getElementById('cursor'); let tx=-100,ty=-100,x=-100,y=-100;
  document.addEventListener('mousemove',e=>{ tx=e.clientX; ty=e.clientY; const link=e.target.closest('a, button, select, summary, .who'); cur.classList.toggle('hov',!!link); cur.classList.toggle('dark',!!e.target.closest('.p-hero, .chat, .rel.next, .cta-band, .waw-head')); });
  (function loop(){ x+=(tx-x)*.2; y+=(ty-y)*.2; cur.style.transform=`translate(${x}px,${y}px)`; RAF(loop); })(); })();
// magnéticos
(function(){ if(matchMedia('(pointer:coarse)').matches)return; document.addEventListener('mousemove',e=>{ document.querySelectorAll('.btn-primary, .nav-cta, #wa-fab').forEach(b=>{ const r=b.getBoundingClientRect(); const dx=e.clientX-(r.left+r.width/2), dy=e.clientY-(r.top+r.height/2); const d=Math.hypot(dx,dy); b.style.translate = d<110 ? `${dx/d*(110-d)/110*7}px ${dy/d*(110-d)/110*7}px` : ''; }); }); })();
// cubo flotante + widget + burbujas + partículas
const waFab=document.getElementById('wa-fab'), waWidget=document.getElementById('wa-widget');
waFab.addEventListener('click',()=>{ const o=!waWidget.classList.contains('open'); waWidget.classList.toggle('open',o); waFab.classList.toggle('open',o); });
document.addEventListener('click',e=>{ if(!waWidget.classList.contains('open'))return; if(e.target.closest('#wa-widget')||e.target.closest('#wa-fab'))return; waWidget.classList.remove('open'); waFab.classList.remove('open'); });
(function(){ const b=document.getElementById('wa-bubble'), txt=document.getElementById('wa-bubble-text'); let i=0;
  function show(){ if(waWidget.classList.contains('open'))return; txt.textContent=BUBBLES[lang][i%BUBBLES[lang].length]; i++; b.classList.add('on'); setTimeout(()=>b.classList.remove('on'),4200); }
  setTimeout(show,5000); setInterval(show,14000); b.addEventListener('click',()=>{ b.classList.remove('on'); waFab.click(); }); })();
(function(){ const cv=document.getElementById('fab-px'), ctx=cv.getContext('2d'), DPR=Math.min(devicePixelRatio,2); cv.width=190*DPR; cv.height=190*DPR; let px=[];
  const spawn=()=>({a:Math.random()*Math.PI*2,r:78+Math.random()*16,spd:.55+Math.random()*.75,red:Math.random()<.3,s:(2+Math.random()*2.4)*DPR});
  for(let i=0;i<22;i++){ const p=spawn(); p.r=20+Math.random()*74; px.push(p); }
  function tick(){ ctx.clearRect(0,0,cv.width,cv.height); const fr=waFab.getBoundingClientRect(), cr=cv.getBoundingClientRect(); const c={x:(fr.left+fr.width/2-cr.left)*DPR,y:(fr.top+fr.height/2-6-cr.top)*DPR}; const open=waFab.classList.contains('open');
    for(const p of px){ p.r-=p.spd; p.a+=.012; if(p.r<9) Object.assign(p,spawn()); const x=c.x+Math.cos(p.a)*p.r*DPR, y=c.y+Math.sin(p.a)*p.r*DPR*.9; const near=1-Math.min(p.r/90,1); const al=open?0:(.15+near*.7); ctx.fillStyle=p.red?`rgba(229,57,53,${al})`:`rgba(10,10,12,${al*.8})`; const s=p.s*(.5+near*.8); ctx.fillRect(Math.round(x/s)*s,Math.round(y/s)*s,s,s); }
    RAF(tick); }
  if(!matchMedia('(prefers-reduced-motion: reduce)').matches) tick(); })();
// teléfono 3D: se endereza, se eleva y gira suave al hacer scroll
(function(){ const sc3=document.getElementById('ph3d-scene'); if(!sc3||matchMedia('(pointer:coarse)').matches)return; const hero=document.querySelector('.p-hero');
  function upd(){ const s=(document.scrollingElement||document.documentElement).scrollTop; const p=Math.min(Math.max(s/(hero.offsetHeight*.8),0),1);
    sc3.style.transform=`rotateY(${-22+p*30}deg) rotateX(${8-p*14}deg) translateY(${-p*60}px) translateZ(${p*40}px)`; sc3.style.opacity=String(1-p*.35); }
  window.addEventListener('scroll',upd,{passive:true}); upd(); })();
// demo chat: aparece mensaje a mensaje cuando entra en pantalla, y se repite
(function(){ const body=document.getElementById('chat-body'); if(!body) return; const msgs=[...body.querySelectorAll('.msg')]; const typing=document.getElementById('typing'); let started=false;
  function run(){ msgs.forEach(m=>m.classList.remove('on')); let i=0;
    (function next(){ if(i>=msgs.length){ setTimeout(run,4500); return; } const m=msgs[i]; const isBot=m.classList.contains('bot');
      if(isBot){ typing.classList.add('on'); body.appendChild(typing); setTimeout(()=>{ typing.classList.remove('on'); m.classList.add('on'); i++; setTimeout(next,1100); },1200); }
      else { m.classList.add('on'); i++; setTimeout(next,1300); } })(); }
  new IntersectionObserver(es=>{ if(es[0].isIntersecting&&!started){ started=true; run(); } },{threshold:.3}).observe(body); })();
</script>
</body>
</html>
