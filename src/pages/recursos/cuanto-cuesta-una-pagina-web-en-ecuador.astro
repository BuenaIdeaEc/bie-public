    author: { '@type': 'Organization', name: 'BIE — Business Intelligence Enhancer', url: SITE },
    publisher: { '@type': 'Organization', name: 'BIE — Business Intelligence Enhancer', logo: { '@type': 'ImageObject', url: `${SITE}/icons/logo.svg` } },
