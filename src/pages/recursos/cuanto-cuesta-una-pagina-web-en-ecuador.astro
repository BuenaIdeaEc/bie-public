// BIE — Artículo 1 del plan de posicionamiento (aprobado por EGO el 2026-10-21).
// Búsqueda objetivo: "cuánto cuesta una página web en Ecuador" / "precio página web Ecuador 2026".
// Regla: ningún precio inventado. Los de terceros son los publicados en sus propios sitios en octubre de 2026,
// con enlace; los de BIE son los de la ficha /productos/pagina-web/. Fuentes en General Brain/03-LINEA-A.
import '../../styles/site.css';

const SITE = 'https://businessintelligence.solutions';
const url = `${SITE}/recursos/cuanto-cuesta-una-pagina-web-en-ecuador/`;
const title = 'Cuánto cuesta una página web en Ecuador en 2026: precios reales y qué incluye';
const description = 'Precios publicados por agencias de Quito y Guayaquil (USD 250 a USD 2.000), lo que cuesta hacerla uno mismo, qué incluye cada opción, los costos ocultos y cuándo conviene cada camino. Con tabla comparativa y preguntas frecuentes.';
const wa = (m: string) => `https://wa.me/593988253030?text=${encodeURIComponent(m + '\n\n— Origen: web/recursos/cuanto-cuesta-pagina-web/es')}`;
const PUB = '2026-10-21';

const FAQ = [
  { q: '¿Cuánto cuesta una página web básica en Ecuador?', a: 'Según los precios publicados por agencias de Quito y Guayaquil en octubre de 2026, una página informativa de entre una y cinco secciones cuesta entre USD 250 y USD 490 de pago único, más IVA en varios casos. BIE la ofrece en USD 150 de creación más USD 25 al mes de acompañamiento, con hosting incluido y sin permanencia mínima.' },
  { q: '¿Cuánto cuesta una tienda en línea en Ecuador?', a: 'Las agencias que publican precios ubican el comercio electrónico entre USD 690 y USD 990 como punto de partida, y una plataforma a medida desde USD 2.000. El costo real depende del número de productos, los medios de pago y la integración con inventario y envíos.' },
  { q: '¿Qué incluye el precio de una página web?', a: 'Depende del proveedor. Lo mínimo serio: diseño adaptado a celular, textos revisados, formulario o botón de WhatsApp, certificado SSL, hosting del primer año y SEO técnico básico. Pregunta siempre si el dominio, el hosting, el correo corporativo y el mantenimiento entran o se cobran aparte.' },
  { q: '¿Cuánto cuesta el dominio y el hosting en Ecuador?', a: 'Un dominio .com cuesta entre USD 12 y USD 20 al año; un .ec o .com.ec, alrededor de USD 55 al año según proveedores locales. El hosting administrado para una web pequeña va de USD 5 a USD 20 al mes. En varios paquetes de agencia el primer año viene incluido y desde el segundo se cobra.' },
  { q: '¿Es mejor hacerla yo con Wix o Canva?', a: 'Si tienes tiempo, criterio de diseño y vas a actualizarla tú, un constructor te cuesta entre USD 10 y USD 30 al mes. La desventaja no es el precio: es que la página queda genérica, suele cargar lento y nadie la revisa comercialmente después. Para un negocio que vive de que lo encuentren, suele salir más caro a largo plazo.' },
  { q: '¿Cuánto tiempo toma hacer una página web?', a: 'Una página informativa bien hecha toma entre una y tres semanas desde que entregas textos, fotos y logo. En BIE la primera versión está en siete días hábiles desde el anticipo y los materiales completos. Una tienda en línea toma entre tres y ocho semanas.' },
  { q: '¿Qué es el mantenimiento y por qué me lo cobran?', a: 'Es el trabajo de mantener la web viva: actualizaciones de seguridad, respaldos, cambios de textos y fotos, y revisar que siga vendiendo. Sin mantenimiento, una web envejece y deja de aparecer en Google. Puede cobrarse por hora, por mes o estar incluido en un acompañamiento.' },
  { q: '¿La página web incluye aparecer en Google?', a: 'No automáticamente. El SEO técnico básico (velocidad, títulos, estructura) suele venir incluido; posicionarse para búsquedas concretas es un trabajo mensual aparte. Lo que sí deberías exigir desde el día uno: que la página sea indexable y que cargue rápido en celular.' },
  { q: '¿Puedo pagar la página web en cuotas?', a: 'Muchas agencias piden un anticipo del 50 % y el resto contra entrega. Los modelos de pago mensual, como el acompañamiento de BIE, reparten el costo en el tiempo y evitan el desembolso grande inicial.' },
  { q: '¿Qué pasa si dejo de pagar el mantenimiento o el acompañamiento?', a: 'Depende del contrato. Exige que el dominio esté a tu nombre y que te entreguen accesos y archivos: así la web sigue siendo tuya aunque cambies de proveedor. En BIE el dominio es tuyo y no hay permanencia mínima.' },
  { q: '¿Necesito página web si ya vendo por Instagram y WhatsApp?', a: 'Si te va bien así, no es urgente. Pero una página propia es lo único que aparece en Google cuando te buscan por nombre o por lo que vendes, y es el lugar donde el cliente confirma que eres un negocio serio antes de escribirte. En Ecuador, el 74 % de quienes compran en línea ya cierran por WhatsApp; la web es la puerta que lleva a ese chat.' },
  { q: '¿Cómo sé si una cotización de página web es seria?', a: 'Tres señales: te preguntaron qué vendes y a quién antes de dar un precio; separan claramente creación, dominio, hosting y mantenimiento; y te dicen qué pasa con tus accesos si dejas de trabajar con ellos.' },
];

const ld = [
