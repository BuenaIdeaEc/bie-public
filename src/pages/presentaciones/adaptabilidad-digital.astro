---
// BIE — Presentación privada "Adaptabilidad Digital". No listada en el menú ni en el sitemap.
// Ruta independiente: no se referencia desde ninguna otra página del sitio.
import '../../styles/site.css';

const SITE = 'https://businessintelligence.solutions';
const WA_NUM = '593988253030';
const wa = (msg: string) => `https://wa.me/${WA_NUM}?text=${encodeURIComponent(msg)}`;
const waNeed = wa('Hola, vi la presentación de Adaptabilidad Digital de BIE y quiero conversar sobre mi caso.\n\n— Origen: web/presentaciones/adaptabilidad-digital/es');

const SCENES = [
  { n: '01', id: 'apertura', label: 'Apertura' },
  { n: '02', id: 'senal', label: 'La señal' },
  { n: '03', id: 'costo', label: 'El costo invisible' },
  { n: '04', id: 'brecha', label: 'La brecha de adopción' },
  { n: '05', id: 'capas', label: 'Las capas de optimización' },
  { n: '06', id: 'caso', label: 'Caso Óscar Caicho' },
  { n: '07', id: 'humano', label: 'El humano no desaparece' },
  { n: '08', id: 'adaptabilidad', label: 'Adaptabilidad digital' },
  { n: '09', id: 'cierre', label: 'Cierre' },
];
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Adaptabilidad Digital — BIE</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style is:global>
html,body{height:100%;overflow:hidden;overscroll-behavior:none;background:var(--black)}
body{position:fixed;inset:0;font-family:var(--font)}

.deck{position:fixed;inset:0;background:var(--black)}
.px{position:fixed;width:8px;height:8px;background:var(--accent)}
.px.tl{top:18px;left:18px}.px.br{bottom:64px;right:18px}

/* ── escenas ── */
.scene{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;
  padding:min(9vh,80px) min(7vw,88px) 100px;opacity:0;pointer-events:none;overflow-y:auto;
  transform:translateY(24px);transition:opacity .5s var(--ease),transform .5s var(--ease)}
.scene::-webkit-scrollbar{width:0;height:0}
.scene.active{opacity:1;pointer-events:auto;transform:none}
.scene.leaving{transform:translateY(-24px)}
@media(prefers-reduced-motion:reduce){.scene{transition:opacity .25s linear;transform:none!important}}

.eyebrow{font-family:var(--mono);font-size:clamp(10px,1.1vw,12px);letter-spacing:.18em;text-transform:uppercase;color:var(--accent);display:flex;align-items:center;gap:10px}
.eyebrow::before{content:'';width:22px;height:1px;background:var(--accent)}
.s-title{font-size:clamp(30px,4.6vw,64px);font-weight:400;letter-spacing:-.02em;line-height:1.06;margin-top:18px;max-width:16ch;text-wrap:balance}
.s-body{font-size:clamp(15px,1.4vw,19px);line-height:1.55;color:var(--text2);max-width:56ch;margin-top:20px}
.s-note{font-family:var(--mono);font-size:12px;letter-spacing:.06em;color:var(--accent);margin-top:18px;max-width:52ch;line-height:1.5}
.s-grid{margin-top:34px;max-width:980px}

/* pipeline (escena 02) */
.pipe{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:32px}
.pipe-step{font-family:var(--mono);font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--text);border:1px solid var(--border);padding:10px 16px}
.pipe-arrow{color:var(--accent);font-size:16px}
.examples{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:30px;max-width:900px}
.ex-btn{text-align:left;background:transparent;border:1px solid var(--border);color:var(--text);padding:16px;font-size:14px;font-weight:500;transition:border-color .25s,color .25s}
.ex-btn:hover,.ex-btn.on{border-color:var(--accent)}
.ex-reveal{grid-column:1/-1;border:1px solid var(--accent);background:var(--accent-pale);padding:16px 18px;color:var(--text2);font-size:14px;line-height:1.5;display:none}
.ex-reveal.on{display:block}

/* lista numerada (escena 03) */
.num-list{display:grid;grid-template-columns:repeat(2,1fr);gap:16px 30px;margin-top:30px;max-width:820px}
.num-item{display:flex;gap:14px;align-items:flex-start;font-size:15px;color:var(--text2);line-height:1.4}
.num-item b{font-family:var(--mono);color:var(--accent);font-size:13px;flex-shrink:0;padding-top:2px}

/* dos velocidades (escena 04) */
.speeds{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:32px;max-width:900px}
.speed-card{border:1px solid var(--border);padding:22px}
.speed-h{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--text3);margin-bottom:10px}
.speed-bar{height:6px;background:var(--surface);position:relative;overflow:hidden;margin-bottom:14px}
.speed-bar i{position:absolute;inset:0;background:var(--accent);transform-origin:left}
.speed-bar.fast i{animation:sp-fast 1.1s var(--ease) infinite alternate}
.speed-bar.slow i{animation:sp-slow 2.6s var(--ease) infinite alternate}
@keyframes sp-fast{from{transform:scaleX(.25)}to{transform:scaleX(1)}}
@keyframes sp-slow{from{transform:scaleX(.55)}to{transform:scaleX(.7)}}
@media(prefers-reduced-motion:reduce){.speed-bar i{animation:none;transform:scaleX(.6)}}
.speed-card p{font-size:14.5px;color:var(--text2);line-height:1.5}

/* capas (escena 05) */
.layers{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:28px;max-width:1040px}
.layer-btn{text-align:left;background:transparent;border:1px solid var(--border);padding:14px;color:var(--text);transition:border-color .2s}
.layer-n{font-family:var(--mono);font-size:10px;color:var(--text3)}
.layer-name{font-size:14px;font-weight:500;margin-top:5px;line-height:1.25}
.layer-btn:hover,.layer-btn.on{border-color:var(--accent)}
.layer-btn.on .layer-name{color:var(--accent)}
.layer-detail{margin-top:16px;max-width:1040px;border:1px solid var(--accent);background:var(--accent-pale);padding:18px 20px;display:none}
.layer-detail.on{display:block}
.layer-detail .ld-row{font-size:14px;color:var(--text2);line-height:1.5;margin-top:8px}
.layer-detail .ld-row:first-child{margin-top:0}
.layer-detail b{color:var(--text);font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;margin-right:8px}

/* caso Oscar (escena 06) */
.case-cols{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-top:28px;max-width:1040px}
.case-col{border:1px solid var(--border);padding:18px}
.case-col h4{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:12px}
.case-col ul{list-style:none;display:flex;flex-direction:column;gap:9px}
.case-col li{font-size:13.5px;color:var(--text2);line-height:1.4;padding-left:14px;position:relative}
.case-col li::before{content:'—';position:absolute;left:0;color:var(--text3)}
.case-cta{margin-top:24px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}

/* humano (escena 07) */
.split{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:30px;max-width:820px}
.split-col h4{font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;margin-bottom:14px}
.split-col.tech h4{color:var(--text3)}
.split-col.human h4{color:var(--accent)}
.split-col ul{list-style:none;display:flex;flex-direction:column;gap:10px}
.split-col li{font-size:15px;color:var(--text2)}

/* adaptabilidad (escena 08) */
.entry-list{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px;max-width:760px}
.entry-chip{font-family:var(--mono);font-size:12px;letter-spacing:.03em;border:1px solid var(--border);padding:9px 14px;color:var(--text2)}

/* cierre (escena 09) */
.closing-quote{font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-size:clamp(18px,2vw,25px);line-height:1.3;color:var(--text);max-width:46ch;margin-top:16px}
.close-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:16px}
.close-contact{font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:var(--text3);margin-top:14px}
[data-scene="9"] .s-body{margin-top:12px;max-width:60ch}
[data-scene="9"].scene{justify-content:flex-start;padding-top:min(5vh,44px);padding-bottom:112px}

.btn-primary,.btn-ghost{font-size:13px}
a.btn-primary,a.btn-ghost{display:inline-flex;align-items:center;gap:8px}

/* ── controles ── */
#bar{position:fixed;left:0;right:0;bottom:0;z-index:50;display:flex;align-items:center;justify-content:space-between;
  padding:16px min(7vw,88px);background:linear-gradient(0deg,rgba(7,7,9,.92),rgba(7,7,9,0));gap:16px}
.bar-l,.bar-r{display:flex;align-items:center;gap:10px}
.ctl{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--text2);
  background:transparent;border:1px solid var(--border);padding:10px 14px;transition:border-color .2s,color .2s;white-space:nowrap}
.ctl:hover{border-color:var(--accent);color:var(--text)}
.ctl:disabled{opacity:.3;pointer-events:none}
.ctl.next{color:var(--bone);border-color:var(--bone)}
.ctl.next:hover{border-color:var(--accent);color:var(--accent)}
#count{font-family:var(--mono);font-size:12px;letter-spacing:.08em;color:var(--text3);font-variant-numeric:tabular-nums}
#progress-rail{position:fixed;top:0;left:0;right:0;height:2px;background:var(--border);z-index:60}
#progress-fill{height:100%;background:var(--accent);width:11.11%;transition:width .4s var(--ease)}
@media(prefers-reduced-motion:reduce){#progress-fill{transition:none}}

/* índice discreto */
#idx-btn{position:fixed;top:16px;right:16px;z-index:60}
#idx-panel{position:fixed;inset:0;background:var(--black);backdrop-filter:blur(14px);z-index:70;
  display:flex;flex-direction:column;justify-content:center;padding:min(9vh,80px) min(7vw,88px);
  opacity:0;pointer-events:none;transition:opacity .3s}
#idx-panel.open{opacity:1;pointer-events:auto}
.idx-row{display:flex;align-items:baseline;gap:18px;padding:12px 0;border-bottom:1px solid var(--border);
  font-size:clamp(17px,2.4vw,26px);font-weight:400;color:var(--text2);cursor:pointer;transition:color .2s}
.idx-row:hover,.idx-row.current{color:var(--text)}
.idx-row.current b{color:var(--accent)}
.idx-row b{font-family:var(--mono);font-size:13px;color:var(--text3);font-weight:400}
#idx-close{position:absolute;top:16px;right:16px}

@media(max-width:760px){
  .scene{padding:9vh 22px 150px;justify-content:flex-start}
  .layers{gap:8px}
  .layer-btn{padding:12px}
  .examples,.num-list,.speeds,.layers,.case-cols,.split{grid-template-columns:1fr}
  #bar{flex-direction:column-reverse;align-items:stretch;padding:10px 14px 12px;gap:8px}
  .bar-l,.bar-r{justify-content:space-between;gap:8px}
  .bar-r{flex-direction:row-reverse}
  .ctl{white-space:normal;text-align:center;line-height:1.3;flex:1}
  .ctl.next{flex:1.4}
  #fs-btn{display:none}
  .close-actions{flex-direction:column;align-items:stretch}
  .close-actions a,.close-actions button{text-align:center;justify-content:center}
}
</style>
</head>
<body>

<div id="progress-rail"><div id="progress-fill"></div></div>
<button id="idx-btn" class="ctl" aria-label="Abrir índice">☰ Índice</button>

<main class="deck">

  <section class="scene" data-scene="1">
    <span class="eyebrow">Adaptabilidad digital · BIE</span>
    <h1 class="s-title">La tecnología avanzó.<br><span class="serif">¿Tu operación también?</span></h1>
    <p class="s-body">Hoy no competimos solamente por conocimiento. También competimos por la capacidad de convertir ese conocimiento en experiencias, sistemas y resultados.</p>
  </section>

  <section class="scene" data-scene="2">
    <span class="eyebrow">02 / 09</span>
    <h2 class="s-title">Lo repetitivo <span class="serif">deja una pista.</span></h2>
    <div class="pipe">
      <span class="pipe-step">Tarea que se repite</span><span class="pipe-arrow">→</span>
      <span class="pipe-step">Tiempo acumulado</span><span class="pipe-arrow">→</span>
      <span class="pipe-step">Error o desgaste</span><span class="pipe-arrow">→</span>
      <span class="pipe-step">Oportunidad de optimización</span>
    </div>
    <p class="s-note">Si ocurre dos o tres veces por semana, merece ser analizada.</p>
    <div class="examples">
      <button class="ex-btn" data-ex="1">Preparar contenido</button>
      <button class="ex-btn" data-ex="2">Responder la misma consulta</button>
      <button class="ex-btn" data-ex="3">Registrar información en varios lugares</button>
      <div class="ex-reveal" data-ex-panel="1">Buscar información, estructurar y diseñar cada vez desde cero. Gran parte de esa base puede dejar de rehacerse — no de pensarse.</div>
      <div class="ex-reveal" data-ex-panel="2">La misma pregunta, respondida de cero cada vez. Puede tener una base lista que el profesional ajusta, en vez de escribirla de nuevo.</div>
      <div class="ex-reveal" data-ex-panel="3">Un mismo dato tecleado dos o tres veces en sistemas distintos. Puede vivir en un solo lugar y aparecer donde se necesita.</div>
    </div>
  </section>

  <section class="scene" data-scene="3">
    <span class="eyebrow">03 / 09</span>
    <h2 class="s-title">El costo <span class="serif">invisible.</span></h2>
    <div class="num-list">
      <div class="num-item"><b>01</b>Tiempo profesional utilizado en tareas operativas.</div>
      <div class="num-item"><b>02</b>Herramientas que no se comunican entre sí.</div>
      <div class="num-item"><b>03</b>Datos que se pierden o no se analizan.</div>
      <div class="num-item"><b>04</b>Oportunidades que dependen de que alguien recuerde actuar.</div>
    </div>
    <p class="s-note">El problema no siempre es trabajar poco. Muchas veces es trabajar mucho dentro de una operación fragmentada.</p>
  </section>

  <section class="scene" data-scene="4">
    <span class="eyebrow">04 / 09</span>
    <h2 class="s-title">La brecha <span class="serif">de adopción.</span></h2>
    <div class="speeds">
      <div class="speed-card">
        <div class="speed-h">La tecnología</div>
        <div class="speed-bar fast"><i></i></div>
        <p>Avanza rápido: nuevas herramientas, modelos y capacidades aparecen todo el tiempo.</p>
      </div>
      <div class="speed-card">
        <div class="speed-h">Las personas</div>
        <div class="speed-bar slow"><i></i></div>
        <p>Deben atender, vender, capacitarse y operar mientras intentan adaptarse, con el mismo tiempo de siempre.</p>
      </div>
    </div>
    <p class="s-body">Que una herramienta exista no significa que una organización pueda implementarla correctamente.</p>
    <p class="s-note">La barrera actual no es únicamente el acceso a tecnología. Es convertirla en una solución útil, comprensible y sostenible.</p>
  </section>

  <section class="scene" data-scene="5">
    <span class="eyebrow">05 / 09</span>
    <h2 class="s-title">Las capas <span class="serif">de optimización.</span></h2>
    <div class="layers" id="layers">
      <button class="layer-btn" data-layer="0"><span class="layer-n">01</span><div class="layer-name">Marca e identidad</div></button>
      <button class="layer-btn" data-layer="1"><span class="layer-n">02</span><div class="layer-name">Página web y presencia digital</div></button>
      <button class="layer-btn" data-layer="2"><span class="layer-n">03</span><div class="layer-name">Contenido y redes sociales</div></button>
      <button class="layer-btn" data-layer="3"><span class="layer-n">04</span><div class="layer-name">Captación y seguimiento comercial</div></button>
      <button class="layer-btn" data-layer="4"><span class="layer-n">05</span><div class="layer-name">Procesos internos y operación</div></button>
      <button class="layer-btn" data-layer="5"><span class="layer-n">06</span><div class="layer-name">Datos y medición</div></button>
      <button class="layer-btn" data-layer="6"><span class="layer-n">07</span><div class="layer-name">Automatización</div></button>
      <button class="layer-btn" data-layer="7"><span class="layer-n">08</span><div class="layer-name">Inteligencia artificial</div></button>
    </div>
    <div class="layer-detail" id="layer-detail"></div>
    <p class="s-note" style="margin-top:22px">Una página web sin proceso puede ser solamente una vitrina. Un sistema sin estrategia puede ser solamente una base de datos. El valor aparece cuando las piezas trabajan juntas.</p>
  </section>

  <section class="scene" data-scene="6">
    <span class="eyebrow">06 / 09 · Caso real</span>
    <h2 class="s-title">Óscar Caicho, <span class="serif">Clínica de Heridas.</span></h2>
    <div class="case-cols">
      <div class="case-col">
        <h4>Antes</h4>
        <ul>
          <li>Profesional de salud, formador y conferencista.</li>
          <li>Preparar una charla científica exige investigar, estructurar, buscar imágenes, diseñar diapositivas y organizar bibliografía.</li>
          <li>Trabajo necesario, pero en buena parte repetitivo — tiempo que podría ir a formación, atención o investigación.</li>
        </ul>
      </div>
      <div class="case-col">
        <h4>Intervención BIE</h4>
        <ul>
          <li>Carga documentos científicos y extrae su contenido.</li>
          <li>Genera estructura de presentación y trabaja la bibliografía.</li>
          <li>Produce imágenes coherentes con la exposición.</li>
          <li>Crea quizzes interactivos, proyectables en computadora y teléfono.</li>
          <li>La revisión y decisión final siguen siendo del experto.</li>
        </ul>
      </div>
      <div class="case-col">
        <h4>Después</h4>
        <ul>
          <li>La máquina prepara la base.</li>
          <li>El profesional revisa, corrige y aporta criterio clínico.</li>
          <li>El resultado se produce con más velocidad y consistencia.</li>
          <li>Óscar conserva el control científico, profesional y comunicacional.</li>
        </ul>
      </div>
    </div>
    <div class="case-cta">
      <a class="btn-primary" href="https://oscar-caicho.netlify.app/" target="_blank" rel="noopener noreferrer"><span>Ver el caso funcionando</span></a>
      <span class="s-note" style="margin:0">Se abre en una pestaña nueva — esta presentación sigue aquí.</span>
    </div>
  </section>

  <section class="scene" data-scene="7">
    <span class="eyebrow">07 / 09</span>
    <h2 class="s-title">La tecnología prepara.<br><span class="serif">El experto decide.</span></h2>
    <div class="split">
      <div class="split-col tech">
        <h4>Tecnología</h4>
        <ul><li>Organiza</li><li>Conecta</li><li>Propone</li><li>Acelera</li><li>Registra</li><li>Aprende de procesos autorizados</li></ul>
      </div>
      <div class="split-col human">
        <h4>Profesional</h4>
        <ul><li>Valida</li><li>Interpreta</li><li>Decide</li><li>Cuida</li><li>Crea criterio</li><li>Asume responsabilidad</li></ul>
      </div>
    </div>
    <p class="s-note" style="margin-top:26px">El objetivo no es sacar al humano de la operación. Es sacar de sus manos aquello que no requiere desperdiciar su conocimiento.</p>
  </section>

  <section class="scene" data-scene="8">
    <span class="eyebrow">08 / 09</span>
    <h2 class="s-title">Nuestra moneda es <span class="serif">la adaptabilidad digital.</span></h2>
    <p class="s-body">BIE estudia cómo funciona una persona, negocio u organización y construye la combinación tecnológica que necesita para avanzar.</p>
    <div class="entry-list">
      <span class="entry-chip">Página web profesional</span>
      <span class="entry-chip">Marca mejor comunicada</span>
      <span class="entry-chip">Contenido con estrategia</span>
      <span class="entry-chip">Seguimiento de clientes</span>
      <span class="entry-chip">Una automatización</span>
      <span class="entry-chip">Sistema operativo empresarial</span>
      <span class="entry-chip">Herramienta personalizada</span>
    </div>
    <p class="s-note">No todos necesitan todo. Cada implementación debe responder a una necesidad y producir un resultado verificable.</p>
  </section>

  <section class="scene" data-scene="9">
    <span class="eyebrow">09 / 09 · Cierre</span>
    <h2 class="s-title">Tu conocimiento merece <span class="serif">una operación a su altura.</span></h2>
    <p class="s-body">No necesitas convertirte en experto en cada nueva herramienta. Necesitas una estructura capaz de adaptarlas a tu trabajo. Trabajamos online con profesionales, empresas y organizaciones de distintos sectores y países. Diseñamos soluciones alrededor de su realidad, no alrededor de una plantilla genérica.</p>
    <p class="closing-quote">"Si existe una parte de su trabajo que les quita tiempo, se repite constantemente o impide que su conocimiento llegue más lejos, ahí puede comenzar una conversación con BIE."</p>
    <div class="close-actions">
      <a class="btn-primary" href={SITE}><span>Conocer BIE</span></a>
      <a class="btn-primary" href={waNeed} target="_blank" rel="noopener noreferrer"><span>Conversar sobre una necesidad</span></a>
      <button class="btn-ghost" id="restart-btn">Reiniciar presentación</button>
    </div>
    <p class="close-contact">BUSINESS INTELLIGENCE ENHANCER · businessintelligence.solutions · WhatsApp +593 98 825 3030</p>
  </section>

</main>

<div id="bar">
  <div class="bar-l">
    <button class="ctl" id="prev-btn">← Anterior</button>
    <span id="count">01 / 09</span>
  </div>
  <div class="bar-r">
    <button class="ctl" id="fs-btn">⤢ Pantalla completa</button>
    <button class="ctl next" id="next-btn">02 · Ver el costo invisible</button>
  </div>
</div>

<div id="idx-panel">
  <button id="idx-close" class="ctl" aria-label="Cerrar índice">✕ Cerrar</button>
  <div id="idx-list"></div>
</div>

<script define:vars={{ scenes: SCENES }}>
const NEXT_LABEL = {
  1:'01 · Identificar la brecha', 2:'02 · Ver el costo invisible', 3:'03 · Entender la brecha',
  4:'04 · Explorar las capas', 5:'05 · Ver un caso real', 6:'06 · Volver al principio humano',
  7:'07 · Conocer lo que realmente vendemos', 8:'08 · Abrir la siguiente posibilidad', 9:null,
};
const TOTAL = scenes.length;
const sceneEls = Array.from(document.querySelectorAll('.scene'));
const prevBtn = document.getElementById('prev-btn');
const nextBtn = document.getElementById('next-btn');
const countEl = document.getElementById('count');
const fillEl = document.getElementById('progress-fill');
const idxBtn = document.getElementById('idx-btn');
const idxPanel = document.getElementById('idx-panel');
const idxClose = document.getElementById('idx-close');
const idxList = document.getElementById('idx-list');
const fsBtn = document.getElementById('fs-btn');

let current = 1;

function readInitial() {
  const h = parseInt((location.hash || '').replace('#', ''), 10);
  if (h >= 1 && h <= TOTAL) return h;
  const stored = parseInt(sessionStorage.getItem('bie-deck-scene') || '', 10);
  if (stored >= 1 && stored <= TOTAL) return stored;
  return 1;
}

function render() {
  sceneEls.forEach(el => {
    const n = parseInt(el.dataset.scene, 10);
    el.classList.toggle('active', n === current);
  });
  countEl.textContent = String(current).padStart(2, '0') + ' / ' + String(TOTAL).padStart(2, '0');
  fillEl.style.width = (current / TOTAL * 100) + '%';
  prevBtn.disabled = current === 1;
  const label = NEXT_LABEL[current];
  if (label) { nextBtn.textContent = label; nextBtn.disabled = false; }
  else { nextBtn.textContent = 'Fin de la presentación'; nextBtn.disabled = true; }
  sessionStorage.setItem('bie-deck-scene', String(current));
  history.replaceState(null, '', '#' + current);
  buildIndex();
}

function goTo(n) {
  if (n < 1 || n > TOTAL) return;
  current = n;
  render();
}

prevBtn.addEventListener('click', () => goTo(current - 1));
nextBtn.addEventListener('click', () => goTo(current + 1));

document.addEventListener('keydown', (e) => {
  if (idxPanel.classList.contains('open')) {
    if (e.key === 'Escape') closeIdx();
    return;
  }
  if (e.key === 'ArrowRight') goTo(current + 1);
  if (e.key === 'ArrowLeft') goTo(current - 1);
});

function buildIndex() {
  idxList.innerHTML = scenes.map(s => {
    const n = parseInt(s.n, 10);
    return `<div class="idx-row${n === current ? ' current' : ''}" data-jump="${n}"><b>${s.n}</b><span>${s.label}</span></div>`;
  }).join('');
  idxList.querySelectorAll('[data-jump]').forEach(row => {
    row.addEventListener('click', () => { goTo(parseInt(row.dataset.jump, 10)); closeIdx(); });
  });
}
function openIdx() { idxPanel.classList.add('open'); idxBtn.style.visibility = 'hidden'; }
function closeIdx() { idxPanel.classList.remove('open'); idxBtn.style.visibility = 'visible'; }
idxBtn.addEventListener('click', openIdx);
idxClose.addEventListener('click', closeIdx);

fsBtn.addEventListener('click', () => {
  if (!document.fullscreenElement) document.documentElement.requestFullscreen?.().catch(() => {});
  else document.exitFullscreen?.().catch(() => {});
});

document.getElementById('restart-btn').addEventListener('click', () => goTo(1));

// escena 02 — ejemplos
document.querySelectorAll('.ex-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const id = btn.dataset.ex;
    const panel = document.querySelector(`.ex-reveal[data-ex-panel="${id}"]`);
    const wasOn = panel.classList.contains('on');
    document.querySelectorAll('.ex-reveal').forEach(p => p.classList.remove('on'));
    document.querySelectorAll('.ex-btn').forEach(b => b.classList.remove('on'));
    if (!wasOn) { panel.classList.add('on'); btn.classList.add('on'); }
  });
});

// escena 05 — capas
const LAYERS = [
  { problema:'Nadie recuerda ni confía en lo que no logra reconocer.', ejemplo:'Un logotipo, colores y tono de voz consistentes en cada punto de contacto.', aislado:'Una identidad bien diseñada sin canal donde mostrarla no genera negocio por sí sola.' },
  { problema:'Si no te encuentran, no existes para tu mercado.', ejemplo:'Un sitio que explica lo que haces y facilita el contacto.', aislado:'Una web sin estrategia detrás puede ser solamente una vitrina.' },
  { problema:'Publicar sin rumbo no construye autoridad.', ejemplo:'Contenido con un objetivo comercial claro, no solo presencia.', aislado:'Contenido sin un proceso de captación detrás no convierte a nadie.' },
  { problema:'Un interesado que nadie vuelve a contactar es una oportunidad perdida.', ejemplo:'Un proceso que asegura que cada contacto reciba seguimiento.', aislado:'Captar sin una operación que sostenga la entrega genera promesas incumplidas.' },
  { problema:'Cada persona resolviendo distinto genera inconsistencia.', ejemplo:'Pasos claros y repetibles para el trabajo que se repite.', aislado:'Procesos ordenados sin datos no muestran si de verdad están funcionando.' },
  { problema:'Sin datos, las decisiones son intuición disfrazada de estrategia.', ejemplo:'Saber qué funciona y qué no, con evidencia y no con impresiones.', aislado:'Medir sin poder actuar sobre lo medido solo acumula reportes.' },
  { problema:'Hay tareas que no requieren criterio humano cada vez que ocurren.', ejemplo:'Un paso repetitivo que deja de necesitar que alguien lo ejecute a mano.', aislado:'Automatizar un proceso mal diseñado solo lo hace fallar más rápido.' },
  { problema:'Hay trabajo de análisis y generación que puede partir de una base ya preparada.', ejemplo:'Una primera versión lista para revisar, no para publicar a ciegas.', aislado:'La IA sin revisión humana pierde exactamente lo que la vuelve confiable.' },
];
const layerDetail = document.getElementById('layer-detail');
document.querySelectorAll('.layer-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const i = parseInt(btn.dataset.layer, 10);
    const wasOn = btn.classList.contains('on');
    document.querySelectorAll('.layer-btn').forEach(b => b.classList.remove('on'));
    if (wasOn) { layerDetail.classList.remove('on'); return; }
    btn.classList.add('on');
    const d = LAYERS[i];
    layerDetail.innerHTML = `<div class="ld-row"><b>Qué resuelve —</b> ${d.problema}</div><div class="ld-row"><b>Ejemplo —</b> ${d.ejemplo}</div><div class="ld-row"><b>Aislado, no alcanza —</b> ${d.aislado}</div>`;
    layerDetail.classList.add('on');
  });
});

current = readInitial();
render();
</script>
</body>
</html>
