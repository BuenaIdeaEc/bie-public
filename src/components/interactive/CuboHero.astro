---
// Capítulo 1 de la home 10.0: "El cubo se arma". 27 píxeles cuadrados con las cosas sueltas
// de un negocio encajan en el cubo de BIE con física determinista dirigida por el scroll;
// al completarse las juntas se cierran, un destello de vidrio esmerilado cubre la pantalla y queda
// el cubo blanco liso con la cara roja. Construido en código (Three.js), no con video generado.
import { UI } from '../../data/home-ui';
interface Props { waHref: string }
const { waHref } = Astro.props;
const es = (k: string) => UI[k].es;
// Videos de Higgsfield (personas generadas con IA): se rotulan como escena ilustrativa, no son clientes.
const SCENES = [['asistente-inteligente-whatsapp', 'hero_f_s1'], ['identidad-de-marca', 'hero_f_s2'], ['whatsapp-business-commerce', 'hero_f_s3']];
---
<section id="hero" class="cubo" aria-label="BIE: de las piezas sueltas de tu negocio a un solo sistema">
  <div class="cubo-sticky">
    <canvas id="cubo-canvas" aria-hidden="true" style="opacity:0"></canvas>
    <div id="cubo-flash" aria-hidden="true"></div>
    <div id="cubo-out" aria-hidden="true"></div>
    <div id="cubo-labels" aria-hidden="true"></div>
    <div class="cubo-line cubo-first on" data-i="0">
      <div class="cf-copy">
        <h1 class="cubo-h cf-h" data-i18n="hero_f_h" set:html={es('hero_f_h')}></h1>
        <p class="cf-sub" data-i18n="hero_f_sub" set:html={es('hero_f_sub')}></p>
        <div class="cf-btns">
          <a href={waHref} id="hero-wa" target="_blank" rel="noopener" class="btn-primary cf-cta"><span data-i18n="hero_f_cta" set:html={es('hero_f_cta')}></span></a>
          <a href="#top" class="btn-ghost cf-price" data-i18n="hero_f_price" set:html={es('hero_f_price')}></a>
        </div>
        <p class="cf-micro" data-i18n="hero_f_micro" set:html={es('hero_f_micro')}></p>
        <a class="cf-proof" href="#voces"><span class="cf-stars" aria-hidden="true">★★★★★</span> <span data-i18n="hero_f_proof" set:html={es('hero_f_proof')}></span></a>
      </div>
      <div class="cf-window">
        {SCENES.map(([slug, key], i) => (
          <figure class={'cf-scene' + (i === 0 ? ' on' : '')}>
            <video data-src={'/videos/productos/' + slug + '.mp4'} poster={i === 0 ? '/images/productos/' + slug + '.webp' : undefined} data-poster={'/images/productos/' + slug + '.webp'} muted loop playsinline preload="none" aria-hidden="true" width="900" height="900"></video>
            <figcaption><span data-i18n={key} set:html={es(key)}></span><small data-i18n="hero_f_ill" set:html={es('hero_f_ill')}></small></figcaption>
          </figure>
        ))}
      </div>
    </div>
    <div class="cubo-copy">
      <div class="cubo-line" data-i="1">
        <span class="cubo-k" data-i18n="hero_kicker" set:html={es('hero_kicker')}></span>
        <p class="cubo-h" data-i18n="hero_c1_h" set:html={es('hero_c1_h')}></p>
      </div>
      <div class="cubo-line" data-i="2">
        <span class="cubo-k" data-i18n="hero_c2_k" set:html={es('hero_c2_k')}></span>
        <h2 class="cubo-h" data-i18n="hero_c2_h" set:html={es('hero_c2_h')}></h2>
      </div>
      <div class="cubo-line" data-i="3">
        <span class="cubo-k" data-i18n="hero_c3_k" set:html={es('hero_c3_k')}></span>
        <h2 class="cubo-h" data-i18n="hero_c3_h" set:html={es('hero_c3_h')}></h2>
        <p class="cubo-sub" data-i18n="hero_sub" set:html={es('hero_sub')}></p>
        <div class="cubo-btns">
          <a href={waHref} id="hero-wa2" target="_blank" rel="noopener" class="btn-primary"><span data-i18n="btn_diag_hero" set:html={es('btn_diag_hero')}></span></a>
          <a href="#top" class="btn-ghost" data-i18n="btn_work" set:html={es('btn_work')}></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
#hero.cubo{min-height:0;height:290vh;display:block;padding:0;perspective:none;overflow:visible;background:var(--black)}
#hero.cubo::after{display:none}
.cubo-sticky{position:sticky;top:0;height:100vh;height:100dvh;overflow:hidden;background:transparent}
#cubo-canvas{position:absolute;inset:0;width:100%;height:100%;display:block;transition:opacity .9s ease}
#cubo-flash{position:fixed;inset:0;background:rgba(255,255,255,.55);-webkit-backdrop-filter:blur(26px) saturate(1.4);backdrop-filter:blur(26px) saturate(1.4);opacity:0;pointer-events:none;z-index:1000}
#cubo-out{display:none}
#cubo-labels{position:absolute;inset:0;pointer-events:none;z-index:2}
.cubo-lbl{position:absolute;transform:translate(-50%,-50%);font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(16,16,18,.62);white-space:nowrap;will-change:transform,opacity}
.cubo-lbl::before{content:'';display:inline-block;width:5px;height:5px;background:var(--accent);margin-right:8px;vertical-align:middle}
.cubo-copy{position:absolute;left:0;right:0;bottom:11vh;z-index:3;pointer-events:none}
.cubo-line{position:absolute;left:clamp(22px,6vw,80px);right:clamp(22px,6vw,80px);bottom:0;opacity:0;transform:translateY(10px);transition:opacity .35s ease,transform .35s ease;will-change:opacity}
.cubo-line.on{opacity:1;transform:none}
.cubo-k{font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-size:clamp(18px,2.2vw,24px);color:var(--text3);display:block;margin-bottom:8px}
.cubo-h{font-size:clamp(30px,5vw,60px);font-weight:400;letter-spacing:-.02em;line-height:1.02;max-width:16ch;margin:0;text-wrap:balance;color:var(--text)}
.cubo-h em{font-family:'Instrument Serif',Georgia,serif;font-style:italic;font-weight:400;padding-right:.06em;background:var(--foil-text);-webkit-background-clip:text;background-clip:text;color:transparent}
.cubo-sub{font-size:16px;color:var(--text2);max-width:52ch;line-height:1.6;margin:16px 0 0}
.cubo-btns{display:flex;gap:14px;flex-wrap:wrap;margin-top:22px;pointer-events:auto}
@media (max-width:640px){ .cubo-btns{flex-direction:column;gap:10px} .cubo-btns .btn-primary,.cubo-btns .btn-ghost{text-align:center} }
.cubo-line:not(.on),.cubo-line:not(.on) *{pointer-events:none!important}
/* Primer pantallazo: promesa, botón y prueba antes de cualquier animación */
.cubo-line.cubo-first{left:0;right:0;top:66px;bottom:0;z-index:3;display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);gap:clamp(28px,4vw,64px);align-items:center;padding:clamp(16px,3vh,36px) clamp(22px,6vw,80px) clamp(20px,4vh,44px);pointer-events:none}
.cf-copy{pointer-events:auto;display:flex;flex-direction:column;align-items:flex-start;gap:clamp(12px,2vh,20px);min-width:0}
#hero.cubo h1.cf-h{font-size:clamp(38px,5.1vw,78px);max-width:13ch;line-height:1;letter-spacing:-.03em;margin:0;opacity:1;transform:none;transition:none}
.cf-sub{margin:0;font-size:clamp(16px,1.35vw,20px);line-height:1.45;color:var(--text2);max-width:44ch;text-wrap:pretty}
.cf-btns{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;margin-top:4px}
.cf-cta{padding:19px 30px!important}
.cf-price{padding:16px 14px!important}
.cf-micro{margin:0;font-size:13px;color:var(--text2)}
.cf-proof{display:inline-flex;flex-wrap:wrap;gap:4px 8px;align-items:baseline;font-size:13px;color:var(--text2);border-top:1px solid var(--border);padding-top:clamp(10px,1.6vh,16px)}
.cf-proof:hover{color:var(--text)}
.cf-stars{color:var(--accent-dark);letter-spacing:.08em}
.cf-window{position:relative;pointer-events:auto;justify-self:end;width:100%;max-width:min(100%,calc(100dvh - 150px));aspect-ratio:1;overflow:hidden;background:var(--band);box-shadow:0 34px 70px -40px rgba(26,15,36,.55)}
.cf-window::after{content:'';position:absolute;inset:0;padding:1.5px;background:var(--foil);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0);pointer-events:none}
.cf-scene{position:absolute;inset:0;margin:0;opacity:0;transition:opacity .9s ease}
.cf-scene.on{opacity:1}
.cf-scene video{width:100%;height:100%;object-fit:cover;display:block}
.cf-scene figcaption{position:absolute;left:12px;right:12px;bottom:12px;display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:12px 14px;font-size:15px;line-height:1.25;letter-spacing:-.01em;color:var(--text);background:rgba(255,255,255,.8);-webkit-backdrop-filter:blur(14px) saturate(1.5);backdrop-filter:blur(14px) saturate(1.5)}
.cf-scene small{flex-shrink:0;font-size:11px;color:var(--text2)}
@media (max-width:860px){
  .cubo-line.cubo-first{top:58px;grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr);align-items:stretch;gap:14px;padding:14px 20px 16px}
  #hero.cubo h1.cf-h{font-size:clamp(33px,9.6vw,46px);max-width:none}
  .cf-sub{font-size:15.5px}
  .cf-btns{width:100%}
  .cf-cta{flex:1 1 100%;text-align:center}
  .cf-price{flex:1 1 100%;text-align:center;padding:8px!important}
  .cf-micro{font-size:11.5px;align-self:center;text-align:center;white-space:nowrap}
  .cf-proof{display:none}
  .cf-window{aspect-ratio:auto;max-width:none;min-height:0;justify-self:stretch}
  .cf-scene video{object-position:50% 25%}
  .cf-scene figcaption{left:8px;right:8px;bottom:8px;padding:9px 11px;font-size:13px}
}
@media (max-height:700px) and (max-width:860px){ .cf-sub{display:none} }
/* el cierre en celular: la barra fija ya trae el botón, así el texto no pisa el cubo */
@media (max-width:860px){ .cubo-line[data-i="3"] .cubo-sub,.cubo-line[data-i="3"] .cubo-btns{display:none} .cubo-copy{bottom:13vh} }
@media (prefers-reduced-motion: reduce){ .cubo-line{transition:none} }
</style>

<script>
// el 3D llega en cuanto el visitante baja; si no baja, cuando el navegador queda libre
let booted = false;
const boot = () => { if (booted) return; booted = true; import('../../lib/cubo3d').then((m) => m.init()); };
addEventListener('scroll', boot, { passive: true, once: true });
setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(boot) : boot()), 6000);

// primer pantallazo: tres escenas que se turnan. Primero la foto; los videos llegan cuando la página ya cargó
const scenes = Array.from(document.querySelectorAll<HTMLElement>('.cf-scene'));
const first = document.querySelector<HTMLElement>('.cubo-first');
const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
const prepare = (i: number) => {
  const v = scenes[i]?.querySelector('video');
  if (!v || !v.dataset.src) return;
  v.poster = v.dataset.poster || ''; v.src = v.dataset.src; delete v.dataset.src; v.preload = 'auto'; v.load();
};
const whenLoaded = (fn: () => void) => { if (document.readyState === 'complete') setTimeout(fn, 400); else addEventListener('load', () => setTimeout(fn, 400), { once: true }); };
let cur = 0;
if (!still && scenes.length) whenLoaded(() => {
  prepare(0); scenes[0].querySelector('video')?.play().catch(() => {});
  setTimeout(() => prepare(1), 2500);
  setInterval(() => {
    if (document.hidden || !first?.classList.contains('on')) return;
    const next = (cur + 1) % scenes.length, v = scenes[next].querySelector('video');
    if (!v || v.readyState < 2) { prepare(next); return; } // aún no llega: se queda en la escena actual
    v.currentTime = 0; v.play().catch(() => {});
    scenes[cur].classList.remove('on'); scenes[next].classList.add('on'); cur = next;
    prepare((next + 1) % scenes.length);
  }, 5200);
});
</script>
