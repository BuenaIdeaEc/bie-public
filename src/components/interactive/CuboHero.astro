---
// Capítulo 1 de la home 10.0: "El cubo se arma". 27 píxeles cuadrados con las cosas sueltas
// de un negocio encajan en el cubo de BIE con física determinista dirigida por el scroll;
// al completarse las juntas se cierran, un destello de vidrio esmerilado cubre la pantalla y queda
// el cubo blanco liso con la cara roja. Construido en código (Three.js), no con video generado.
import { UI } from '../../data/home-ui';
interface Props { waHref: string }
const { waHref } = Astro.props;
const es = (k: string) => UI[k].es;
---
<section id="hero" class="cubo" aria-label="BIE: de las piezas sueltas de tu negocio a un solo sistema">
  <div class="cubo-sticky">
    <div id="cubo-poster" aria-hidden="true"></div>
    <div id="cubo-reveal" aria-hidden="true"></div>
    <canvas id="cubo-canvas" aria-hidden="true" style="opacity:0"></canvas>
    <div id="cubo-flash" aria-hidden="true"></div>
    <div id="cubo-out" aria-hidden="true"></div>
    <div id="cubo-labels" aria-hidden="true"></div>
    <div class="cubo-copy">
      <div class="cubo-line on" data-i="0">
        <span class="cubo-k" data-i18n="hero_kicker" set:html={es('hero_kicker')}></span>
        <p class="cubo-h" data-i18n="hero_c1_h" set:html={es('hero_c1_h')}></p>
      </div>
      <div class="cubo-line" data-i="1">
        <span class="cubo-k" data-i18n="hero_c2_k" set:html={es('hero_c2_k')}></span>
        <h2 class="cubo-h" data-i18n="hero_c2_h" set:html={es('hero_c2_h')}></h2>
      </div>
      <div class="cubo-line" data-i="2">
        <h1 class="cubo-h" data-i18n="hero_c3_h" set:html={es('hero_c3_h')}></h1>
        <p class="cubo-sub" data-i18n="hero_sub" set:html={es('hero_sub')}></p>
        <div class="cubo-btns">
          <a href={waHref} id="hero-wa" target="_blank" rel="noopener" class="btn-primary"><span data-i18n="btn_diag_hero" set:html={es('btn_diag_hero')}></span></a>
          <a href="#top" class="btn-ghost" data-i18n="btn_work" set:html={es('btn_work')}></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
#hero.cubo{min-height:0;height:390vh;display:block;padding:0;perspective:none;overflow:visible;background:var(--black)}
#hero.cubo::after{display:none}
.cubo-sticky{position:sticky;top:0;height:100vh;height:100dvh;overflow:hidden;background:#fff}
/* velo blanco: ninguna pieza pasa por detrás del texto */
.cubo-sticky::after{content:'';position:absolute;left:0;bottom:0;width:62%;height:58%;z-index:2;pointer-events:none;background:radial-gradient(90% 90% at 0% 100%,#fff 55%,rgba(255,255,255,0) 100%);opacity:calc(1 - var(--fin,0) * 3)}
@media (orientation:portrait){.cubo-sticky::after{width:100%;height:36%;background:linear-gradient(180deg,rgba(255,255,255,0) 0,#fff 34%)}}
#cubo-reveal{position:absolute;inset:0;--in:0;--out:0;visibility:hidden;pointer-events:none;background:#fff;color:var(--text)}
#cubo-reveal .sv-in{height:100%;transform:none;opacity:1}
#cubo-poster{position:absolute;inset:0;background:url('/images/marca/cubo-inicio.webp') center/cover no-repeat;transition:opacity .5s ease}
#cubo-poster.off{opacity:0}
@media (orientation:portrait){#cubo-poster{background-image:url('/images/marca/cubo-inicio-v.webp')}}
#cubo-canvas{position:absolute;inset:0;width:100%;height:100%;display:block;transition:opacity .5s ease}
#cubo-flash{position:fixed;inset:0;background:rgba(255,255,255,.55);-webkit-backdrop-filter:blur(26px) saturate(1.4);backdrop-filter:blur(26px) saturate(1.4);opacity:0;pointer-events:none;z-index:1000}
#cubo-out{display:none}
#cubo-labels{position:absolute;inset:0;pointer-events:none;z-index:2}
.cubo-lbl{position:absolute;transform:translate(-50%,-50%);font-size:13px;color:rgba(8,8,8,.42);white-space:nowrap;will-change:transform,opacity}
.cubo-copy{position:absolute;left:0;right:0;bottom:11vh;z-index:3;pointer-events:none}
.cubo-line{position:absolute;left:clamp(22px,6vw,80px);right:clamp(22px,6vw,80px);bottom:0;opacity:0;transform:translateY(10px);transition:opacity .35s ease,transform .35s ease;will-change:opacity}
.cubo-line.on{opacity:1;transform:none}
.cubo-k{font-size:clamp(15px,1.5vw,18px);color:var(--text3);display:block;margin-bottom:10px}
.cubo-h{font-size:clamp(35px,4.1vw,62px);font-weight:400;letter-spacing:-.04em;line-height:1;max-width:15ch;margin:0;text-wrap:balance;color:var(--text)}
.cubo-h em{font-style:normal;font-weight:inherit;color:var(--accent)}
.cubo-sub{font-size:clamp(16px,1.3vw,19px);color:var(--text2);max-width:40ch;line-height:1.4;margin:14px 0 0}
.cubo-btns{display:flex;gap:14px;flex-wrap:wrap;margin-top:22px;pointer-events:auto}
.cubo-line:not(.on),.cubo-line:not(.on) *{pointer-events:none!important}
#hero.cubo h1.cubo-h{opacity:1;transform:none;transition:none;margin:0;max-width:17ch;font-size:clamp(33px,3.9vw,58px);line-height:1.02;font-weight:400;letter-spacing:-.04em}
@media (min-width:861px){ .cubo-line[data-i="2"] .cubo-sub{max-width:40ch} }
@media (max-width:640px){ .cubo-copy{bottom:calc(32px + env(safe-area-inset-bottom))} .cubo-sub{font-size:15px;margin-top:10px} .cubo-btns{align-items:center;gap:6px;margin-top:16px} html body .cubo-btns .btn-primary{width:auto;flex:1 1 auto;padding:15px 16px;text-align:center} html body .cubo-btns .btn-ghost{width:auto;padding:15px 8px} }
@media (prefers-reduced-motion: reduce){ .cubo-line{transition:none} }
</style>

<script>
// dentro del cubo va una copia del primer panel: es lo que se ve al abrirse
const reveal = document.getElementById('cubo-reveal'), panel = document.querySelector('.sv-p .sv-in');
if (reveal && panel && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const copy = panel.cloneNode(true) as HTMLElement;
  copy.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
  const imgs = Array.from(copy.querySelectorAll('img'));
  imgs.forEach((i) => { i.dataset.src = i.getAttribute('src') || ''; i.removeAttribute('src'); i.loading = 'eager'; });
  addEventListener('scroll', () => imgs.forEach((i) => { if (i.dataset.src) i.src = i.dataset.src; }), { passive: true, once: true });
  reveal.appendChild(copy);
}
import('../../lib/cubo3d').then((m) => m.init()).catch(() => { document.body.classList.remove('cubo-intro'); document.body.classList.add('past-cube'); });
</script>
