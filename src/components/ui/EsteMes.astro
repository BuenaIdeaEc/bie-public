---
import type { EsteMes } from '../../data/este-mes';
import { formatFechaCorta, hostVisible } from '../../data/este-mes';
interface Props { data: EsteMes }
const { data } = Astro.props;
const hasta = formatFechaCorta(data.promo.vigenteHasta);
---
<section id="este-mes" class="em" aria-labelledby="em-title">
  <div class="em-inner">
    <div class="em-card">
      <div class="em-offer">
        <p class="em-label">
          <span class="em-label-promo">{data.etiquetaPromo}</span>
          <span class="em-label-base">{data.etiqueta}</span>
          <span class="em-code">{data.codigo}</span>
        </p>
        <h2 id="em-title" class="em-title">{data.titulo}</h2>
        <p class="em-text">{data.texto}</p>

        <div class="em-buy">
          <div class="em-prices em-prices-regular">
            {data.precios.map((p, i) => (
              <>
                {i > 0 && <span class="em-plus" aria-hidden="true">+</span>}
                <div class="em-price">
                  <b><s>{p.valor}</s></b>
                  <span>{p.nota}</span>
                  <em class="em-reg">{data.promo.etiquetaRegular}</em>
                </div>
              </>
            ))}
          </div>
          <div class="em-prices em-prices-promo">
            {data.promo.precios.map((p, i) => (
              <>
                {i > 0 && <span class="em-plus" aria-hidden="true">+</span>}
                <div class="em-price">
                  <b>{p.valor}</b>
                  <span>{p.nota}</span>
                </div>
              </>
            ))}
          </div>
          <p class="em-until">{data.promo.etiquetaHasta} {hasta}</p>
          <div class="em-prices em-prices-alone">
            {data.precios.map((p, i) => (
              <>
                {i > 0 && <span class="em-plus" aria-hidden="true">+</span>}
                <div class="em-price">
                  <b>{p.valor}</b>
                  <span>{p.nota}</span>
                </div>
              </>
            ))}
          </div>
        </div>

        <p class="em-growth">{data.lineaCrecimiento}</p>
        <p class="em-alcance">{data.alcance}</p>
        <a class="em-btn" href={data.href}>{data.cta} <span aria-hidden="true">→</span></a>
      </div>

      <div class="em-examples">
        <p class="em-examples-k">{data.etiquetaEjemplos}</p>
        <ul class="em-ex-list">
          {data.ejemplos.map((ej) => (
            <li>
              <a class:list={['em-ex', !ej.imagen && 'em-ex-card']} href={ej.url} target="_blank" rel="noopener">
                {ej.imagen ? (
                  <img src={ej.imagen} alt={ej.alt ?? ('Página web de ' + ej.nombre + ', trabajo de BIE')} width="800" height="500" loading="lazy" decoding="async">
                ) : (
                  <span class="em-ex-blank">
                    <span class="em-ex-name">{ej.nombre}</span>
                  </span>
                )}
                <span class="em-ex-meta">
                  <span class="em-ex-name">{ej.nombre}</span>
                  <span class="em-ex-url">{hostVisible(ej.url)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .em{padding:72px 0 28px;border-top:1px solid var(--border)}
  .em-inner{max-width:1150px;margin:0 auto;padding:0 44px}
  .em-card{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:48px 56px;align-items:start;border:1px solid var(--border);background:var(--surface);padding:40px 40px 36px}
  .em-label{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent-dark);margin:0}
  .em-code{color:var(--text3);margin-left:10px}
  .em-label-base{display:none}
  .em-title{font-size:clamp(28px,3.2vw,42px);font-weight:400;letter-spacing:-.03em;line-height:1.08;margin:14px 0 0;text-wrap:balance;color:var(--text)}
  .em-text{font-size:17px;line-height:1.5;color:var(--text2);margin:14px 0 0;max-width:42ch}
  .em-buy{display:flex;flex-direction:column;gap:14px;margin-top:28px;padding-top:22px;border-top:1px solid var(--border)}
  .em-prices{display:flex;flex-wrap:wrap;align-items:flex-start;gap:12px 20px}
  .em-price b{display:block;font-size:clamp(26px,3vw,36px);font-weight:400;letter-spacing:-.02em;color:var(--text)}
  .em-price s{color:#6a6a68;text-decoration:line-through;text-decoration-thickness:1px}
  .em-price span{display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--text3);margin-top:5px;max-width:24ch}
  .em-reg{display:block;font-family:var(--mono);font-size:10px;font-style:normal;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);margin-top:4px}
  .em-plus{font-size:22px;color:var(--text3);align-self:center}
  .em-until{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--accent-dark);margin:2px 0 0}
  .em-prices-alone{display:none}
  .em-growth{font-size:16px;line-height:1.55;color:var(--text);margin:22px 0 0;max-width:46ch}
  .em-alcance{font-size:14px;line-height:1.5;color:var(--text3);margin:10px 0 0;max-width:46ch}
  .em-btn{align-self:flex-start;display:inline-block;margin-top:22px;border:1px solid var(--bone);color:var(--bone);font-family:var(--mono);font-size:12px;letter-spacing:.14em;text-transform:uppercase;padding:16px 28px;transition:background .4s,border-color .4s,color .4s}
  .em-btn:hover{background:var(--accent);border-color:var(--accent);color:#fff}
  .em-btn:focus-visible{outline:2px solid var(--bone);outline-offset:3px}
  .em-examples{min-width:0}
  .em-examples-k{font-family:var(--mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--text3);margin:0 0 14px}
  .em-ex-list{list-style:none;margin:0;padding:0;display:grid;gap:14px}
  .em-ex{display:grid;grid-template-columns:1fr;gap:8px;color:inherit;min-width:0}
  .em-ex img,.em-ex-blank{display:block;width:100%;aspect-ratio:16/10;object-fit:cover;object-position:top;border:1px solid var(--border);background:var(--band)}
  .em-ex-blank{display:flex;align-items:center;justify-content:center;padding:20px;text-align:center}
  .em-ex-blank .em-ex-name{font-size:clamp(18px,2vw,22px);letter-spacing:-.02em;color:var(--text);text-wrap:balance}
  .em-ex-meta{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 12px;padding:0 1px}
  .em-ex-meta .em-ex-name{font-size:14px;color:var(--text)}
  .em-ex-url{font-family:var(--mono);font-size:11px;letter-spacing:.04em;color:var(--text3)}
  .em-ex:hover img,.em-ex:hover .em-ex-blank{border-color:var(--text)}
  .em-ex:hover .em-ex-url{color:var(--accent-dark)}
  .em-ex:focus-visible{outline:2px solid var(--bone);outline-offset:3px}
  :global(html:not(.promo-web-on)) .em-label-promo,
  :global(html:not(.promo-web-on)) .em-prices-regular,
  :global(html:not(.promo-web-on)) .em-prices-promo,
  :global(html:not(.promo-web-on)) .em-until{display:none}
  :global(html:not(.promo-web-on)) .em-label-base{display:inline}
  :global(html:not(.promo-web-on)) .em-prices-alone{display:flex}
  @media(max-width:860px){
    .em{padding:48px 0 16px}
    .em-inner{padding:0 22px}
    .em-card{grid-template-columns:1fr;gap:28px;padding:24px 20px 22px}
    .em-examples{order:-1}
    .em-title{font-size:clamp(26px,8vw,34px)}
    .em-text{font-size:16px}
    .em-buy{margin-top:22px;padding-top:18px}
    .em-btn{width:100%;text-align:center}
  }
</style>